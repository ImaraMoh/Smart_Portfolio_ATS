# Server
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# MongoDB
MONGO_URI=mongodb+srv://<user>:<password>@cluster0.mongodb.net/smart_portfolio_ats

# JWT
JWT_SECRET=change_this_to_a_long_random_string
JWT_EXPIRES_IN=7d
JWT_REFRESH_SECRET=change_this_too_another_long_random_string
JWT_REFRESH_EXPIRES_IN=30d

# Password reset email (SMTP; Gmail users can use smtp.gmail.com:587 + an app password)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
FROM_EMAIL=

# ML Microservice
ML_SERVICE_URL=http://localhost:8001

# Portfolio
PORTFOLIO_BASE_URL=http://localhost:5000/p
