  #experience .item::after { content:''; position:absolute; z-index:0; top:-55%; left:-45%; width:34%; height:210%; pointer-events:none; background:linear-gradient(90deg,transparent,color-mix(in srgb,var(--surface) 68%,transparent),transparent); opacity:0; transform:rotate(22deg); }
  #experience .item:hover::after { animation:experience-sheen 850ms ease-out; }
  #projects .item { position:relative; overflow:hidden; border-color:color-mix(in srgb,var(--surface) 16%,var(--primary)); background:linear-gradient(145deg,color-mix(in srgb,var(--primary) 92%,var(--accent)),var(--primary) 72%); box-shadow:0 20px 48px color-mix(in srgb,var(--primary) 24%,transparent); }
  #projects .item::after { content:''; position:absolute; z-index:0; top:-55%; left:-55%; width:30%; height:210%; pointer-events:none; background:linear-gradient(90deg,transparent,color-mix(in srgb,var(--surface) 32%,transparent),transparent); opacity:0; transform:rotate(22deg); }
  #projects .item:hover { transform:translateY(-7px); border-color:color-mix(in srgb,var(--accent) 62%,var(--primary)); background:linear-gradient(145deg,color-mix(in srgb,var(--primary) 84%,var(--accent)),var(--primary) 76%); box-shadow:0 28px 64px color-mix(in srgb,var(--primary) 34%,transparent),0 0 24px color-mix(in srgb,var(--accent) 16%,transparent); }
  #projects .item:hover::after { animation:project-sheen 900ms ease-out; }
  #projects .item-title { color:var(--surface); }
  #projects .item-sub,#projects .item-date { color:color-mix(in srgb,var(--surface) 82%,var(--primary)); }
  #projects .item-desc { color:color-mix(in srgb,var(--surface) 82%,var(--primary)); }
  #projects .tag { border-color:rgba(255,255,255,.16); background:rgba(255,255,255,.08); color:color-mix(in srgb,var(--surface) 82%,var(--primary)); }
  #projects .tag:hover { border-color:var(--accent); background:color-mix(in srgb,var(--accent) 18%,var(--primary)); color:var(--surface); }
