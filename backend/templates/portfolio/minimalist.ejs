<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width, initial-scale=1.0" />

<title><%= user.name %> — Portfolio</title>

<meta
  name="description"
  content="<%= user.headline || user.name %>"
/>

<link rel="preconnect" href="https://fonts.googleapis.com">

<link
  href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:wght@400;500;600&family=DM+Sans:wght@400;500;600;700&display=swap"
  rel="stylesheet"
>

<style>

/* =========================================================
   DYNAMIC COLOR THEME
   =========================================================

   These values come directly from portfolioGenerator.js:

   theme.primary
   theme.accent
   theme.background
   theme.surface
   theme.text
   theme.muted
   theme.border
   theme.softAccent

   ========================================================= */

:root {
  --paper: <%= theme.background %>;
  --ink: <%= theme.text %>;
  --line: <%= theme.border || '#E2E8F0' %>;

  --accent: <%= theme.accent %>;

  --muted: <%= theme.muted || '#64748B' %>;
  --soft-accent: <%= theme.softAccent || 'color-mix(in srgb, var(--accent) 12%, var(--surface))' %>;

  --primary: <%= theme.primary %>;
  --surface: <%= theme.surface || '#FFFFFF' %>;
}

* {
  box-sizing: border-box;
}

html {
  scroll-behavior: smooth;
}

body {
  margin: 0;
  background: var(--background);
  color: var(--text);
  font-family: 'Inter', sans-serif;
  line-height: 1.6;
  -webkit-font-smoothing: antialiased;
}

a {
  text-decoration: none;
  color: inherit;
}

::selection {
  background: var(--accent);
  color: #ffffff;
}

/* =========================================================
   MAIN CONTAINER
   ========================================================= */

.wrap {
  max-width: 760px;
  margin: 0 auto;
  padding: 88px 28px 120px;
}

/* =========================================================
   HEADER
   ========================================================= */

.index {
  font-family: 'Inter', sans-serif;
  font-size: 12px;
  letter-spacing: .18em;
  color: var(--accent);
  text-transform: uppercase;
  margin-bottom: 22px;
  font-weight: 600;
}

h1.name {
  font-family: 'Fraunces', serif;
  font-weight: 500;
  font-size: clamp(38px, 6vw, 58px);
  line-height: 1.05;
  margin: 0 0 10px;
  color: var(--text);
}

.headline {
  font-size: 19px;
  color: var(--muted);
  margin: 0 0 34px;
  max-width: 46ch;
}

.bio {
  font-size: 16.5px;
  color: var(--text);
  opacity: .82;
  max-width: 60ch;
  margin-bottom: 56px;
}

/* =========================================================
   CONTACT
   ========================================================= */

.contact {
  display: flex;
  flex-wrap: wrap;
  gap: 18px;
  font-size: 14px;
  margin-bottom: 70px;
}

.contact a {
  color: var(--accent);
  border-bottom: 1px solid transparent;
  transition: all .2s ease;
}

.contact a:hover {
  border-bottom-color: var(--accent);
}

.contact span {
  color: var(--muted);
}

/* =========================================================
   SECTIONS
   ========================================================= */

section {
  margin-bottom: 64px;
}

.stitle {
  font-family: 'Inter', sans-serif;
  font-size: 12px;
  letter-spacing: .16em;
  text-transform: uppercase;
  color: var(--accent);
  font-weight: 600;

  margin-bottom: 26px;
  padding-bottom: 10px;

  border-bottom: 1px solid var(--border);
}

/* =========================================================
   ITEMS
   ========================================================= */

.item {
  margin-bottom: 30px;

  padding: 18px 0 18px 16px;

  border-left: 2px solid transparent;

  transition:
    border-color .2s ease,
    background .2s ease,
    transform .2s ease;
}

.item:hover {
  border-left-color: var(--accent);
  background: var(--accent-transparent);
}

.item:last-child {
  margin-bottom: 0;
}

.item-head {
  display: flex;
  justify-content: space-between;
  gap: 16px;
  flex-wrap: wrap;
  align-items: baseline;
}

.item-title {
  font-family: 'Fraunces', serif;
  font-size: 19px;
  font-weight: 500;
  color: var(--text);
}

.item-sub {
  color: var(--muted);
  font-size: 14.5px;
}

.item-date {
  font-size: 13px;
  color: var(--muted);
  white-space: nowrap;
  font-variant-numeric: tabular-nums;
}

.item-desc {
  font-size: 15px;
  color: var(--text);
  opacity: .82;
  margin-top: 8px;
  max-width: 60ch;
}

/* =========================================================
   TECHNOLOGY TAGS
   ========================================================= */

.tags {
  display: flex;
  flex-wrap: wrap;
  gap: 8px;
  margin-top: 10px;
}

.tag {
  font-size: 12px;

  padding: 4px 11px;

  border: 1px solid var(--border);
  border-radius: 999px;

  color: var(--muted);
  background: var(--surface);

  transition:
    color .2s ease,
    border-color .2s ease,
    background .2s ease;
}

.tag:hover {
  color: var(--accent);
  border-color: var(--accent);
  background: var(--soft-accent);
}

/* =========================================================
   PROJECT LINKS
   ========================================================= */

.links {
  display: flex;
  gap: 14px;
  margin-top: 12px;
  font-size: 13.5px;
}

.links a {
  color: var(--accent);
  font-weight: 500;

  transition:
    opacity .2s ease,
    transform .2s ease;
}

.links a:hover {
  opacity: .75;
  transform: translateX(2px);
}

/* =========================================================
   SKILLS
   ========================================================= */

.skills-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 10px;
}

.skill-chip {
  font-size: 13.5px;

  padding: 7px 14px;

  background: var(--surface);

  border: 1px solid var(--border);
  border-radius: 8px;

  color: var(--text);

  transition:
    border-color .2s ease,
    color .2s ease,
    background .2s ease,
    transform .2s ease;
}

.skill-chip:hover {
  border-color: var(--accent);
  color: var(--accent);
  background: var(--soft-accent);

  transform: translateY(-1px);
}

/* =========================================================
   EDUCATION
   ========================================================= */

.education-item {
  position: relative;
  padding-left: 18px;
}

.education-item::before {
  content: "";

  position: absolute;

  left: 0;
  top: 9px;

  width: 7px;
  height: 7px;

  border-radius: 50%;

  background: var(--accent);

  box-shadow:
    0 0 0 4px var(--soft-accent);
}

/* =========================================================
   VOLUNTEERING
   ========================================================= */

.volunteer-item {
  border-left-color: transparent;
}

.volunteer-item:hover {
  border-left-color: var(--accent);
}

/* =========================================================
   FOOTER
   ========================================================= */

footer {
  font-size: 12.5px;

  color: var(--muted);

  border-top: 1px solid var(--border);

  padding-top: 24px;

  margin-top: 20px;
}

/* =========================================================
   RESPONSIVE
   ========================================================= */

@media(max-width:640px) {

  .wrap {
    padding: 56px 20px 90px;
  }

  h1.name {
    font-size: 42px;
  }

  .headline {
    font-size: 17px;
  }

  .bio {
    font-size: 15px;
  }

  .contact {
    gap: 12px;
    margin-bottom: 52px;
  }

  section {
    margin-bottom: 48px;
  }

  .item {
    padding-left: 12px;
  }

}

  /* ATELIER BLANC — editorial layout, theme-led surfaces, sculptural art */
  :root {
    --background: var(--paper);
    --text: var(--ink);
    --border: var(--line);
    --accent-transparent: color-mix(in srgb, var(--accent) 10%, transparent);
    --atelier-shadow: 0 24px 70px color-mix(in srgb, var(--primary) 10%, transparent);
  }
  body { background: radial-gradient(ellipse at 82% 8%, color-mix(in srgb,var(--accent) 11%,transparent),transparent 34rem), var(--paper); font-family:'DM Sans',sans-serif; }
  .wrap { width:min(100% - 56px, 1220px); max-width:none; padding:24px 0 42px; isolation:isolate; }
  .site-nav { min-height:74px; display:flex; align-items:center; justify-content:space-between; gap:24px; border-bottom:1px solid color-mix(in srgb,var(--line) 78%,transparent); }
  .wordmark,.footer-brand { display:inline-flex; align-items:center; gap:11px; font-size:10px; letter-spacing:.19em; font-weight:700; color:var(--primary); }
  .wordmark b,.footer-brand b { color:var(--accent); }
  .wordmark > span:last-child { max-width:260px; overflow:hidden; color:var(--primary); font-size:12px; letter-spacing:.06em; text-overflow:ellipsis; white-space:nowrap; }
  .wordmark-mark { width:34px; height:34px; display:grid; place-items:center; border-radius:50%; background:var(--primary); color:var(--surface); font-family:'Cormorant Garamond',serif; font-size:19px; letter-spacing:-.04em; }
  .nav-links { display:flex; align-items:center; gap:clamp(16px,3vw,38px); }
  .nav-links a { color:var(--muted); font-size:12px; transition:color .2s ease; }
  .nav-links a:hover { color:var(--accent); }
  .nav-contact,.footer-cta { display:inline-flex; align-items:center; gap:16px; padding:12px 17px; border:1px solid var(--line); border-radius:999px; color:var(--primary); font-size:12px; font-weight:600; transition:background .25s ease,color .25s ease,transform .25s ease; }
  .nav-contact span,.footer-cta span { color:var(--accent); font-size:16px; }
  .nav-contact:hover,.footer-cta:hover { transform:translateY(-2px); background:var(--primary); color:var(--surface); }
  .hero { min-height:590px; position:relative; display:flex; align-items:center; overflow:hidden; isolation:isolate; margin:22px 0 58px; padding:72px clamp(32px,7vw,92px); border:1px solid color-mix(in srgb,var(--surface) 65%,var(--line)); border-radius:32px; background:linear-gradient(115deg,var(--surface),color-mix(in srgb,var(--soft-accent) 42%,var(--surface))); box-shadow:var(--atelier-shadow); }
  .hero::before { content:''; position:absolute; inset:18px; border:1px solid color-mix(in srgb,var(--line) 38%,transparent); border-radius:22px; pointer-events:none; }
  .hero-copy { position:relative; z-index:3; width:58%; max-width:650px; }
  .artwork-scene { position:absolute; z-index:1; top:0; right:-4%; width:58%; height:100%; display:grid; place-items:center; pointer-events:none; }
  .artwork-scene svg { width:112%; max-height:112%; overflow:visible; filter:drop-shadow(0 34px 48px color-mix(in srgb,var(--primary) 20%,transparent)); animation:atelier-float 9s ease-in-out infinite; }
