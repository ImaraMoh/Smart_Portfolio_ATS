  #volunteering .item { position:relative; overflow:hidden; border-color:color-mix(in srgb,var(--accent) 26%,var(--line)); background:linear-gradient(120deg,color-mix(in srgb,var(--accent) 11%,var(--surface)),var(--surface) 58%,color-mix(in srgb,var(--soft-accent) 70%,var(--surface))); box-shadow:0 14px 38px color-mix(in srgb,var(--primary) 8%,transparent); }
