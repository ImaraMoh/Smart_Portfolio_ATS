  #projects .links a:hover { border-color:var(--surface); background:var(--surface); color:var(--primary); }
  #education .item { position:relative; overflow:hidden; border-color:color-mix(in srgb,var(--accent) 20%,var(--line)); background:linear-gradient(135deg,color-mix(in srgb,var(--soft-accent) 72%,var(--surface)),var(--surface) 82%); box-shadow:0 14px 38px color-mix(in srgb,var(--primary) 7%,transparent); transform-style:preserve-3d; }
