  h1.name { max-width:760px; margin:0; color:var(--primary); font-family:'Cormorant Garamond',serif; font-size:clamp(62px,8.3vw,112px); font-weight:500; line-height:.84; letter-spacing:-.065em; text-wrap:balance; }
  .name-period { color:var(--accent); }
  .headline { max-width:38ch; margin:24px 0 0; color:var(--primary); font-size:clamp(16px,1.7vw,21px); line-height:1.55; }
  .bio { max-width:58ch; margin:14px 0 0; color:var(--muted); font-size:14px; line-height:1.9; }
  .contact { display:flex; flex-wrap:wrap; gap:9px; margin:25px 0 0; font-size:11px; }
  .contact a,.contact span { padding:9px 13px; border:1px solid color-mix(in srgb,var(--line) 78%,transparent); border-radius:999px; color:var(--primary); background:color-mix(in srgb,var(--surface) 78%,transparent); backdrop-filter:blur(12px); transition:transform .22s ease,border-color .22s ease,color .22s ease; }
  .contact a:hover { transform:translateY(-2px); border-color:var(--accent); color:var(--accent); }
  .hero-footnote { display:flex; align-items:center; flex-wrap:wrap; gap:10px; margin-top:36px; color:var(--muted); font-size:10px; }
  .availability-dot { width:7px; height:7px; border-radius:50%; background:var(--accent); box-shadow:0 0 0 5px color-mix(in srgb,var(--accent) 13%,transparent); }
  .hero-footnote a { margin-left:10px; color:var(--primary); font-weight:600; }
  .hero-footnote a span { margin-left:5px; color:var(--accent); }
  .hero-index { position:absolute; z-index:3; right:42px; bottom:34px; color:var(--primary); font-size:9px; letter-spacing:.16em; }
  .hero-index span { color:var(--accent); }
  .portfolio-section { display:grid; grid-template-columns:repeat(2,minmax(0,1fr)); gap:14px; margin:0 0 28px; padding:28px; border:1px solid color-mix(in srgb,var(--line) 70%,transparent); border-radius:26px; background:color-mix(in srgb,var(--surface) 84%,transparent); box-shadow:0 16px 48px color-mix(in srgb,var(--primary) 6%,transparent); backdrop-filter:blur(16px); }
  .stitle { grid-column:1/-1; display:flex; align-items:center; gap:12px; margin:0 0 7px; padding:0 0 17px; border-bottom:1px solid var(--line); color:var(--primary); font-family:'Cormorant Garamond',serif; font-size:34px; font-weight:500; letter-spacing:-.035em; }
  .stitle::before { content:''; width:7px; height:7px; border-radius:50%; background:var(--accent); box-shadow:0 0 0 5px color-mix(in srgb,var(--accent) 12%,transparent); }
  .item { min-width:0; margin:0; padding:19px; border:1px solid color-mix(in srgb,var(--line) 68%,transparent); border-radius:18px; background:color-mix(in srgb,var(--surface) 94%,var(--soft-accent)); transition:transform .3s ease,box-shadow .3s ease,border-color .3s ease; }
  .item:hover { transform:translateY(-4px); border-color:color-mix(in srgb,var(--accent) 45%,var(--line)); background:var(--surface); box-shadow:0 18px 44px color-mix(in srgb,var(--primary) 10%,transparent); }
  #experience .item { position:relative; overflow:hidden; padding-left:24px; }
  #experience .item::before { content:''; position:absolute; z-index:0; top:19px; bottom:19px; left:0; width:3px; border-radius:0 4px 4px 0; background:var(--accent); transform:scaleY(.28); transform-origin:center; opacity:.58; transition:transform .35s ease,opacity .35s ease,box-shadow .35s ease; }
