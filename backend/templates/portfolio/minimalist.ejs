  .education-item { padding-left:30px; }
  .site-footer { margin-top:50px; overflow:hidden; border:1px solid color-mix(in srgb,var(--line) 65%,transparent); border-radius:28px; background:linear-gradient(120deg,var(--primary),color-mix(in srgb,var(--primary) 76%,var(--accent))); color:var(--surface); box-shadow:0 26px 65px color-mix(in srgb,var(--primary) 20%,transparent); }
  .footer-top { display:flex; align-items:center; justify-content:space-between; gap:24px; padding:38px clamp(24px,5vw,58px); }
  .footer-eyebrow { color:color-mix(in srgb,var(--surface) 62%,var(--accent)); font-size:9px; letter-spacing:.18em; text-transform:uppercase; }
  .footer-top h2 { margin:8px 0 0; color:#fff; font-family:'Cormorant Garamond',serif; font-size:clamp(28px,4vw,44px); font-weight:500; letter-spacing:-.03em; }
  .footer-eyebrow { color:rgba(255,255,255,.76); }
  .footer-cta { flex:none; border-color:rgba(255,255,255,.48); color:#fff; }
  .footer-cta:hover { background:#fff; color:var(--primary); }
  .footer-cta span { color:inherit; }
  .footer-bottom { display:flex; align-items:center; justify-content:space-between; gap:16px; padding:18px clamp(24px,5vw,58px); border-top:1px solid rgba(255,255,255,.24); color:rgba(255,255,255,.82); font-size:11px; }
  .footer-brand { color:#fff; font-size:11px; letter-spacing:.08em; }
  .footer-brand b { color:#fff; }
  .footer-brand span { color:rgba(255,255,255,.76); font-weight:400; letter-spacing:0; }
  .back-top { color:#fff; }
  @keyframes atelier-float { 0%,100% { transform:translateY(0) rotate(-1deg); } 50% { transform:translateY(-12px) rotate(1deg); } }
  @keyframes experience-sheen { 0% { left:-45%; opacity:0; } 18% { opacity:.7; } 100% { left:125%; opacity:0; } }
  @keyframes project-sheen { 0% { left:-55%; opacity:0; } 16% { opacity:.8; } 100% { left:130%; opacity:0; } }
  @keyframes skill-glyph-float { 0%,100% { transform:translateY(0) rotate(-8deg); } 50% { transform:translateY(-3px) rotate(12deg); } }
  @keyframes skill-drift { 0%,100% { translate:0 0; rotate:-.6deg; } 50% { translate:8px 0; rotate:.6deg; } }
  @media(max-width:780px) { .wrap { width:min(100% - 32px,600px); padding-top:12px; } .nav-links { display:none; } .hero { min-height:680px; align-items:flex-start; padding:54px 28px; } .hero-copy { width:100%; } .artwork-scene { top:auto; right:-18%; bottom:-2%; width:95%; height:55%; opacity:.54; } h1.name { font-size:clamp(58px,14vw,88px); } .portfolio-section { grid-template-columns:1fr; padding:20px; } .stitle { font-size:30px; } .portfolio-section--skills .stitle { grid-column:auto; } .footer-top { align-items:flex-start; flex-direction:column; } .footer-bottom { align-items:flex-start; flex-direction:column; } .hero-index { right:24px; bottom:20px; } }
  @media(prefers-reduced-motion:reduce) { .artwork-scene svg,.skill-chip,.skill-chip::before { animation:none; } .portfolio-project-art svg { transition:none; } #experience .item:hover::after { animation:none; } }

    /* Cross-device safety net */
    *,*::before,*::after { box-sizing:border-box; }
    html { width:100%; overflow-x:clip; }
    body { width:100%; max-width:100%; overflow-x:clip; }
    img,svg,video,canvas { max-width:100%; }
    .wrap,.page,main,header,footer { min-width:0; }
    @media(max-width:900px) { .wrap { width:min(100% - 36px,760px); } .hero { gap:28px; } .hero-copy,.hero-art { min-width:0; } }
    @media(max-width:640px) { .wrap { width:calc(100% - 28px); } .hero { padding:38px 22px; min-height:0; } .hero h1,.name { font-size:clamp(38px,12vw,62px); overflow-wrap:anywhere; } .section { padding:28px 18px; } .projects,.projects-grid,.education-grid,.volunteer-grid { grid-template-columns:1fr !important; } .contact,.contact-links { flex-wrap:wrap; } }
    @media(max-width:380px) { .wrap { width:calc(100% - 20px); } .hero { padding:30px 16px; } .section-title { font-size:clamp(24px,9vw,36px); } }
    @media(prefers-reduced-motion:reduce) { *,*::before,*::after { animation-duration:.01ms !important; animation-iteration-count:1 !important; scroll-behavior:auto !important; transition-duration:.01ms !important; } }
  </style>
</head>

<body>

<div class="wrap">

  <nav class="site-nav" aria-label="Portfolio navigation">
    <a class="wordmark" href="#top" aria-label="Back to top">
      <span class="wordmark-mark"><%= user.name ? user.name.charAt(0).toUpperCase() : 'A' %></span>
      <span><%= user.name %></span>
    </a>
    <div class="nav-links">
      <% if (experience && experience.length) { %><a href="#experience">Experience</a><% } %>
      <% if (projects && projects.length) { %><a href="#projects">Selected work</a><% } %>
      <% if (skills && skills.length) { %><a href="#skills">Expertise</a><% } %>
      <% if (education && education.length) { %><a href="#education">Education</a><% } %>
    </div>
    <% if (user.email) { %><a class="nav-contact" href="mailto:<%= user.email %>">Let’s talk <span>↗</span></a><% } %>
  </nav>

  <header class="hero" id="top">
    <div class="artwork-scene artwork-scene--atelier" aria-hidden="true">
      <svg viewBox="0 0 600 460" role="presentation">
        <defs>
          <radialGradient id="atelierOrb" cx="30%" cy="24%"><stop stop-color="#fff"/><stop offset=".34" stop-color="var(--soft-accent)"/><stop offset=".72" stop-color="var(--accent)"/><stop offset="1" stop-color="var(--primary)"/></radialGradient>
          <linearGradient id="atelierPage" x1="0" x2="1" y2="1"><stop stop-color="var(--surface)" stop-opacity=".98"/><stop offset="1" stop-color="var(--soft-accent)" stop-opacity=".8"/></linearGradient>
        </defs>
        <ellipse cx="340" cy="386" rx="166" ry="24" fill="var(--primary)" opacity=".13"/>
        <g transform="rotate(-8 350 215)">
          <rect x="214" y="63" width="222" height="294" rx="8" fill="url(#atelierPage)" stroke="var(--surface)" stroke-width="3"/>
          <path d="M250 114h78M250 130h126M250 282h144M250 297h112" stroke="var(--primary)" stroke-width="3" opacity=".26"/>
          <circle cx="329" cy="214" r="78" fill="url(#atelierOrb)"/>
          <ellipse cx="329" cy="214" rx="112" ry="38" transform="rotate(-28 329 214)" fill="none" stroke="var(--surface)" stroke-width="2" stroke-opacity=".85"/>
          <path d="M285 169c20-23 52-29 78-14" fill="none" stroke="var(--surface)" stroke-width="3"/>
        </g>
      </svg>
    </div>

    <div class="hero-copy">
      <div class="index"><span class="index-line"></span> Independent portfolio · <%= new Date().getFullYear() %></div>
      <h1 class="name"><%= user.name %><span class="name-period">.</span></h1>

      <% if (user.headline) { %><p class="headline"><%= user.headline %></p><% } %>
      <% if (user.bio) { %><p class="bio"><%= user.bio %></p><% } %>

      <div class="contact">

    <% if (user.email) { %>
      <a href="mailto:<%= user.email %>">
        <%= user.email %>
      </a>
    <% } %>

    <% if (user.location) { %>
      <span>
        <%= user.location %>
      </span>
    <% } %>

    <% if (user.socialLinks && user.socialLinks.github) { %>
      <a
        href="<%= user.socialLinks.github %>"
        target="_blank"
        rel="noreferrer"
      >
        GitHub
      </a>
    <% } %>

    <% if (user.socialLinks && user.socialLinks.linkedin) { %>
      <a
        href="<%= user.socialLinks.linkedin %>"
        target="_blank"
        rel="noreferrer"
      >
        LinkedIn
      </a>
    <% } %>

    <% if (user.website) { %>
      <a
        href="<%= user.website %>"
        target="_blank"
        rel="noreferrer"
      >
        Website
      </a>
    <% } %>

      </div>
      <div class="hero-footnote">
        <span class="availability-dot"></span>
        <span><%= user.location || 'Open to thoughtful collaborations' %></span>
        <a href="#projects">Explore selected work <span>↓</span></a>
      </div>
    </div>
    <div class="hero-index" aria-hidden="true">01 <span> / </span> 06</div>
  </header>


  <!-- =====================================================
       EXPERIENCE
       ===================================================== -->

  <% if (experience && experience.length) { %>

  <section id="experience" class="portfolio-section">

    <div class="stitle">
      Experience
    </div>

    <% experience.forEach(function(e){ %>

      <div class="item">

        <div class="item-head">

          <div>

            <span class="item-title">
              <%= e.role %>
            </span>

            <span class="item-sub">
              — <%= e.company %>
            </span>

          </div>

          <div class="item-date">

            <%= e.startDate
              ? new Date(e.startDate).getFullYear()
              : ''
            %>

            –

            <%= e.isCurrent
              ? 'Present'
              : (
                  e.endDate
                    ? new Date(e.endDate).getFullYear()
                    : ''
                )
            %>

          </div>

        </div>

        <% if (e.description) { %>

          <p class="item-desc">
            <%= e.description %>
          </p>

        <% } %>

        <% if (e.technologies && e.technologies.length) { %>

          <div class="tags">

            <% e.technologies.forEach(function(t){ %>

              <span class="tag">
                <%= t %>
              </span>

            <% }) %>

          </div>

        <% } %>

      </div>

    <% }) %>

  </section>

  <% } %>


  <!-- =====================================================
       PROJECTS
       ===================================================== -->

  <% if (projects && projects.length) { %>

  <section id="projects" class="portfolio-section portfolio-section--projects">

    <div class="stitle">
      Projects
    </div>

    <% projects.forEach(function(p){ %>

      <div class="item">

        <div class="portfolio-project-art" aria-hidden="true"><svg viewBox="0 0 420 160"><rect x="130" y="20" width="160" height="120" rx="4" fill="var(--surface)"/><circle cx="210" cy="78" r="39" fill="var(--accent)"/><ellipse cx="210" cy="78" rx="65" ry="22" transform="rotate(-25 210 78)" fill="none" stroke="var(--soft-accent)" stroke-width="3"/><path d="M160 124h100" stroke="var(--primary)" stroke-width="3" opacity=".5"/></svg></div>

        <div class="item-head">

          <div class="item-title">
            <%= p.title %>
          </div>

        </div>

        <% if (p.description) { %>

          <p class="item-desc">
            <%= p.description %>
          </p>

        <% } %>

        <% if (p.technologies && p.technologies.length) { %>

          <div class="tags">

            <% p.technologies.forEach(function(t){ %>

              <span class="tag">
                <%= t %>
              </span>

            <% }) %>

          </div>

        <% } %>

        <div class="links">

          <% if (p.liveURL) { %>

            <a
              href="<%= p.liveURL %>"
              target="_blank"
              rel="noreferrer"
            >
              Live ↗
            </a>

          <% } %>

          <% if (p.repoURL) { %>

            <a
              href="<%= p.repoURL %>"
              target="_blank"
              rel="noreferrer"
            >
              Code ↗
            </a>

          <% } %>

        </div>

      </div>

    <% }) %>

  </section>

  <% } %>


  <!-- =====================================================
       SKILLS
       ===================================================== -->

  <% if (skills && skills.length) { %>

  <section id="skills" class="portfolio-section portfolio-section--skills">

    <div class="stitle">
      Skills
    </div>

    <div class="skills-grid">

      <% skills.forEach(function(s){ %>

        <span class="skill-chip" data-category="<%= s.category || 'technical' %>">
          <%= s.skillName %>
        </span>

      <% }) %>

    </div>

  </section>

  <% } %>


  <!-- =====================================================
       EDUCATION
       ===================================================== -->

  <% if (education && education.length) { %>

  <section id="education" class="portfolio-section">

    <div class="stitle">
      Education
    </div>

    <% education.forEach(function(ed){ %>

      <div class="item education-item">

        <div class="item-head">

          <div>

            <span class="item-title">
              <%= ed.degree %>
            </span>

            <span class="item-sub">
              — <%= ed.institution %>
            </span>

          </div>

          <div class="item-date">

            <%= ed.startYear %>
            –
            <%= ed.endYear || 'Present' %>

          </div>

        </div>

        <% if (ed.fieldOfStudy) { %>

          <p class="item-desc">
            <%= ed.fieldOfStudy %>
          </p>

        <% } %>

        <% if (ed.grade) { %>

          <div class="tags">

            <span class="tag">
              <%= ed.grade %>
            </span>

          </div>

        <% } %>

      </div>

    <% }) %>

  </section>

  <% } %>


  <!-- =====================================================
       VOLUNTEERING
       ===================================================== -->

  <% if (volunteer && volunteer.length) { %>

  <section id="volunteering" class="portfolio-section">

    <div class="stitle">
      Volunteering
    </div>

    <% volunteer.forEach(function(v){ %>

      <div class="item volunteer-item">

        <div class="item-head">

          <div>

            <span class="item-title">
              <%= v.role %>
            </span>

            <span class="item-sub">
              — <%= v.organization %>
            </span>

          </div>

          <% if (v.startDate) { %>

            <div class="item-date">

              <%= new Date(v.startDate).getFullYear() %>
              –

              <%= v.isCurrent
                ? 'Present'
                : (
                    v.endDate
                      ? new Date(v.endDate).getFullYear()
                      : ''
                  )
              %>

            </div>

          <% } %>

        </div>

        <% if (v.description) { %>

          <p class="item-desc">
            <%= v.description %>
          </p>

        <% } %>

      </div>

    <% }) %>

  </section>

  <% } %>


  <!-- =====================================================
       FOOTER
       ===================================================== -->

  <footer class="site-footer">
    <div class="footer-top">
      <div>
        <div class="footer-eyebrow">A considered next step</div>
        <h2>Have a good project in mind?</h2>
      </div>
      <% if (user.email) { %><a class="footer-cta" href="mailto:<%= user.email %>">Start a conversation <span>↗</span></a><% } %>
    </div>
    <div class="footer-bottom">
      <a class="footer-brand" href="#top"><%= user.name %><span> · Portfolio</span></a>
      <span>Independent portfolio · Updated <%= updatedAt %></span>
      <a class="back-top" href="#top">Back to top ↑</a>
    </div>
  </footer>

</div>

</body>
</html>
