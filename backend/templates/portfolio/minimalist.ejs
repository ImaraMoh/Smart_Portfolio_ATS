<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width, initial-scale=1.0" />

<title><%= user.name %> — Portfolio</title>

<meta
  name="description"
  content="<%= user.headline || user.name %>"
/>

<link rel="preconnect" href="https://fonts.googleapis.com">

<link
  href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,400;9..144,500;9..144,600&family=Inter:wght@400;500;600&display=swap"
  rel="stylesheet"
>

<style>

/* =========================================================
   DYNAMIC COLOR THEME
   =========================================================

   These values come directly from portfolioGenerator.js:

   theme.primary
   theme.accent
   theme.background
   theme.surface
   theme.text
   theme.muted
   theme.border
   theme.softAccent

   ========================================================= */

:root {
  --paper: <%= theme.background %>;
  --ink: <%= theme.text %>;
  --line: <%= theme.border %>;

  --accent: <%= theme.accent %>;

  --muted: <%= theme.muted %>;
  --soft-accent: <%= theme.softAccent %>;

  --primary: <%= theme.primary %>;
  --surface: <%= theme.surface %>;
}

* {
  box-sizing: border-box;
}

html {
  scroll-behavior: smooth;
}

body {
  margin: 0;
  background: var(--background);
  color: var(--text);
  font-family: 'Inter', sans-serif;
  line-height: 1.6;
  -webkit-font-smoothing: antialiased;
}

a {
  text-decoration: none;
  color: inherit;
}

::selection {
  background: var(--accent);
  color: #ffffff;
}

/* =========================================================
   MAIN CONTAINER
   ========================================================= */

.wrap {
  max-width: 760px;
  margin: 0 auto;
  padding: 88px 28px 120px;
}

/* =========================================================
   HEADER
   ========================================================= */

.index {
  font-family: 'Inter', sans-serif;
  font-size: 12px;
  letter-spacing: .18em;
  color: var(--accent);
  text-transform: uppercase;
  margin-bottom: 22px;
  font-weight: 600;
}

h1.name {
  font-family: 'Fraunces', serif;
  font-weight: 500;
  font-size: clamp(38px, 6vw, 58px);
  line-height: 1.05;
  margin: 0 0 10px;
  color: var(--text);
}

.headline {
  font-size: 19px;
  color: var(--muted);
  margin: 0 0 34px;
  max-width: 46ch;
}

.bio {
  font-size: 16.5px;
  color: var(--text);
  opacity: .82;
  max-width: 60ch;
  margin-bottom: 56px;
}

/* =========================================================
   CONTACT
   ========================================================= */

.contact {
  display: flex;
  flex-wrap: wrap;
  gap: 18px;
  font-size: 14px;
  margin-bottom: 70px;
}

.contact a {
  color: var(--accent);
  border-bottom: 1px solid transparent;
  transition: all .2s ease;
}

.contact a:hover {
  border-bottom-color: var(--accent);
}

.contact span {
  color: var(--muted);
}

/* =========================================================
   SECTIONS
   ========================================================= */

section {
  margin-bottom: 64px;
}

.stitle {
  font-family: 'Inter', sans-serif;
  font-size: 12px;
  letter-spacing: .16em;
  text-transform: uppercase;
  color: var(--accent);
  font-weight: 600;

  margin-bottom: 26px;
  padding-bottom: 10px;

  border-bottom: 1px solid var(--border);
}

/* =========================================================
   ITEMS
   ========================================================= */

.item {
  margin-bottom: 30px;

  padding: 18px 0 18px 16px;

  border-left: 2px solid transparent;

  transition:
    border-color .2s ease,
    background .2s ease,
    transform .2s ease;
}

.item:hover {
  border-left-color: var(--accent);
  background: var(--accent-transparent);
}

.item:last-child {
  margin-bottom: 0;
}

.item-head {
  display: flex;
  justify-content: space-between;
  gap: 16px;
  flex-wrap: wrap;
  align-items: baseline;
}

.item-title {
  font-family: 'Fraunces', serif;
  font-size: 19px;
  font-weight: 500;
  color: var(--text);
}

.item-sub {
  color: var(--muted);
  font-size: 14.5px;
}

.item-date {
  font-size: 13px;
  color: var(--muted);
  white-space: nowrap;
  font-variant-numeric: tabular-nums;
}

.item-desc {
  font-size: 15px;
  color: var(--text);
  opacity: .82;
  margin-top: 8px;
  max-width: 60ch;
}

/* =========================================================
   TECHNOLOGY TAGS
   ========================================================= */

.tags {
  display: flex;
  flex-wrap: wrap;
  gap: 8px;
  margin-top: 10px;
}

.tag {
  font-size: 12px;

  padding: 4px 11px;

  border: 1px solid var(--border);
  border-radius: 999px;

  color: var(--muted);
  background: var(--surface);

  transition:
    color .2s ease,
    border-color .2s ease,
    background .2s ease;
}

.tag:hover {
  color: var(--accent);
  border-color: var(--accent);
  background: var(--soft-accent);
}

/* =========================================================
   PROJECT LINKS
   ========================================================= */

.links {
  display: flex;
  gap: 14px;
  margin-top: 12px;
  font-size: 13.5px;
}

.links a {
  color: var(--accent);
  font-weight: 500;

  transition:
    opacity .2s ease,
    transform .2s ease;
}

.links a:hover {
  opacity: .75;
  transform: translateX(2px);
}

/* =========================================================
   SKILLS
   ========================================================= */

.skills-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 10px;
}

.skill-chip {
  font-size: 13.5px;

  padding: 7px 14px;

  background: var(--surface);

  border: 1px solid var(--border);
  border-radius: 8px;

  color: var(--text);

  transition:
    border-color .2s ease,
    color .2s ease,
    background .2s ease,
    transform .2s ease;
}

.skill-chip:hover {
  border-color: var(--accent);
  color: var(--accent);
  background: var(--soft-accent);

  transform: translateY(-1px);
}

/* =========================================================
   EDUCATION
   ========================================================= */

.education-item {
  position: relative;
  padding-left: 18px;
}

.education-item::before {
  content: "";

  position: absolute;

  left: 0;
  top: 9px;

  width: 7px;
  height: 7px;

  border-radius: 50%;

  background: var(--accent);

  box-shadow:
    0 0 0 4px var(--soft-accent);
}

/* =========================================================
   VOLUNTEERING
   ========================================================= */

.volunteer-item {
  border-left-color: transparent;
}

.volunteer-item:hover {
  border-left-color: var(--accent);
}

/* =========================================================
   FOOTER
   ========================================================= */

footer {
  font-size: 12.5px;

  color: var(--muted);

  border-top: 1px solid var(--border);

  padding-top: 24px;

  margin-top: 20px;
}

/* =========================================================
   RESPONSIVE
   ========================================================= */

@media(max-width:640px) {

  .wrap {
    padding: 56px 20px 90px;
  }

  h1.name {
    font-size: 42px;
  }

  .headline {
    font-size: 17px;
  }

  .bio {
    font-size: 15px;
  }

  .contact {
    gap: 12px;
    margin-bottom: 52px;
  }

  section {
    margin-bottom: 48px;
  }

  .item {
    padding-left: 12px;
  }

}

</style>
</head>

<body>

<div class="wrap">

  <!-- =====================================================
       HEADER
       ===================================================== -->

  <div class="index">
    Portfolio / <%= new Date().getFullYear() %>
  </div>

  <h1 class="name">
    <%= user.name %>
  </h1>

  <% if (user.headline) { %>
    <p class="headline">
      <%= user.headline %>
    </p>
  <% } %>

  <% if (user.bio) { %>
    <p class="bio">
      <%= user.bio %>
    </p>
  <% } %>

  <!-- =====================================================
       CONTACT
       ===================================================== -->

  <div class="contact">

    <% if (user.email) { %>
      <a href="mailto:<%= user.email %>">
        <%= user.email %>
      </a>
    <% } %>

    <% if (user.location) { %>
      <span>
        <%= user.location %>
      </span>
    <% } %>

    <% if (user.socialLinks && user.socialLinks.github) { %>
      <a
        href="<%= user.socialLinks.github %>"
        target="_blank"
        rel="noreferrer"
      >
        GitHub
      </a>
    <% } %>

    <% if (user.socialLinks && user.socialLinks.linkedin) { %>
      <a
        href="<%= user.socialLinks.linkedin %>"
        target="_blank"
        rel="noreferrer"
      >
        LinkedIn
      </a>
    <% } %>

    <% if (user.website) { %>
      <a
        href="<%= user.website %>"
        target="_blank"
        rel="noreferrer"
      >
        Website
      </a>
    <% } %>

  </div>


  <!-- =====================================================
       EXPERIENCE
       ===================================================== -->

  <% if (experience && experience.length) { %>

  <section>

    <div class="stitle">
      Experience
    </div>

    <% experience.forEach(function(e){ %>

      <div class="item">

        <div class="item-head">

          <div>

            <span class="item-title">
              <%= e.role %>
            </span>

            <span class="item-sub">
              — <%= e.company %>
            </span>

          </div>

          <div class="item-date">

            <%= e.startDate
              ? new Date(e.startDate).getFullYear()
              : ''
            %>

            –

            <%= e.isCurrent
              ? 'Present'
              : (
                  e.endDate
                    ? new Date(e.endDate).getFullYear()
                    : ''
                )
            %>

          </div>

        </div>

        <% if (e.description) { %>

          <p class="item-desc">
            <%= e.description %>
          </p>

        <% } %>

        <% if (e.technologies && e.technologies.length) { %>

          <div class="tags">

            <% e.technologies.forEach(function(t){ %>

              <span class="tag">
                <%= t %>
              </span>

            <% }) %>

          </div>

        <% } %>

      </div>

    <% }) %>

  </section>

  <% } %>


  <!-- =====================================================
       PROJECTS
       ===================================================== -->

  <% if (projects && projects.length) { %>

  <section>

    <div class="stitle">
      Projects
    </div>

    <% projects.forEach(function(p){ %>

      <div class="item">

        <div class="item-head">

          <div class="item-title">
            <%= p.title %>
          </div>

        </div>

        <% if (p.description) { %>

          <p class="item-desc">
            <%= p.description %>
          </p>

        <% } %>

        <% if (p.technologies && p.technologies.length) { %>

          <div class="tags">

            <% p.technologies.forEach(function(t){ %>

              <span class="tag">
                <%= t %>
              </span>

            <% }) %>

          </div>

        <% } %>

        <div class="links">

          <% if (p.liveURL) { %>

            <a
              href="<%= p.liveURL %>"
              target="_blank"
              rel="noreferrer"
            >
              Live ↗
            </a>

          <% } %>

          <% if (p.repoURL) { %>

            <a
              href="<%= p.repoURL %>"
              target="_blank"
              rel="noreferrer"
            >
              Code ↗
            </a>

          <% } %>

        </div>

      </div>

    <% }) %>

  </section>

  <% } %>


  <!-- =====================================================
       SKILLS
       ===================================================== -->

  <% if (skills && skills.length) { %>

  <section>

    <div class="stitle">
      Skills
    </div>

    <div class="skills-grid">

      <% skills.forEach(function(s){ %>

        <span class="skill-chip">
          <%= s.skillName %>
        </span>

      <% }) %>

    </div>

  </section>

  <% } %>


  <!-- =====================================================
       EDUCATION
       ===================================================== -->

  <% if (education && education.length) { %>

  <section>

    <div class="stitle">
      Education
    </div>

    <% education.forEach(function(ed){ %>

      <div class="item education-item">

        <div class="item-head">

          <div>

            <span class="item-title">
              <%= ed.degree %>
            </span>

            <span class="item-sub">
              — <%= ed.institution %>
            </span>

          </div>

          <div class="item-date">

            <%= ed.startYear %>
            –
            <%= ed.endYear || 'Present' %>

          </div>

        </div>

        <% if (ed.fieldOfStudy) { %>

          <p class="item-desc">
            <%= ed.fieldOfStudy %>
          </p>

        <% } %>

        <% if (ed.grade) { %>

          <div class="tags">

            <span class="tag">
              <%= ed.grade %>
            </span>

          </div>

        <% } %>

      </div>

    <% }) %>

  </section>

  <% } %>


  <!-- =====================================================
       VOLUNTEERING
       ===================================================== -->

  <% if (volunteer && volunteer.length) { %>

  <section>

    <div class="stitle">
      Volunteering
    </div>

    <% volunteer.forEach(function(v){ %>

      <div class="item volunteer-item">

        <div class="item-head">

          <div>

            <span class="item-title">
              <%= v.role %>
            </span>

            <span class="item-sub">
              — <%= v.organization %>
            </span>

          </div>

          <% if (v.startDate) { %>

            <div class="item-date">

              <%= new Date(v.startDate).getFullYear() %>
              –

              <%= v.isCurrent
                ? 'Present'
                : (
                    v.endDate
                      ? new Date(v.endDate).getFullYear()
                      : ''
                  )
              %>

            </div>

          <% } %>

        </div>

        <% if (v.description) { %>

          <p class="item-desc">
            <%= v.description %>
          </p>

        <% } %>

      </div>

    <% }) %>

  </section>

  <% } %>


  <!-- =====================================================
       FOOTER
       ===================================================== -->

  <footer>

    Generated by Smart Portfolio Generator

    —

    last updated <%= updatedAt %>

  </footer>

</div>

</body>
</html>
