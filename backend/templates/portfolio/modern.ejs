      <a class="nova-nav-link" href="#projects"><span>02</span>Selected work</a>
      <a class="nova-nav-link" href="#skills"><span>03</span>Expertise</a>
      <a class="nova-nav-link nova-nav-contact" href="#contact">Let’s connect <b>↗</b></a>
    </nav>

  <div class="status">

      <span class="status-dot"></span>

      Portfolio · <%= new Date().getFullYear() %>

    </div>

  </div>


