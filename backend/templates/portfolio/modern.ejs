          <rect x="206" y="147" width="113" height="95" rx="18" fill="#fff" fill-opacity=".72"/>
          <rect x="329" y="147" width="108" height="95" rx="18" fill="#dbeafe" fill-opacity=".8"/>
          <path d="M222 218l22-27 18 13 26-34 19 14" fill="none" stroke="var(--accent)" stroke-width="5" stroke-linecap="round"/>
