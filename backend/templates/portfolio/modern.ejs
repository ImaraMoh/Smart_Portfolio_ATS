          <circle cx="468" cy="92" r="44" fill="url(#novaSphere)"/>
          <ellipse cx="468" cy="92" rx="68" ry="22" transform="rotate(34 468 92)" fill="none" stroke="#fff" stroke-opacity=".75"/>
        </g>
