<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />

  <title><%= user.name %> — Portfolio</title>

  <meta
    name="description"
    content="<%= user.headline || user.name %>"
  />

  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>

  <link
    href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@400;500;600;700&family=IBM+Plex+Mono:wght@400;500;600&display=swap"
    rel="stylesheet"
  />

  <style>

    /* =========================================================
       DYNAMIC PREMIUM THEME
       ========================================================= */

    :root {

      /*
       * These values come directly from portfolioGenerator.js
       */

      --primary: <%= theme.primary %>;
      --accent: <%= theme.accent %>;

      --background: <%= theme.background %>;
      --surface: <%= theme.surface %>;

      --text: <%= theme.text %>;
      --muted: <%= theme.muted %>;

      --border: <%= theme.border %>;
      --soft-accent: <%= theme.softAccent %>;

      /*
       * Additional dynamic layers
       */

      --accent-08: color-mix(
        in srgb,
        var(--accent) 8%,
        transparent
      );

      --accent-12: color-mix(
        in srgb,
        var(--accent) 12%,
        transparent
      );

      --accent-18: color-mix(
        in srgb,
        var(--accent) 18%,
        transparent
      );

      --accent-30: color-mix(
        in srgb,
        var(--accent) 30%,
        transparent
      );

      --accent-50: color-mix(
        in srgb,
        var(--accent) 50%,
        transparent
      );

      --surface-light: color-mix(
        in srgb,
        var(--surface) 82%,
        var(--text)
      );

      --text-soft: color-mix(
        in srgb,
        var(--text) 72%,
        var(--muted)
      );

      --radius-sm: 8px;
      --radius-md: 16px;
      --radius-lg: 24px;

      --shadow-soft:
        0 12px 35px rgba(0, 0, 0, .12);

      --shadow-premium:
        0 25px 70px rgba(0, 0, 0, .20);
    }


    /* =========================================================
       RESET
       ========================================================= */

    *,
    *::before,
    *::after {
      box-sizing: border-box;
    }

    html {
      scroll-behavior: smooth;
    }

    body {
      margin: 0;

      background:
        radial-gradient(
          circle at 85% 5%,
          var(--accent-08),
          transparent 26%
        ),
        radial-gradient(
          circle at 15% 50%,
          var(--soft-accent),
          transparent 28%
        ),
        var(--background);

      color: var(--text);

      font-family: "Space Grotesk", sans-serif;

      line-height: 1.6;

      -webkit-font-smoothing: antialiased;
      text-rendering: optimizeLegibility;

      overflow-x: hidden;
    }

    a {
      color: inherit;
      text-decoration: none;
    }

    ::selection {
      background: var(--accent);
      color: var(--background);
    }


    /* =========================================================
       PAGE DECORATION
       ========================================================= */

    body::before {
      content: "";

      position: fixed;

      inset: 0;

      pointer-events: none;

      opacity: .18;

      background-image:
        linear-gradient(
          var(--border) 1px,
          transparent 1px
        ),
        linear-gradient(
          90deg,
          var(--border) 1px,
          transparent 1px
        );

      background-size: 70px 70px;

      mask-image:
        linear-gradient(
          to bottom,
          black,
          transparent 75%
        );

      z-index: -1;
    }


    /* =========================================================
       MAIN CONTAINER
       ========================================================= */

    .page {
      width: min(1380px, calc(100% - 48px));

      margin: 0 auto;

      padding: 32px 0 80px;
    }


    /* =========================================================
       TOP BAR
       ========================================================= */

    .topbar {

      display: flex;

      align-items: center;

      justify-content: space-between;

      gap: 20px;

      margin-bottom: 24px;

      padding: 12px 16px;

      border: 1px solid var(--border);

      background:
        color-mix(
          in srgb,
          var(--surface) 92%,
          transparent
        );

      backdrop-filter: blur(18px);

      border-radius: 999px;

      box-shadow: var(--shadow-soft);
    }

    .brand {

      display: flex;

      align-items: center;

      gap: 10px;

      color: var(--text);

      font-family: "IBM Plex Mono", monospace;

      font-size: 10px;

      letter-spacing: .14em;

      text-transform: uppercase;
    }

    .brand-dot {

      width: 9px;
      height: 9px;

      border-radius: 50%;

      background: var(--accent);

      box-shadow:
        0 0 0 5px var(--accent-12),
        0 0 22px var(--accent-30);
    }

    .status {

      display: flex;

      align-items: center;

      gap: 8px;

      color: var(--muted);

      font-family: "IBM Plex Mono", monospace;

      font-size: 9px;

      letter-spacing: .08em;

      text-transform: uppercase;
    }

    .status-dot {

      width: 6px;
      height: 6px;

      border-radius: 50%;

      background: var(--accent);
    }


    /* =========================================================
       HERO
       ========================================================= */

    .hero {

      position: relative;

      display: grid;

      grid-template-columns:
        minmax(0, 1.4fr)
        minmax(260px, .6fr);

      gap: 30px;

      padding: 60px;

      margin-bottom: 26px;

      border: 1px solid var(--border);

      border-radius: var(--radius-lg);

      overflow: hidden;

      background:
        linear-gradient(
          135deg,
          var(--surface),
          color-mix(
            in srgb,
            var(--surface) 80%,
            var(--primary)
          )
        );

      box-shadow: var(--shadow-premium);
    }

    .hero::before {

      content: "";

      position: absolute;

      width: 360px;
      height: 360px;

      right: -150px;
      top: -180px;

      border-radius: 50%;

      border: 1px solid var(--accent-18);

      box-shadow:
        0 0 0 35px var(--accent-08),
        0 0 0 70px color-mix(
          in srgb,
          var(--accent) 4%,
          transparent
        );

      pointer-events: none;
    }

    .hero::after {

      content: "";

      position: absolute;

      left: 0;
      bottom: 0;

      width: 35%;
      height: 2px;

      background:
        linear-gradient(
          90deg,
          var(--accent),
          transparent
        );
    }

    .hero-content {
      position: relative;
      z-index: 1;
    }

    .eyebrow {

      display: inline-flex;

      align-items: center;

      gap: 9px;

      margin-bottom: 22px;

      color: var(--accent);

      font-family: "IBM Plex Mono", monospace;

      font-size: 10px;

      font-weight: 600;

      letter-spacing: .14em;

      text-transform: uppercase;
    }

    .eyebrow::before {

      content: "";

      width: 26px;
      height: 1px;

      background: var(--accent);
    }

    .hero h1 {

      max-width: 850px;

      margin: 0;

      color: var(--text);

      font-size: clamp(
        48px,
        7vw,
        92px
      );

      line-height: .96;

      letter-spacing: -.065em;

      font-weight: 700;
    }

    .hero h1 span {
      color: var(--accent);
    }

    .hero-headline {

      max-width: 620px;

      margin: 25px 0 0;

      color: var(--muted);

      font-size: 18px;

      line-height: 1.65;
    }

    .hero-bio {

      max-width: 650px;

      margin: 18px 0 0;

      color: var(--text-soft);

      font-size: 13.5px;

      line-height: 1.8;
    }


    /* =========================================================
       HERO META PANEL
    ========================================================= */

    .hero-panel {

      position: relative;

      z-index: 2;

      align-self: end;

      padding: 22px;

      border: 1px solid var(--border);

      border-radius: var(--radius-md);

      background:
        color-mix(
          in srgb,
          var(--background) 38%,
          var(--surface)
        );

      backdrop-filter: blur(15px);
    }

    .hero-panel-label {

      color: var(--muted);

      font-family: "IBM Plex Mono", monospace;

      font-size: 9px;

      letter-spacing: .13em;

      text-transform: uppercase;
    }

    .hero-panel-value {

      margin-top: 9px;

      color: var(--text);

      font-size: 14px;

      font-weight: 600;

      overflow-wrap: anywhere;
    }

    .hero-panel-line {

      height: 1px;

      margin: 18px 0;

      background: var(--border);
    }

    .hero-panel-link {

      display: inline-flex;

      align-items: center;

      gap: 8px;

      color: var(--accent);

      font-family: "IBM Plex Mono", monospace;

      font-size: 10px;

      font-weight: 500;

      transition: transform .2s ease;
    }

    .hero-panel-link:hover {
      transform: translateX(4px);
    }


    /* =========================================================
       CONTENT GRID
    ========================================================= */

    .content {

      display: grid;

      grid-template-columns:
        minmax(0, 1.55fr)
        minmax(280px, .65fr);

      gap: 26px;

      align-items: start;
    }

    .main-column,
    .side-column {
      min-width: 0;
    }


    /* =========================================================
       SECTION
    ========================================================= */

    section {
      margin-bottom: 26px;
    }

    .section-card {

      padding: 28px;

      border: 1px solid var(--border);

      border-radius: var(--radius-md);

      background:
        linear-gradient(
          145deg,
          var(--surface),
          color-mix(
            in srgb,
            var(--surface) 88%,
            var(--background)
          )
        );

      box-shadow: var(--shadow-soft);
    }

    .section-header {

      display: flex;

      align-items: center;

      gap: 14px;

      margin-bottom: 28px;
    }

    .section-number {

      display: inline-flex;

      align-items: center;

      justify-content: center;

      width: 31px;
      height: 31px;

      border-radius: 9px;

      background: var(--accent-08);

      border: 1px solid var(--accent-18);

      color: var(--accent);

      font-family: "IBM Plex Mono", monospace;

      font-size: 9px;

      font-weight: 600;
    }

    .section-title {

      color: var(--text);

      font-size: 13px;

      font-weight: 700;

      letter-spacing: .12em;

      text-transform: uppercase;
    }

    .section-rule {

      flex: 1;

      height: 1px;

      background:
        linear-gradient(
          90deg,
          var(--border),
          transparent
        );
    }


    /* =========================================================
       EXPERIENCE
    ========================================================= */

    .experience {

      position: relative;
    }

    .experience::before {

      content: "";

      position: absolute;

      left: 8px;

      top: 8px;
      bottom: 8px;

      width: 1px;

      background:
        linear-gradient(
          var(--accent-30),
          var(--border),
          transparent
        );
    }

    .experience-item {

      position: relative;

      display: grid;

      grid-template-columns: 130px minmax(0, 1fr);

      gap: 26px;

      padding: 0 0 35px 31px;

      margin-bottom: 35px;
    }

    .experience-item:last-child {

      padding-bottom: 0;
      margin-bottom: 0;
    }

    .experience-item::before {

      content: "";

      position: absolute;

      left: 3px;

      top: 6px;

      width: 11px;
      height: 11px;

      border-radius: 50%;

      background: var(--surface);

      border: 2px solid var(--accent);

      box-shadow:
        0 0 0 5px var(--accent-08);
    }

    .date {

      color: var(--accent);

      font-family: "IBM Plex Mono", monospace;

      font-size: 9px;

      line-height: 1.7;

      letter-spacing: .03em;
    }

    .title {

      color: var(--text);

      font-size: 18px;

      line-height: 1.35;

      font-weight: 700;

      letter-spacing: -.025em;
    }

    .sub {

      margin-top: 6px;

      color: var(--accent);

      font-family: "IBM Plex Mono", monospace;

      font-size: 11px;
    }

    .location {
      color: var(--muted);
    }

    .desc {

      margin-top: 12px;

      color: var(--muted);

      font-size: 13px;

      line-height: 1.8;
    }


    /* =========================================================
       TECHNOLOGY TAGS
    ========================================================= */

    .tags {

      display: flex;

      flex-wrap: wrap;

      gap: 7px;

      margin-top: 15px;
    }

    .tag {

      padding: 5px 9px;

      border: 1px solid var(--border);

      border-radius: 6px;

      background:
        var(--accent-08);

      color: var(--muted);

      font-family: "IBM Plex Mono", monospace;

      font-size: 9px;

      transition:
        color .2s ease,
        border-color .2s ease,
        background .2s ease,
        transform .2s ease;
    }

    .tag:hover {

      color: var(--accent);

      border-color: var(--accent-30);

      background: var(--accent-12);

      transform: translateY(-1px);
    }


    /* =========================================================
       PROJECT GRID
    ========================================================= */

    .projects {

      display: grid;

      grid-template-columns:
        repeat(2, minmax(0, 1fr));

      gap: 14px;
    }

    .project {

      position: relative;

      min-height: 270px;

      display: flex;

      flex-direction: column;

      padding: 23px;

      overflow: hidden;

      border: 1px solid var(--border);

      border-radius: var(--radius-md);

      background:
        linear-gradient(
          145deg,
          var(--surface),
          var(--background)
        );

      transition:
        transform .25s ease,
        border-color .25s ease,
        box-shadow .25s ease;
    }

    .project::before {

      content: "";

      position: absolute;

      top: -70px;
      right: -70px;

      width: 160px;
      height: 160px;

      border-radius: 50%;

      border: 1px solid var(--accent-18);

      box-shadow:
        0 0 0 22px var(--accent-08);
    }

    .project::after {

      content: "";

      position: absolute;

      left: 0;
      top: 0;

      width: 3px;
      height: 0;

      background: var(--accent);

      transition: height .3s ease;
    }

    .project:hover {

      transform: translateY(-5px);

      border-color: var(--accent-30);

      box-shadow: var(--shadow-premium);
    }

    .project:hover::after {
      height: 100%;
    }

    .project-top {

      display: flex;

      align-items: center;

      justify-content: space-between;

      position: relative;

      z-index: 2;
    }

    .project-index {

      color: var(--accent);

      font-family: "IBM Plex Mono", monospace;

      font-size: 9px;

      letter-spacing: .08em;
    }

    .featured {

      padding: 4px 8px;

      border: 1px solid var(--accent-18);

      border-radius: 999px;

      background: var(--accent-08);

      color: var(--accent);

      font-family: "IBM Plex Mono", monospace;

      font-size: 8px;

      letter-spacing: .08em;

      text-transform: uppercase;
    }

    .project-title {

      position: relative;

      z-index: 2;

      margin: 25px 0 0;

      color: var(--text);

      font-size: 20px;

      line-height: 1.3;

      font-weight: 700;

      letter-spacing: -.035em;
    }

    .project-description {

      position: relative;

      z-index: 2;

      margin-top: 11px;

      color: var(--muted);

      font-size: 12.5px;

      line-height: 1.75;
    }

    .project .tags {
      position: relative;
      z-index: 2;
    }

    .project-footer {

      display: flex;

      align-items: center;

      gap: 15px;

      margin-top: auto;

      padding-top: 22px;

      position: relative;

      z-index: 2;
    }

    .project-link {

      display: inline-flex;

      align-items: center;

      gap: 6px;

      color: var(--accent);

      font-family: "IBM Plex Mono", monospace;

      font-size: 9px;

      letter-spacing: .06em;

      transition:
        color .2s ease,
        transform .2s ease;
    }

    .project-link:hover {

      color: var(--text);

      transform: translateX(3px);
    }


    /* =========================================================
       SKILLS
    ========================================================= */

    .skills {

      display: grid;

      grid-template-columns:
        repeat(2, minmax(0, 1fr));

      gap: 8px;
    }

    .skill {

      display: flex;

      align-items: center;

      gap: 9px;

      padding: 11px 13px;

      border: 1px solid var(--border);

      border-radius: 9px;

      background: var(--background);

      color: var(--text-soft);

      font-size: 11px;

      transition:
        transform .2s ease,
        border-color .2s ease,
        color .2s ease,
        background .2s ease;
    }

    .skill::before {

      content: "";

      width: 5px;
      height: 5px;

      flex-shrink: 0;

      border-radius: 50%;

      background: var(--accent);

      box-shadow:
        0 0 0 4px var(--accent-08);
    }

    .skill:hover {

      transform: translateX(3px);

      border-color: var(--accent-30);

      color: var(--accent);

      background: var(--accent-08);
    }


    /* =========================================================
       EDUCATION
    ========================================================= */

    .education {

      display: flex;

      flex-direction: column;

      gap: 12px;
    }

    .education-card {

      position: relative;

      padding: 19px;

      border: 1px solid var(--border);

      border-radius: 12px;

      background: var(--background);

      overflow: hidden;

      transition:
        transform .2s ease,
        border-color .2s ease;
    }

    .education-card::before {

      content: "";

      position: absolute;

      left: 0;
      top: 0;
      bottom: 0;

      width: 2px;

      background: var(--accent);
    }

    .education-card:hover {

      transform: translateY(-2px);

      border-color: var(--accent-30);
    }

    .degree {

      color: var(--text);

      font-size: 14px;

      line-height: 1.45;

      font-weight: 700;
    }

    .field {
      color: var(--muted);
      font-weight: 400;
    }

    .institution {

      margin-top: 7px;

      color: var(--accent);

      font-family: "IBM Plex Mono", monospace;

      font-size: 10px;
    }

    .education-date {

      margin-top: 11px;

      color: var(--muted);

      font-family: "IBM Plex Mono", monospace;

      font-size: 9px;
    }


    /* =========================================================
       VOLUNTEERING
    ========================================================= */

    .volunteer {

      display: flex;

      flex-direction: column;
    }

    .volunteer-item {

      display: grid;

      grid-template-columns: 42px minmax(0, 1fr);

      gap: 13px;

      padding: 17px 0;

      border-bottom: 1px solid var(--border);
    }

    .volunteer-item:first-child {
      padding-top: 0;
    }

    .volunteer-item:last-child {

      padding-bottom: 0;

      border-bottom: 0;
    }

    .volunteer-icon {

      display: flex;

      align-items: center;

      justify-content: center;

      width: 38px;
      height: 38px;

      border: 1px solid var(--accent-18);

      border-radius: 10px;

      background: var(--accent-08);

      color: var(--accent);

      font-family: "IBM Plex Mono", monospace;

      font-size: 12px;

      font-weight: 600;
    }

    .volunteer-role {

      color: var(--text);

      font-size: 13px;

      font-weight: 700;
    }

    .volunteer-org {

      margin-top: 3px;

      color: var(--accent);

      font-family: "IBM Plex Mono", monospace;

      font-size: 10px;
    }

    .volunteer-description {

      margin-top: 7px;

      color: var(--muted);

      font-size: 11.5px;

      line-height: 1.7;
    }


    /* =========================================================
       CONTACT / QUICK INFO
    ========================================================= */

    .contact-list {

      display: flex;

      flex-direction: column;

      gap: 9px;
    }

    .contact-item {

      display: flex;

      align-items: center;

      gap: 11px;

      padding: 11px 12px;

      border: 1px solid var(--border);

      border-radius: 9px;

      background: var(--background);

      color: var(--muted);

      font-size: 11px;

      transition:
        color .2s ease,
        border-color .2s ease,
        transform .2s ease;
    }

    .contact-item:hover {

      color: var(--accent);

      border-color: var(--accent-30);

      transform: translateX(3px);
    }

    .contact-label {

      min-width: 36px;

      color: var(--accent);

      font-family: "IBM Plex Mono", monospace;

      font-size: 8px;

      font-weight: 600;
    }

    .contact-value {

      overflow-wrap: anywhere;
    }


    /* =========================================================
       FOOTER
    ========================================================= */

    footer {

      margin-top: 26px;

      padding: 20px 4px 0;

      border-top: 1px solid var(--border);

      color: var(--muted);

      font-family: "IBM Plex Mono", monospace;

      font-size: 9px;

      line-height: 1.7;
    }

    footer strong {
      color: var(--accent);
      font-weight: 500;
    }


    /* =========================================================
       RESPONSIVE
    ========================================================= */

    @media (max-width: 1050px) {

      .page {
        width: min(
          100% - 32px,
          1100px
        );
      }

      .hero {
        padding: 45px;
      }

      .content {
        grid-template-columns: 1fr;
      }

      .side-column {
        display: grid;

        grid-template-columns:
          repeat(2, minmax(0, 1fr));

        gap: 26px;
      }

      .side-column section {
        margin-bottom: 0;
      }

    }


    @media (max-width: 760px) {

      .page {
        width: min(
          100% - 24px,
          680px
        );

        padding-top: 18px;
      }

      .topbar {
        border-radius: 12px;
      }

      .hero {

        grid-template-columns: 1fr;

        padding: 34px 27px;

        border-radius: 20px;
      }

      .hero h1 {
        font-size: clamp(
          43px,
          14vw,
          70px
        );
      }

      .hero-panel {
        align-self: stretch;
      }

      .projects {
        grid-template-columns: 1fr;
      }

      .experience-item {
        grid-template-columns: 1fr;

        gap: 6px;
      }

      .date {
        padding-left: 0;
      }

      .side-column {
        grid-template-columns: 1fr;
      }

    }


    @media (max-width: 500px) {

      .page {
        width: calc(100% - 20px);
      }

      .topbar {
        padding: 10px 12px;
      }

      .status {
        display: none;
      }

      .hero {
        padding: 30px 21px;
      }

      .section-card {
        padding: 21px;
      }

      .skills {
        grid-template-columns: 1fr;
      }

      .project {
        min-height: 250px;
      }

    }


    /* =========================================================
       PRINT
    ========================================================= */

    @media print {

      body {
        background: white;
        color: black;
      }

      body::before {
        display: none;
      }

      .page {
        width: 100%;
        padding: 0;
      }

      .topbar {
        box-shadow: none;
      }

      .hero,
      .section-card,
      .project,
      .education-card {
        box-shadow: none;
      }

      .project:hover,
      .education-card:hover,
      .skill:hover {
        transform: none;
      }

      a {
        color: black;
      }
    }

  </style>
</head>


<body>

<div class="page">


  <!-- =========================================================
       TOP BAR
  ========================================================== -->

  <div class="topbar">

    <div class="brand">

      <span class="brand-dot"></span>

      <span>
        Smart Portfolio
      </span>

    </div>

    <div class="status">

      <span class="status-dot"></span>

      Portfolio · <%= new Date().getFullYear() %>

    </div>

  </div>


  <!-- =========================================================
       HERO
  ========================================================== -->

  <header class="hero">

    <div class="hero-content">

      <div class="eyebrow">
        Personal Portfolio
      </div>


      <h1>
        <%= user.name %>
      </h1>


      <% if (user.headline) { %>

        <p class="hero-headline">
          <%= user.headline %>
        </p>

      <% } %>


      <% if (user.bio) { %>

        <p class="hero-bio">
          <%= user.bio %>
        </p>

      <% } %>

    </div>


    <div class="hero-panel">

      <div class="hero-panel-label">
        Currently
      </div>

      <div class="hero-panel-value">

        <%= user.headline || 'Available for opportunities' %>

      </div>


      <% if (user.location) { %>

        <div class="hero-panel-line"></div>

        <div class="hero-panel-label">
          Based in
        </div>

        <div class="hero-panel-value">
          <%= user.location %>
        </div>

      <% } %>


      <% if (user.email) { %>

        <div class="hero-panel-line"></div>

        <a
          class="hero-panel-link"
          href="mailto:<%= user.email %>"
        >
          Let's connect →
        </a>

      <% } %>

    </div>

  </header>


  <!-- =========================================================
       CONTENT
  ========================================================== -->

  <div class="content">


    <!-- =======================================================
         MAIN COLUMN
    ======================================================== -->

    <main class="main-column">


      <!-- =====================================================
           EXPERIENCE
      ====================================================== -->

      <% if (experience && experience.length) { %>

        <section class="section-card">

          <div class="section-header">

            <span class="section-number">
              01
            </span>

            <span class="section-title">
              Experience
            </span>

            <span class="section-rule"></span>

          </div>


          <div class="experience">

            <% experience.forEach(function(e){ %>

              <article class="experience-item">

                <div class="date">

                  <%= e.startDate
                    ? new Date(e.startDate).toLocaleDateString(
                        'en-US',
                        {
                          month: 'short',
                          year: 'numeric'
                        }
                      )
                    : ''
                  %>

                  <% if (
                    e.startDate ||
                    e.endDate ||
                    e.isCurrent
                  ) { %>

                    <span> — </span>

                  <% } %>

                  <%= e.isCurrent
                    ? 'Present'
                    : (
                        e.endDate
                          ? new Date(e.endDate).toLocaleDateString(
                              'en-US',
                              {
                                month: 'short',
                                year: 'numeric'
                              }
                            )
                          : ''
                      )
                  %>

                </div>


                <div>

                  <div class="title">
                    <%= e.role %>
                  </div>


                  <div class="sub">

                    <%= e.company %>

                    <% if (e.location) { %>

                      <span class="location">
                        · <%= e.location %>
                      </span>

                    <% } %>

                  </div>


                  <% if (e.description) { %>

                    <div class="desc">
                      <%= e.description %>
                    </div>

                  <% } %>


                  <% if (
                    e.technologies &&
                    e.technologies.length
                  ) { %>

                    <div class="tags">

                      <% e.technologies.forEach(function(t){ %>

                        <span class="tag">
                          <%= t %>
                        </span>

                      <% }) %>

                    </div>

                  <% } %>

                </div>

              </article>

            <% }) %>

          </div>

        </section>

      <% } %>


      <!-- =====================================================
           PROJECTS
      ====================================================== -->

      <% if (projects && projects.length) { %>

        <section class="section-card">

          <div class="section-header">

            <span class="section-number">
              02
            </span>

            <span class="section-title">
              Selected Work
            </span>

            <span class="section-rule"></span>

          </div>


          <div class="projects">

            <% projects.forEach(function(p, index){ %>

              <article class="project">

                <div class="project-top">

                  <span class="project-index">

                    WORK /
                    <%= String(index + 1).padStart(2, '0') %>

                  </span>


                  <% if (p.featured) { %>

                    <span class="featured">
                      Featured
                    </span>

                  <% } %>

                </div>


                <h3 class="project-title">
                  <%= p.title %>
                </h3>


                <% if (p.description) { %>

                  <div class="project-description">
                    <%= p.description %>
                  </div>

                <% } %>


                <% if (
                  p.technologies &&
                  p.technologies.length
                ) { %>

                  <div class="tags">

                    <% p.technologies.forEach(function(t){ %>

                      <span class="tag">
                        <%= t %>
                      </span>

                    <% }) %>

                  </div>

                <% } %>


                <div class="project-footer">

                  <% if (p.liveURL) { %>

                    <a
                      class="project-link"
                      href="<%= p.liveURL %>"
                      target="_blank"
                      rel="noopener noreferrer"
                    >
                      LIVE ↗
                    </a>

                  <% } %>


                  <% if (p.repoURL) { %>

                    <a
                      class="project-link"
                      href="<%= p.repoURL %>"
                      target="_blank"
                      rel="noopener noreferrer"
                    >
                      SOURCE ↗
                    </a>

                  <% } %>

                </div>

              </article>

            <% }) %>

          </div>

        </section>

      <% } %>

    </main>


    <!-- =======================================================
         SIDE COLUMN
    ======================================================== -->

    <aside class="side-column">


      <!-- =====================================================
           CONTACT
      ====================================================== -->

      <% if (
        user.email ||
        user.location ||
        (
          user.socialLinks &&
          (
            user.socialLinks.github ||
            user.socialLinks.linkedin
          )
        ) ||
        user.website
      ) { %>

        <section class="section-card">

          <div class="section-header">

            <span class="section-number">
              03
            </span>

            <span class="section-title">
              Connect
            </span>

            <span class="section-rule"></span>

          </div>


          <div class="contact-list">

            <% if (user.email) { %>

              <a
                class="contact-item"
                href="mailto:<%= user.email %>"
              >

                <span class="contact-label">
                  MAIL
                </span>

                <span class="contact-value">
                  <%= user.email %>
                </span>

              </a>

            <% } %>


            <% if (user.location) { %>

              <div class="contact-item">

                <span class="contact-label">
                  LOC
                </span>

                <span class="contact-value">
                  <%= user.location %>
                </span>

              </div>

            <% } %>


            <% if (
              user.socialLinks &&
              user.socialLinks.github
            ) { %>

              <a
                class="contact-item"
                href="<%= user.socialLinks.github %>"
                target="_blank"
                rel="noopener noreferrer"
              >

                <span class="contact-label">
                  GH
                </span>

                <span class="contact-value">
                  GitHub ↗
                </span>

              </a>

            <% } %>


            <% if (
              user.socialLinks &&
              user.socialLinks.linkedin
            ) { %>

              <a
                class="contact-item"
                href="<%= user.socialLinks.linkedin %>"
                target="_blank"
                rel="noopener noreferrer"
              >

                <span class="contact-label">
                  IN
                </span>

                <span class="contact-value">
                  LinkedIn ↗
                </span>

              </a>

            <% } %>


            <% if (user.website) { %>

              <a
                class="contact-item"
                href="<%= user.website %>"
                target="_blank"
                rel="noopener noreferrer"
              >

                <span class="contact-label">
                  WEB
                </span>

                <span class="contact-value">
                  Website ↗
                </span>

              </a>

            <% } %>

          </div>

        </section>

      <% } %>


      <!-- =====================================================
           SKILLS
      ====================================================== -->

      <% if (skills && skills.length) { %>

        <section class="section-card">

          <div class="section-header">

            <span class="section-number">
              04
            </span>

            <span class="section-title">
              Skills
            </span>

            <span class="section-rule"></span>

          </div>


          <div class="skills">

            <% skills.forEach(function(s){ %>

              <div class="skill">
                <%= s.skillName %>
              </div>

            <% }) %>

          </div>

        </section>

      <% } %>


      <!-- =====================================================
           EDUCATION
      ====================================================== -->

      <% if (education && education.length) { %>

        <section class="section-card">

          <div class="section-header">

            <span class="section-number">
              05
            </span>

            <span class="section-title">
              Education
            </span>

            <span class="section-rule"></span>

          </div>


          <div class="education">

            <% education.forEach(function(ed){ %>

              <article class="education-card">

                <div class="degree">

                  <%= ed.degree %>

                  <% if (ed.fieldOfStudy) { %>

                    <span class="field">
                      · <%= ed.fieldOfStudy %>
                    </span>

                  <% } %>

                </div>


                <div class="institution">
                  <%= ed.institution %>
                </div>


                <div class="education-date">

                  <%= ed.startYear %>

                  —

                  <%= ed.endYear || 'Present' %>

                  <% if (ed.grade) { %>

                    · <%= ed.grade %>

                  <% } %>

                </div>


                <% if (ed.description) { %>

                  <div class="desc">
                    <%= ed.description %>
                  </div>

                <% } %>

              </article>

            <% }) %>

          </div>

        </section>

      <% } %>


      <!-- =====================================================
           VOLUNTEERING
      ====================================================== -->

      <% if (volunteer && volunteer.length) { %>

        <section class="section-card">

          <div class="section-header">

            <span class="section-number">
              06
            </span>

            <span class="section-title">
              Volunteering
            </span>

            <span class="section-rule"></span>

          </div>


          <div class="volunteer">

            <% volunteer.forEach(function(v){ %>

              <article class="volunteer-item">

                <div class="volunteer-icon">
                  +
                </div>


                <div>

                  <div class="volunteer-role">
                    <%= v.role %>
                  </div>


                  <div class="volunteer-org">
                    <%= v.organization %>
                  </div>


                  <% if (v.description) { %>

                    <div class="volunteer-description">
                      <%= v.description %>
                    </div>

                  <% } %>

                </div>

              </article>

            <% }) %>

          </div>

        </section>

      <% } %>

    </aside>

  </div>


  <!-- =========================================================
       FOOTER
  ========================================================== -->

  <footer>

    © <%= new Date().getFullYear() %>

    <strong>
      <%= user.name %>
    </strong>

    · Last updated <%= updatedAt %>

    · Smart Portfolio Generator

  </footer>

</div>

</body>
</html>
