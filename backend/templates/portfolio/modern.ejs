        <a class="hero-action hero-action-secondary" href="#projects">Explore selected work <span>↓</span></a>
      </div>

    </div>


    <div class="hero-panel">

      <div class="hero-panel-label">
        Currently
      </div>

      <div class="hero-panel-value">

        <%= user.headline || 'Available for opportunities' %>

      </div>


      <% if (user.location) { %>

        <div class="hero-panel-line"></div>

        <div class="hero-panel-label">
          Based in
        </div>

        <div class="hero-panel-value">
          <%= user.location %>
        </div>

      <% } %>


      <% if (user.email) { %>

        <div class="hero-panel-line"></div>

        <a
          class="hero-panel-link"
          href="mailto:<%= user.email %>"
        >
          Let's connect →
        </a>

      <% } %>

    </div>

  </header>


  <!-- =========================================================
       CONTENT
  ========================================================== -->

  <div class="content">


    <!-- =======================================================
         MAIN COLUMN
    ======================================================== -->

    <main class="main-column">


      <!-- =====================================================
           EXPERIENCE
      ====================================================== -->

      <% if (experience && experience.length) { %>

        <section class="section-card" id="experience">

          <div class="section-header">

            <span class="section-number">
              01
            </span>

            <span class="section-title">
              Experience
            </span>

            <span class="section-rule"></span>

          </div>


          <div class="experience">

            <% experience.forEach(function(e){ %>

              <article class="experience-item">

                <div class="date">

                  <%= e.startDate
                    ? new Date(e.startDate).toLocaleDateString(
                        'en-US',
                        {
                          month: 'short',
                          year: 'numeric'
                        }
                      )
                    : ''
                  %>

                  <% if (
                    e.startDate ||
                    e.endDate ||
                    e.isCurrent
                  ) { %>

                    <span> — </span>

                  <% } %>

                  <%= e.isCurrent
                    ? 'Present'
                    : (
                        e.endDate
                          ? new Date(e.endDate).toLocaleDateString(
                              'en-US',
                              {
                                month: 'short',
                                year: 'numeric'
                              }
                            )
                          : ''
                      )
                  %>

                </div>


                <div>

                  <div class="title">
                    <%= e.role %>
                  </div>


                  <div class="sub">

                    <%= e.company %>

                    <% if (e.location) { %>

                      <span class="location">
                        · <%= e.location %>
                      </span>

                    <% } %>

                  </div>


                  <% if (e.description) { %>

                    <div class="desc">
                      <%= e.description %>
                    </div>

                  <% } %>


                  <% if (
                    e.technologies &&
                    e.technologies.length
                  ) { %>

                    <div class="tags">

                      <% e.technologies.forEach(function(t){ %>

                        <span class="tag">
                          <%= t %>
                        </span>

                      <% }) %>

                    </div>

                  <% } %>

                </div>

              </article>

            <% }) %>

          </div>

        </section>

      <% } %>


      <!-- =====================================================
           PROJECTS
      ====================================================== -->

      <% if (projects && projects.length) { %>

        <section class="section-card" id="projects">

          <div class="section-header">

            <span class="section-number">
              02
            </span>

            <span class="section-title">
              Selected Work
            </span>

            <span class="section-rule"></span>

          </div>


          <div class="projects">

            <% projects.forEach(function(p, index){ %>

              <article class="project">

                <div class="portfolio-project-art" aria-hidden="true"><svg viewBox="0 0 420 160"><rect x="95" y="18" width="230" height="124" rx="18" fill="#fff" fill-opacity=".72"/><rect x="112" y="34" width="88" height="88" rx="12" fill="#dbeafe"/><path d="M125 106l20-25 15 13 20-29 10 8" fill="none" stroke="#4f46e5" stroke-width="5" stroke-linecap="round"/><rect x="216" y="40" width="88" height="8" rx="4" fill="#536079" opacity=".35"/><rect x="216" y="58" width="66" height="6" rx="3" fill="#536079" opacity=".2"/><path d="M220 112h18V91h18v12h18V74h18v31h18" fill="none" stroke="#20c4cb" stroke-width="4"/></svg></div>

                <div class="project-top">

                  <span class="project-index">

                    WORK /
                    <%= String(index + 1).padStart(2, '0') %>

                  </span>


                  <% if (p.featured) { %>

                    <span class="featured">
                      Featured
                    </span>

                  <% } %>

                </div>


                <h3 class="project-title">
                  <%= p.title %>
                </h3>


                <% if (p.description) { %>

                  <div class="project-description">
                    <%= p.description %>
                  </div>

                <% } %>


                <% if (
                  p.technologies &&
                  p.technologies.length
                ) { %>

                  <div class="tags">

                    <% p.technologies.forEach(function(t){ %>

                      <span class="tag">
                        <%= t %>
                      </span>

                    <% }) %>

                  </div>

                <% } %>


                <div class="project-footer">

                  <% if (p.liveURL) { %>

                    <a
                      class="project-link"
                      href="<%= p.liveURL %>"
                      target="_blank"
                      rel="noopener noreferrer"
                    >
                      LIVE ↗
                    </a>

                  <% } %>


                  <% if (p.repoURL) { %>

                    <a
                      class="project-link"
                      href="<%= p.repoURL %>"
                      target="_blank"
                      rel="noopener noreferrer"
                    >
                      SOURCE ↗
                    </a>

                  <% } %>

                </div>

              </article>

            <% }) %>

          </div>

        </section>

      <% } %>

    </main>


    <!-- =======================================================
         SIDE COLUMN
    ======================================================== -->

    <aside class="side-column">


      <!-- =====================================================
           CONTACT
      ====================================================== -->

      <% if (
        user.email ||
        user.location ||
        (
          user.socialLinks &&
          (
            user.socialLinks.github ||
            user.socialLinks.linkedin
          )
        ) ||
        user.website
      ) { %>

        <section class="section-card" id="contact">

          <div class="section-header">

            <span class="section-number">
              03
            </span>

            <span class="section-title">
              Connect
            </span>

            <span class="section-rule"></span>

          </div>


          <div class="contact-list">

            <% if (user.email) { %>

              <a
                class="contact-item"
                href="mailto:<%= user.email %>"
              >

                <span class="contact-label">
                  MAIL
                </span>

                <span class="contact-value">
                  <%= user.email %>
                </span>

              </a>

            <% } %>


            <% if (user.location) { %>

              <div class="contact-item">

                <span class="contact-label">
                  LOC
                </span>

                <span class="contact-value">
                  <%= user.location %>
                </span>

              </div>

            <% } %>


            <% if (
              user.socialLinks &&
              user.socialLinks.github
            ) { %>

              <a
                class="contact-item"
                href="<%= user.socialLinks.github %>"
                target="_blank"
                rel="noopener noreferrer"
              >

                <span class="contact-label">
                  GH
                </span>

                <span class="contact-value">
                  GitHub ↗
                </span>

              </a>

            <% } %>


            <% if (
              user.socialLinks &&
              user.socialLinks.linkedin
            ) { %>

              <a
                class="contact-item"
                href="<%= user.socialLinks.linkedin %>"
                target="_blank"
                rel="noopener noreferrer"
              >

                <span class="contact-label">
                  IN
                </span>

                <span class="contact-value">
                  LinkedIn ↗
                </span>

              </a>

            <% } %>


            <% if (user.website) { %>

              <a
                class="contact-item"
                href="<%= user.website %>"
                target="_blank"
                rel="noopener noreferrer"
              >

                <span class="contact-label">
                  WEB
                </span>

                <span class="contact-value">
                  Website ↗
                </span>

              </a>

            <% } %>

          </div>

        </section>

      <% } %>


      <!-- =====================================================
           SKILLS
      ====================================================== -->

      <% if (skills && skills.length) { %>

        <section class="section-card" id="skills">

          <div class="section-header">

            <span class="section-number">
              04
            </span>

            <span class="section-title">
              Skills
            </span>

            <span class="section-rule"></span>

          </div>


          <div class="skills">

            <% skills.forEach(function(s){ %>

              <div class="skill">
                <%= s.skillName %>
              </div>

            <% }) %>

          </div>

        </section>

      <% } %>


      <!-- =====================================================
           EDUCATION
      ====================================================== -->

      <% if (education && education.length) { %>

        <section class="section-card" id="education">

          <div class="section-header">

            <span class="section-number">
              05
            </span>

            <span class="section-title">
              Education
            </span>

            <span class="section-rule"></span>

          </div>


          <div class="education">

            <% education.forEach(function(ed){ %>

              <article class="education-card">

                <div class="degree">

                  <%= ed.degree %>

                  <% if (ed.fieldOfStudy) { %>

                    <span class="field">
                      · <%= ed.fieldOfStudy %>
                    </span>

                  <% } %>

                </div>


                <div class="institution">
                  <%= ed.institution %>
                </div>


                <div class="education-date">

                  <%= ed.startYear %>

                  —

                  <%= ed.endYear || 'Present' %>

                  <% if (ed.grade) { %>

                    · <%= ed.grade %>

                  <% } %>

                </div>


                <% if (ed.description) { %>

                  <div class="desc">
                    <%= ed.description %>
                  </div>

                <% } %>

              </article>

            <% }) %>

          </div>

        </section>

      <% } %>


      <!-- =====================================================
           VOLUNTEERING
      ====================================================== -->

      <% if (volunteer && volunteer.length) { %>

        <section class="section-card" id="volunteering">

          <div class="section-header">

            <span class="section-number">
              06
            </span>

            <span class="section-title">
              Volunteering
            </span>

            <span class="section-rule"></span>

          </div>


          <div class="volunteer">

            <% volunteer.forEach(function(v){ %>

              <article class="volunteer-item">

                <div class="volunteer-icon">
                  +
                </div>


                <div>

                  <div class="volunteer-role">
                    <%= v.role %>
                  </div>


                  <div class="volunteer-org">
                    <%= v.organization %>
                  </div>


                  <% if (v.description) { %>

                    <div class="volunteer-description">
                      <%= v.description %>
                    </div>

                  <% } %>

                </div>

              </article>

            <% }) %>

          </div>

        </section>

      <% } %>

    </aside>

  </div>


  <!-- =========================================================
       FOOTER
  ========================================================== -->

  <footer class="nova-footer">
    <span>© <%= new Date().getFullYear() %> <strong><%= user.name %></strong></span>
    <span>Independent portfolio · Updated <%= updatedAt %></span>
    <% if (user.email) { %><a href="mailto:<%= user.email %>">Let’s connect <b>↗</b></a><% } %>
  </footer>

</div>

</body>
</html>
