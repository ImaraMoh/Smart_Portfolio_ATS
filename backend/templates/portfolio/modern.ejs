<body>

<div class="page">


  <!-- =========================================================
       TOP BAR
  ========================================================== -->

  <div class="topbar">

    <div class="brand">

      <span class="brand-dot"></span>

      <span class="brand-lockup"><strong>Portfolio</strong><small><%= user.name %></small></span>

    </div>

    <nav class="nova-nav" aria-label="Portfolio sections">
