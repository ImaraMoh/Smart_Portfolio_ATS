    .section-label { color:#96a7c0; }
    .experience-card,.project-card,.education-card,.volunteer-card { border:1px solid rgba(255,255,255,.15); border-radius:18px; color:#edf4ff; background:linear-gradient(145deg,rgba(255,255,255,.105),rgba(255,255,255,.045)); box-shadow:inset 0 1px rgba(255,255,255,.14),0 16px 38px rgba(0,0,0,.18); backdrop-filter:blur(18px); transition:transform .4s cubic-bezier(.2,.8,.2,1),border-color .4s ease,box-shadow .4s ease,background .4s ease; }
    .experience-card:nth-child(even),.project-card:nth-child(even) { transform:none; }
    .experience-card:hover,.experience-card:nth-child(even):hover,.project-card:hover,.project-card:nth-child(even):hover,.education-card:hover,.volunteer-card:hover { transform:translateY(-7px); border-color:color-mix(in srgb,var(--accent) 48%,rgba(255,255,255,.14)); background:linear-gradient(145deg,rgba(255,255,255,.14),color-mix(in srgb,var(--accent) 9%,rgba(255,255,255,.055))); box-shadow:inset 0 1px rgba(255,255,255,.2),0 25px 55px rgba(0,0,0,.3),0 0 28px color-mix(in srgb,var(--accent) 10%,transparent); }
    .role,.project-title,.degree,.volunteer-role { color:#f5f7ff; font-family:"Space Grotesk",sans-serif; }
    .company,.institution,.volunteer-org { color:var(--accent); }
    .date { border:1px solid color-mix(in srgb,var(--accent) 45%,rgba(255,255,255,.13)); border-radius:999px; color:#eaf1fc; background:color-mix(in srgb,var(--accent) 15%,rgba(255,255,255,.07)); }
    .description,.project-description,.volunteer-description,.field,.education-date,.grade { color:#a9b7cc; }
    .offgrid-projects .project-card { border-color:rgba(255,255,255,.18); color:#edf4ff; background:linear-gradient(145deg,rgba(255,255,255,.12),rgba(255,255,255,.045)); }
    .portfolio-project-art { border:1px solid rgba(255,255,255,.18); border-radius:14px; background:radial-gradient(ellipse at 70% 25%,color-mix(in srgb,var(--accent) 32%,transparent),transparent 46%),linear-gradient(140deg,rgba(255,255,255,.14),rgba(255,255,255,.035)); }
    .portfolio-project-art svg { filter:drop-shadow(0 12px 20px rgba(0,0,0,.25)); }
    .offgrid-plate { border:1px solid rgba(255,255,255,.2); border-radius:999px; color:#fff; background:rgba(9,15,27,.6); backdrop-filter:blur(10px); }
    .tag { border:1px solid rgba(255,255,255,.14); border-radius:999px; color:#dbe6f6; background:rgba(255,255,255,.07); }
    .offgrid-skills { color:#edf4ff; background:radial-gradient(ellipse at 95% 10%,color-mix(in srgb,var(--accent) 20%,transparent),transparent 42%),linear-gradient(130deg,rgba(22,34,55,.92),rgba(11,18,32,.9)) !important; }
    .offgrid-skills .section-title,.offgrid-skills .section-label { color:#edf4ff; }
    .offgrid-skills .section-number { color:#fff; }
    .offgrid-skills .skills-intro h3 { color:#f5f7ff; font-family:"Space Grotesk",sans-serif; }
    .offgrid-skills .skills-intro p { color:#a9b7cc; }
    .skills-marquee { border-block-color:rgba(255,255,255,.17); }
    .skills-track .skill { min-height:48px; border:1px solid rgba(255,255,255,.17); border-radius:999px; color:#edf4ff; background:rgba(255,255,255,.075); box-shadow:inset 0 1px rgba(255,255,255,.16),0 10px 24px rgba(0,0,0,.14); backdrop-filter:blur(14px); }
    .skills-track .skill i { color:var(--accent); }
    .education-card { background:linear-gradient(145deg,rgba(255,255,255,.12),rgba(255,255,255,.04)); }
    .education-card::before { color:var(--accent); }
    .volunteer-card,.volunteer-card:nth-child(even) { background:linear-gradient(145deg,rgba(255,255,255,.11),rgba(255,255,255,.04)); }
    .volunteer-line { border:1px solid color-mix(in srgb,var(--accent) 48%,rgba(255,255,255,.18)); background:color-mix(in srgb,var(--accent) 18%,rgba(255,255,255,.08)); box-shadow:inset 0 1px rgba(255,255,255,.18); }
    .footer-box { border:1px solid rgba(255,255,255,.16); border-radius:20px; background:rgba(17,26,43,.74); box-shadow:inset 0 1px rgba(255,255,255,.15),0 22px 60px rgba(0,0,0,.25); backdrop-filter:blur(22px); }
    .footer-title { color:#f2f6ff; }
    .footer-meta { color:#a9b7cc; }
    .footer-badge { border:1px solid color-mix(in srgb,var(--accent) 45%,rgba(255,255,255,.16)); border-radius:999px; color:#edf4ff; background:color-mix(in srgb,var(--accent) 16%,rgba(255,255,255,.08)); }
    @keyframes offgrid-glass-float { 0%,100% { transform:translateY(0) rotateY(-4deg) rotateZ(-.5deg); } 50% { transform:translateY(-14px) rotateY(4deg) rotateZ(.5deg); } }
    @media(max-width:680px) { .header { min-height:0; padding:88px 22px 240px; } .offgrid-tape { border-radius:16px; } .offgrid-stack > section { border-radius:18px; } .experience-card,.project-card,.education-card,.volunteer-card { transform:none !important; } }
    @media(prefers-reduced-motion:reduce) { .artwork-scene svg,.skills-track { animation:none !important; } }
  
    /* Contrast pass: keep every inherited OFFGRID text token readable on glass */
    body { --ink:#F2F6FF; --ink-soft:#D8E2F1; --muted:#B4C0D3; --muted-light:#D1DBE8; --primary:var(--accent); --surface:#111B2E; --surface-soft:#17243A; --border:rgba(226,236,255,.17); color:#F2F6FF; }
    .offgrid-masthead,.offgrid-masthead > span:last-child { color:#C1CCDC; }
    .offgrid-wordmark { color:#F5F7FC; }
    .headline,.bio,.location,.field,.education-date,.grade,.project-index,.project-link,.featured-badge,.institution,.company,.volunteer-org,.footer-meta { color:#D4DEED; }
    .offgrid-stack > section,.offgrid-stack > section p,.offgrid-stack > section div,.offgrid-stack > section span { text-shadow:none; }
    .section-label,.description,.project-description,.volunteer-description,.skills-intro p { color:#B4C0D3 !important; }
    .section-title,.role,.project-title,.degree,.volunteer-role,.experience-company { color:#F2F6FF !important; }
    .company,.institution,.volunteer-org,.offgrid-wordmark span,.section-index { color:var(--accent) !important; }
    .date,.section-number { color:#FFF !important; }
    .education-card .field,.education-card .education-date,.education-card .grade { color:#C7D2E2; }
    .project-card .project-description { color:#B4C0D3; }
    .project-link { border-color:color-mix(in srgb,var(--accent) 55%,transparent); }
    .featured-badge { border:1px solid color-mix(in srgb,var(--accent) 52%,transparent); border-radius:999px; color:#F5F7FC; background:color-mix(in srgb,var(--accent) 20%,rgba(255,255,255,.06)); }
    .footer-title { color:#F5F7FC !important; }
  
    /* Dedicated contrast correction for the education and community panels */
    .offgrid-stack > .offgrid-education,.offgrid-stack > .offgrid-volunteer { color:#F5F7FC !important; background:linear-gradient(145deg,rgba(20,31,51,.96),rgba(12,20,35,.94)) !important; border-color:rgba(226,236,255,.22) !important; }
    .offgrid-education .section-title,.offgrid-volunteer .section-title { color:#FFFFFF !important; }
    .offgrid-education .section-label,.offgrid-volunteer .section-label { color:#CBD6E6 !important; }
    .offgrid-education .section-number,.offgrid-volunteer .section-number { color:#FFFFFF !important; }
    .offgrid-education .education-card,.offgrid-volunteer .volunteer-card,.offgrid-volunteer .volunteer-card:nth-child(even) { color:#F5F7FC !important; background:rgba(255,255,255,.095) !important; border-color:rgba(226,236,255,.22) !important; box-shadow:inset 0 1px rgba(255,255,255,.12),0 15px 34px rgba(0,0,0,.22) !important; }
    .offgrid-education .degree,.offgrid-volunteer .volunteer-role { color:#FFFFFF !important; font-weight:700; }
    .offgrid-education .institution,.offgrid-volunteer .volunteer-org { color:color-mix(in srgb,var(--accent) 48%,#FFFFFF) !important; font-weight:800; }
    .offgrid-education .field,.offgrid-education .education-date,.offgrid-education .grade,.offgrid-education .description,.offgrid-volunteer .volunteer-description { color:#D3DDEC !important; }
    .offgrid-education .education-date,.offgrid-education .grade { font-size:10px; }
</style>
</head>

<body>

<!-- =========================================================
     HERO
========================================================= -->

<header class="header">

  <div class="offgrid-masthead"><span class="offgrid-wordmark">PORTFOLIO</span><span>PERSONAL SIGNAL / <%= new Date().getFullYear() %></span><span>INDEPENDENT BY DESIGN</span></div>

  <div class="artwork-scene artwork-scene--offgrid" aria-hidden="true">
    <svg viewBox="0 0 600 460" role="presentation">
      <defs>
        <linearGradient id="offgridGlass" x1="0" y1="0" x2="1" y2="1"><stop stop-color="#fff" stop-opacity=".74"/><stop offset="1" stop-color="var(--accent)" stop-opacity=".14"/></linearGradient>
        <radialGradient id="offgridOrb" cx="28%" cy="22%"><stop stop-color="#fff"/><stop offset=".34" stop-color="var(--accent)"/><stop offset="1" stop-color="#5b5bf7"/></radialGradient>
        <linearGradient id="offgridSide" x1="0" x2="1"><stop stop-color="var(--accent)" stop-opacity=".5"/><stop offset="1" stop-color="#fff" stop-opacity=".1"/></linearGradient>
        <filter id="offgridGlow"><feGaussianBlur stdDeviation="14"/></filter>
      </defs>
      <ellipse cx="342" cy="379" rx="178" ry="20" fill="var(--accent)" opacity=".22" filter="url(#offgridGlow)"/>
      <ellipse cx="342" cy="381" rx="150" ry="17" fill="#020611" opacity=".62"/>
      <g fill="none" stroke="var(--accent)" stroke-opacity=".55">
        <ellipse cx="342" cy="212" rx="194" ry="65" transform="rotate(-22 342 212)" stroke-width="1.4"/>
        <ellipse cx="342" cy="212" rx="212" ry="88" transform="rotate(31 342 212)" stroke-opacity=".25"/>
      </g>
      <g transform="rotate(-8 333 220)">
        <rect x="190" y="70" width="260" height="286" rx="28" fill="#020611" opacity=".55" transform="translate(12 16)"/>
        <rect x="190" y="70" width="260" height="286" rx="28" fill="url(#offgridGlass)" stroke="#fff" stroke-opacity=".58" stroke-width="2"/>
        <rect x="208" y="89" width="224" height="41" rx="14" fill="#fff" fill-opacity=".25" stroke="#fff" stroke-opacity=".36"/>
        <circle cx="228" cy="109" r="5" fill="var(--accent)"/><circle cx="246" cy="109" r="5" fill="#fff" fill-opacity=".7"/><circle cx="264" cy="109" r="5" fill="#fff" fill-opacity=".35"/>
        <rect x="208" y="150" width="103" height="83" rx="17" fill="#fff" fill-opacity=".22" stroke="#fff" stroke-opacity=".32"/>
        <path d="M223 211l21-25 16 12 23-32 16 12" fill="none" stroke="var(--accent)" stroke-width="4" stroke-linecap="round" stroke-linejoin="round"/>
        <rect x="323" y="150" width="109" height="83" rx="17" fill="#fff" fill-opacity=".12" stroke="#fff" stroke-opacity=".27"/>
        <circle cx="377" cy="191" r="25" fill="none" stroke="#fff" stroke-opacity=".24" stroke-width="8"/>
        <path d="M377 166a25 25 0 0 1 23 35" fill="none" stroke="var(--accent)" stroke-width="8" stroke-linecap="round"/>
        <rect x="208" y="250" width="224" height="83" rx="17" fill="#fff" fill-opacity=".17" stroke="#fff" stroke-opacity=".3"/>
        <path d="M226 309h22v-20h22v-14h22v24h22v-32h22v36h22v-18h22v24h22" fill="none" stroke="url(#offgridSide)" stroke-width="4" stroke-linejoin="round"/>
      </g>
      <circle cx="470" cy="105" r="54" fill="url(#offgridOrb)" opacity=".9"/>
      <ellipse cx="470" cy="105" rx="81" ry="26" transform="rotate(-28 470 105)" fill="none" stroke="#fff" stroke-opacity=".65"/>
      <circle cx="151" cy="308" r="18" fill="url(#offgridOrb)" opacity=".8"/></svg>
  </div>

  <div class="header-grid" aria-hidden="true"></div>

  <div class="shape-one" aria-hidden="true"></div>
  <div class="shape-two" aria-hidden="true"></div>
  <div class="shape-three" aria-hidden="true"></div>

  <div class="header-inner">

    <div class="eyebrow">
      <span class="eyebrow-dot"></span>

      CREATIVE INDEX / 01 · <%= new Date().getFullYear() %>
    </div>

    <h1 class="name">
      <%= user.name %>
    </h1>

    <% if (user.headline) { %>

      <div class="headline">
        <%= user.headline %>
      </div>

    <% } %>

    <% if (user.bio) { %>

      <div class="bio">
        <%= user.bio %>
      </div>

    <% } %>

    <nav class="contact" aria-label="Contact and social links">

      <% if (user.email) { %>

        <a href="mailto:<%= user.email %>">
          Email ↗
        </a>

      <% } %>

      <% if (user.location) { %>

        <span>
          <%= user.location %>
        </span>

      <% } %>

      <% if (user.socialLinks && user.socialLinks.github) { %>

        <a
          href="<%= user.socialLinks.github %>"
          target="_blank"
          rel="noopener noreferrer"
          aria-label="Visit GitHub profile"
        >
          GitHub ↗
        </a>

      <% } %>

      <% if (user.socialLinks && user.socialLinks.linkedin) { %>

        <a
          href="<%= user.socialLinks.linkedin %>"
          target="_blank"
          rel="noopener noreferrer"
          aria-label="Visit LinkedIn profile"
        >
          LinkedIn ↗
        </a>

      <% } %>

      <% if (user.website) { %>

        <a
          href="<%= user.website %>"
          target="_blank"
          rel="noopener noreferrer"
          aria-label="Visit personal website"
        >
          Website ↗
        </a>

      <% } %>

    </nav>

  </div>

</header>


<main class="container" id="top">
<nav class="offgrid-tape" aria-label="Portfolio sections"><strong>FIELD GUIDE</strong><a href="#experience"><b>01</b> EXPERIENCE</a><span>✳</span><a href="#projects"><b>02</b> PROJECTS</a><span>✳</span><a href="#skills"><b>03</b> SKILLS</a><span>✳</span><a href="#education"><b>04</b> EDUCATION</a><span>✳</span><a href="#volunteering"><b>05</b> COMMUNITY</a></nav>
<div class="offgrid-stack">

<!-- =========================================================
     EXPERIENCE
========================================================= -->

<% if (experience && experience.length) { %>

<section id="experience" class="offgrid-experience">

  <div class="section-header">

    <div class="section-title-wrap">

      <div class="section-number">
        01
      </div>

      <h2 class="section-title">
        Experience
      </h2>

    </div>

    <span class="section-label">
      Career journey
    </span>

  </div>


  <div class="experience-grid">

    <% experience.forEach(function(e){ %>

      <article class="experience-card">

        <div class="experience-top">

          <div>

            <h3 class="role">
              <%= e.role %>
            </h3>

            <% if (e.company) { %>

              <div class="company">
                <%= e.company %>
              </div>

            <% } %>

            <% if (e.location) { %>

              <div class="location">
                📍 <%= e.location %>
              </div>

            <% } %>

          </div>

          <div class="date">

            <%= e.startDate
              ? new Date(e.startDate).getFullYear()
              : ''
            %>

            <% if (e.startDate || e.endDate || e.isCurrent) { %>
              –
            <% } %>

            <%= e.isCurrent
              ? 'Present'
              : (
                  e.endDate
                    ? new Date(e.endDate).getFullYear()
                    : ''
                )
            %>

          </div>

        </div>


        <% if (e.description) { %>

          <div class="description">
            <%= e.description %>
          </div>

        <% } %>


        <% if (e.technologies && e.technologies.length) { %>

          <div class="tags">

            <% e.technologies.forEach(function(t){ %>

              <span class="tag">
                <%= t %>
              </span>

            <% }) %>

          </div>

        <% } %>

      </article>

    <% }) %>

  </div>

</section>

<% } %>


<!-- =========================================================
     PROJECTS
========================================================= -->

<% if (projects && projects.length) { %>

<section id="projects" class="offgrid-projects">

  <div class="section-header">

    <div class="section-title-wrap">

      <div class="section-number">
        02
      </div>

      <h2 class="section-title">
        Projects
      </h2>

    </div>

    <span class="section-label">
      Selected work
    </span>

  </div>


  <div class="projects-grid">

    <% projects.forEach(function(p, index){ %>

      <article class="project-card <%= p.featured ? 'featured' : '' %>">

        <div class="portfolio-project-art" aria-hidden="true"><span class="offgrid-plate">PLATE / <%= String(index + 1).padStart(2,'0') %></span><svg viewBox="0 0 420 160"><rect x="121" y="19" width="178" height="122" fill="var(--ink)"/><rect x="108" y="11" width="178" height="122" fill="var(--secondary)" stroke="var(--border)" stroke-width="4"/><circle cx="228" cy="71" r="28" fill="var(--primary)" stroke="var(--border)" stroke-width="3"/><path d="M129 98h61v24h-61z" fill="var(--green)" stroke="var(--border)" stroke-width="3"/><path d="M195 119l24-40 24 40z" fill="var(--lavender)" stroke="var(--border)" stroke-width="3"/></svg></div>

        <div class="project-index" aria-hidden="true">
          <%= String(index + 1).padStart(2, '0') %>
        </div>


        <% if (p.featured) { %>

          <span class="featured-badge">
            ★ Featured
          </span>

        <% } %>


        <h3 class="project-title">
          <%= p.title %>
        </h3>


        <% if (p.description) { %>

          <div class="project-description">
            <%= p.description %>
          </div>

        <% } %>


        <% if (p.technologies && p.technologies.length) { %>

          <div class="tags">

            <% p.technologies.forEach(function(t){ %>

              <span class="tag">
                <%= t %>
              </span>

            <% }) %>

          </div>

        <% } %>


        <% if (p.liveURL || p.repoURL) { %>

          <div class="project-footer">

            <span></span>

            <div class="project-links">

              <% if (p.liveURL) { %>

                <a
                  class="project-link"
                  href="<%= p.liveURL %>"
                  target="_blank"
                  rel="noopener noreferrer"
                >
                  Live ↗
                </a>

              <% } %>


              <% if (p.repoURL) { %>

                <a
                  class="project-link"
                  href="<%= p.repoURL %>"
                  target="_blank"
                  rel="noopener noreferrer"
                >
                  Code ↗
                </a>

              <% } %>

            </div>

          </div>

        <% } %>

      </article>

    <% }) %>

  </div>

</section>

<% } %>


<!-- =========================================================
     SKILLS
========================================================= -->

<% if (skills && skills.length) { %>

<section id="skills" class="offgrid-skills">

  <div class="section-header">

    <div class="section-title-wrap">

      <div class="section-number">
        03
      </div>

      <h2 class="section-title">
        Skills
      </h2>

    </div>

    <span class="section-label">
      Core capabilities
    </span>

  </div>


  <div class="skills-layout">

    <div class="skills-intro">

      <h3>
        What I work with.
      </h3>

      <p>
        A curated collection of technical skills, tools,
        technologies, languages and professional capabilities.
      </p>

    </div>


    <div class="skills-marquee" aria-label="Skills">
      <div class="skills-track">

      <% skills.forEach(function(s){ %>

        <span class="skill">
          <i>✳</i><%= s.skillName %>
        </span>

      <% }) %>

      <% skills.forEach(function(s){ %><span class="skill" aria-hidden="true"><i>✳</i><%= s.skillName %></span><% }) %>

      </div>
    </div>

  </div>

</section>

<% } %>


<!-- =========================================================
     EDUCATION
========================================================= -->

<% if (education && education.length) { %>

<section id="education" class="offgrid-education">

  <div class="section-header">

    <div class="section-title-wrap">

      <div class="section-number">
        04
      </div>

      <h2 class="section-title">
        Education
      </h2>

    </div>

    <span class="section-label">
      Academic background
    </span>

  </div>


  <div class="education-grid">

    <% education.forEach(function(ed){ %>

      <article class="education-card">

        <div class="degree">
          <%= ed.degree %>
        </div>


        <% if (ed.institution) { %>

          <div class="institution">
            <%= ed.institution %>
          </div>

        <% } %>


        <% if (ed.fieldOfStudy) { %>

          <div class="field">
            <%= ed.fieldOfStudy %>
          </div>

        <% } %>


        <% if (ed.startYear || ed.endYear) { %>

          <div class="education-date">

            <%= ed.startYear || '' %>

            <% if (ed.startYear || ed.endYear) { %>
              –
            <% } %>

            <%= ed.endYear || 'Present' %>

          </div>

        <% } %>


        <% if (ed.grade) { %>

          <div class="grade">
            Grade / GPA:
            <strong><%= ed.grade %></strong>
          </div>

        <% } %>


        <% if (ed.description) { %>

          <div class="description">
            <%= ed.description %>
          </div>

        <% } %>

      </article>

    <% }) %>

  </div>

</section>

<% } %>


<!-- =========================================================
     VOLUNTEERING
========================================================= -->

<% if (volunteer && volunteer.length) { %>

<section id="volunteering" class="offgrid-volunteer">

  <div class="section-header">

    <div class="section-title-wrap">

      <div class="section-number">
        05
      </div>

      <h2 class="section-title">
        Volunteering
      </h2>

    </div>

    <span class="section-label">
      Community impact
    </span>

  </div>


  <div class="volunteer-grid">

    <% volunteer.forEach(function(v){ %>

      <article class="volunteer-card">

        <div class="volunteer-line"></div>

        <div>

          <div class="volunteer-role">
            <%= v.role %>
          </div>


          <% if (v.organization) { %>

            <div class="volunteer-org">
              <%= v.organization %>
            </div>

          <% } %>


          <% if (v.startDate) { %>

            <div class="location">

              <%= new Date(v.startDate).getFullYear() %>

              <% if (v.endDate || v.isCurrent) { %>
                –
              <% } %>

              <%= v.isCurrent
                ? 'Present'
                : (
                    v.endDate
                      ? new Date(v.endDate).getFullYear()
                      : ''
                  )
              %>

            </div>

          <% } %>


          <% if (v.description) { %>

            <div class="description">
              <%= v.description %>
            </div>

          <% } %>

        </div>

      </article>

    <% }) %>

  </div>

</section>

<% } %>


<!-- =========================================================
     FOOTER
========================================================= -->

</div>

<footer>

