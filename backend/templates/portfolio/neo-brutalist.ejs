<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />

  <title><%= user.name %> — Professional Portfolio</title>

  <meta
    name="description"
    content="<%= user.headline || (user.name + ' — Professional Portfolio') %>"
  />

  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>

  <link
    href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&family=Space+Grotesk:wght@500;600;700&display=swap"
    rel="stylesheet"
  >

  <style>
    :root {
      --bg: <%= theme?.background || '#F4F1EA' %>;
      --surface: <%= theme?.surface || '#FFFFFF' %>;
      --surface-soft: <%= theme?.softAccent || '#FAF9F6' %>;

      --ink: <%= theme?.text || '#101010' %>;
      --ink-soft: color-mix(in srgb, var(--ink) 84%, var(--surface));
      --muted: <%= theme?.muted || '#666666' %>;
      --muted-light: #888888;

      --primary: <%= theme?.primary || '#FF4D2E' %>;
      --secondary: <%= theme?.accent || '#FFD43B' %>;
      --accent: <%= theme?.accent || '#5B5BF7' %>;
      --green: color-mix(in srgb, var(--accent) 35%, var(--surface));

      --lavender: color-mix(in srgb, var(--accent) 18%, var(--surface));
      --peach: color-mix(in srgb, var(--primary) 20%, var(--surface));

      --border: #101010;
      --radius: 18px;

      --shadow: 8px 8px 0 var(--border);
      --shadow-accent: 8px 8px 0 var(--accent);
      --shadow-yellow: 8px 8px 0 var(--secondary);
    }

    * {
      box-sizing: border-box;
    }

    html {
      scroll-behavior: smooth;
    }

    body {
      margin: 0;
      background: var(--bg);
      color: var(--ink);
      font-family: "DM Sans", sans-serif;
      -webkit-font-smoothing: antialiased;
      text-rendering: optimizeLegibility;
    }

    body::selection {
      background: var(--secondary);
      color: var(--ink);
    }

    a {
      color: inherit;
      text-decoration: none;
    }

    button,
    a {
      -webkit-tap-highlight-color: transparent;
    }

    /* =========================================================
       GLOBAL
    ========================================================= */

    .container {
      width: min(1120px, calc(100% - 56px));
      margin: 0 auto;
    }

    .sr-only {
      position: absolute;
      width: 1px;
      height: 1px;
      padding: 0;
      margin: -1px;
      overflow: hidden;
      clip: rect(0, 0, 0, 0);
      white-space: nowrap;
      border: 0;
    }

    /* =========================================================
       HERO
    ========================================================= */

    .header {
      position: relative;
      overflow: hidden;

      min-height: 620px;

      border-bottom: 3px solid var(--border);

      background: var(--ink);
      color: white;
    }

    .header-grid {
      position: absolute;
      inset: 0;

      opacity: .08;

      background-image:
        linear-gradient(var(--secondary) 1px, transparent 1px),
        linear-gradient(90deg, var(--secondary) 1px, transparent 1px);

      background-size: 40px 40px;

      pointer-events: none;
    }

    .header-inner {
      position: relative;
      z-index: 3;

      width: min(1120px, calc(100% - 56px));

      min-height: 620px;

      margin: auto;

      display: flex;
      flex-direction: column;
      justify-content: center;

      padding: 80px 0 90px;
    }

    .eyebrow {
      display: inline-flex;
      align-items: center;
      gap: 9px;

      width: fit-content;

      padding: 8px 13px;

      border: 1px solid rgba(255,255,255,.22);
      border-radius: 999px;

      background: rgba(255,255,255,.06);

      color: rgba(255,255,255,.75);

      font-size: 11px;
      font-weight: 700;

      letter-spacing: .15em;
      text-transform: uppercase;

      backdrop-filter: blur(8px);
    }

    .eyebrow-dot {
      width: 7px;
      height: 7px;

      flex-shrink: 0;

      border-radius: 50%;

      background: var(--green);

      box-shadow:
        0 0 0 4px rgba(184,242,74,.08),
        0 0 16px rgba(184,242,74,.7);
    }

    .name {
      max-width: 950px;

      margin: 28px 0 0;

      font-family: "Space Grotesk", sans-serif;

      font-size: clamp(52px, 9vw, 104px);
      font-weight: 700;

      line-height: .9;

      letter-spacing: -.065em;

      overflow-wrap: anywhere;
    }

    .headline {
      max-width: 720px;

      margin-top: 28px;

      color: rgba(255,255,255,.82);

      font-size: clamp(18px, 2vw, 25px);
      font-weight: 600;

      line-height: 1.4;
    }

    .bio {
      max-width: 680px;

      margin-top: 17px;

      color: rgba(255,255,255,.55);

      font-size: 15px;
      line-height: 1.75;
    }

    .contact {
      display: flex;
      flex-wrap: wrap;
      gap: 9px;

      margin-top: 32px;
    }

    .contact a,
    .contact span {
      display: inline-flex;
      align-items: center;

      min-height: 38px;

      padding: 9px 14px;

      border: 1.5px solid rgba(255,255,255,.22);
      border-radius: 999px;

      background: rgba(255,255,255,.05);

      color: rgba(255,255,255,.88);

      font-size: 12px;
      font-weight: 600;

      transition:
        transform .2s ease,
        background .2s ease,
        border-color .2s ease,
        color .2s ease;
    }

    .contact a:hover {
      transform: translateY(-2px);

      background: var(--secondary);
      border-color: var(--secondary);

      color: var(--ink);
    }

    .contact a:focus-visible {
      outline: 3px solid var(--green);
      outline-offset: 4px;
    }

    /* Decorative shapes */

    .shape-one {
      position: absolute;

      z-index: 1;

      right: -70px;
      top: -80px;

      width: 310px;
      height: 310px;

      border-radius: 50%;

      background: var(--primary);

      transform: rotate(-8deg);
    }

    .shape-two {
      position: absolute;

      z-index: 1;

      right: 120px;
      bottom: -100px;

      width: 230px;
      height: 230px;

      background: var(--secondary);

      transform: rotate(15deg);
    }

    .shape-three {
      position: absolute;

      z-index: 1;

      left: -90px;
      bottom: -100px;

      width: 240px;
      height: 240px;

      border: 3px solid var(--accent);

      border-radius: 50%;

      opacity: .8;
    }

    /* =========================================================
       SECTIONS
    ========================================================= */

    section {
      padding: 76px 0;

      border-bottom: 2px solid var(--border);
    }

    .section-header {
      display: flex;
      align-items: flex-end;
      justify-content: space-between;

      gap: 20px;

      margin-bottom: 36px;
    }

    .section-title-wrap {
      display: flex;
      align-items: center;
      gap: 13px;
    }

    .section-number {
      display: flex;
      align-items: center;
      justify-content: center;

      width: 44px;
      height: 44px;

      flex-shrink: 0;

      border: 2px solid var(--border);
      border-radius: 12px;

      background: var(--primary);

      font-family: "Space Grotesk", sans-serif;
      font-size: 14px;
      font-weight: 700;

      box-shadow: 3px 3px 0 var(--border);
    }

    .section-title {
      margin: 0;

      font-family: "Space Grotesk", sans-serif;

      font-size: clamp(28px, 4vw, 43px);
      font-weight: 700;

      line-height: 1;

      letter-spacing: -.045em;
    }

    .section-label {
      color: var(--muted);

      font-size: 10px;
      font-weight: 700;

      letter-spacing: .16em;
      text-transform: uppercase;
    }

    /* =========================================================
       EXPERIENCE
    ========================================================= */

    .experience-grid {
      display: grid;
      gap: 17px;
    }

    .experience-card {
      position: relative;

      padding: 27px;

      border: 2px solid var(--border);
      border-radius: var(--radius);

      background: var(--surface);

      transition:
        transform .2s ease,
        box-shadow .2s ease;
    }

    .experience-card:hover {
      transform: translate(-2px, -4px);

      box-shadow: var(--shadow-yellow);
    }

    .experience-top {
      display: flex;

      align-items: flex-start;
      justify-content: space-between;

      gap: 24px;
    }

    .role {
      margin: 0;

      font-family: "Space Grotesk", sans-serif;

      font-size: 21px;
      font-weight: 700;

      line-height: 1.25;
    }

    .company {
      margin-top: 6px;

      color: var(--accent);

      font-size: 14px;
      font-weight: 700;
    }

    .date {
      flex-shrink: 0;

      padding: 6px 11px;

      border: 1.5px solid var(--border);
      border-radius: 999px;

      background: var(--green);

      font-size: 11px;
      font-weight: 700;

      white-space: nowrap;
    }

    .location {
      margin-top: 9px;

      color: var(--muted);

      font-size: 12px;
    }

    .description {
      max-width: 800px;

      margin-top: 16px;

      color: #444;

      font-size: 14px;
      line-height: 1.75;
    }

    .tags {
      display: flex;
      flex-wrap: wrap;
      gap: 7px;

      margin-top: 18px;
    }

    .tag {
      display: inline-flex;
      align-items: center;

      padding: 6px 10px;

      border: 1.5px solid var(--border);
      border-radius: 8px;

      background: var(--surface-soft);

      font-size: 11px;
      font-weight: 600;
    }

    /* =========================================================
       PROJECTS
    ========================================================= */

    .projects-grid {
      display: grid;

      grid-template-columns: repeat(2, minmax(0, 1fr));

      gap: 19px;
    }

    .project-card {
      position: relative;

      display: flex;
      flex-direction: column;

      min-height: 310px;

      padding: 28px;

      overflow: hidden;

      border: 2px solid var(--border);
      border-radius: var(--radius);

      background: var(--surface);

      transition:
        transform .2s ease,
        box-shadow .2s ease;
    }

    .project-card:hover {
      transform: translate(-2px, -5px);

      box-shadow: var(--shadow-accent);
    }

    .project-card.featured {
      background:
        linear-gradient(
          135deg,
          rgba(255,212,59,.12),
          transparent 45%
        ),
        var(--surface);
    }

    .project-index {
      position: absolute;

      top: 13px;
      right: 18px;

      color: #EAEAEA;

      font-family: "Space Grotesk", sans-serif;

      font-size: 38px;
      font-weight: 700;

      line-height: 1;
    }

    .featured-badge {
      display: inline-flex;

      width: fit-content;

      margin-bottom: 16px;

      padding: 5px 9px;

      border: 1.5px solid var(--border);
      border-radius: 999px;

      background: var(--secondary);

      font-size: 9px;
      font-weight: 700;

      letter-spacing: .08em;
      text-transform: uppercase;
    }

    .project-title {
      position: relative;
      z-index: 2;

      margin: 0;

      padding-right: 55px;

      font-family: "Space Grotesk", sans-serif;

      font-size: 23px;
      font-weight: 700;

      line-height: 1.2;
    }

    .project-description {
      margin-top: 14px;

      color: #555;

      font-size: 14px;
      line-height: 1.75;
    }

    .project-footer {
      display: flex;

      align-items: center;
      justify-content: space-between;

      gap: 15px;

      margin-top: auto;
      padding-top: 26px;
    }

    .project-links {
      display: flex;
      flex-wrap: wrap;
      gap: 8px;
    }

    .project-link {
      display: inline-flex;
      align-items: center;

      padding: 7px 11px;

      border: 1.5px solid var(--border);
      border-radius: 8px;

      background: white;

      font-size: 11px;
      font-weight: 700;

      transition:
        background .2s ease,
        color .2s ease,
        transform .2s ease;
    }

    .project-link:hover {
      transform: translateY(-2px);

      background: var(--ink);
      color: white;
    }

    .project-link:focus-visible {
      outline: 3px solid var(--accent);
      outline-offset: 3px;
    }

    /* =========================================================
       SKILLS
    ========================================================= */

    .skills-layout {
      display: grid;

      grid-template-columns: minmax(220px, 1fr) minmax(0, 2fr);

      gap: 45px;

      align-items: start;
    }

    .skills-intro {
      max-width: 320px;
    }

    .skills-intro h3 {
      margin: 0;

      font-family: "Space Grotesk", sans-serif;

      font-size: 26px;
      font-weight: 700;

      letter-spacing: -.03em;
    }

    .skills-intro p {
      margin: 12px 0 0;

      color: var(--muted);

      font-size: 14px;
      line-height: 1.75;
    }

    .skills-wrap {
      display: flex;
      flex-wrap: wrap;
      gap: 10px;
    }

    .skill {
      padding: 12px 15px;

      border: 2px solid var(--border);
      border-radius: 11px;

      background: white;

      font-size: 13px;
      font-weight: 700;

      transition:
        transform .2s ease,
        box-shadow .2s ease;
    }

    .skill:nth-child(4n + 1) {
      background: var(--green);
    }

    .skill:nth-child(4n + 2) {
      background: var(--secondary);
    }

    .skill:nth-child(4n + 3) {
      background: var(--lavender);
    }

    .skill:nth-child(4n + 4) {
      background: var(--peach);
    }

    .skill:hover {
      transform: translateY(-3px) rotate(-1deg);

      box-shadow: 3px 3px 0 var(--border);
    }

    /* =========================================================
       EDUCATION
    ========================================================= */

    .education-grid {
      display: grid;

      grid-template-columns: repeat(2, minmax(0, 1fr));

      gap: 17px;
    }

    .education-card {
      padding: 25px;

      border: 2px solid var(--border);
      border-radius: var(--radius);

      background: white;

      transition:
        transform .2s ease,
        box-shadow .2s ease;
    }

    .education-card:hover {
      transform: translateY(-3px);

      box-shadow: 6px 6px 0 var(--green);
    }

    .degree {
      font-family: "Space Grotesk", sans-serif;

      font-size: 20px;
      font-weight: 700;

      line-height: 1.3;
    }

    .institution {
      margin-top: 6px;

      color: var(--accent);

      font-size: 14px;
      font-weight: 700;
    }

    .field {
      margin-top: 7px;

      color: var(--muted);

      font-size: 12px;
      font-weight: 500;
    }

    .education-date {
      display: inline-flex;

      margin-top: 15px;

      padding: 6px 10px;

      border: 1.5px solid var(--border);
      border-radius: 7px;

      background: var(--secondary);

      font-size: 10px;
      font-weight: 700;
    }

    .grade {
      margin-top: 12px;

      color: var(--muted);

      font-size: 12px;
      font-weight: 600;
    }

    .grade strong {
      color: var(--ink);
    }

    /* =========================================================
       VOLUNTEERING
    ========================================================= */

    .volunteer-grid {
      display: grid;
      gap: 15px;
    }

    .volunteer-card {
      display: grid;

      grid-template-columns: 12px 1fr;

      gap: 18px;

      padding: 23px;

      border: 2px solid var(--border);
      border-radius: var(--radius);

      background: white;

      transition:
        transform .2s ease,
        box-shadow .2s ease;
    }

    .volunteer-card:hover {
      transform: translateX(3px);

      box-shadow: 6px 6px 0 var(--primary);
    }

    .volunteer-line {
      border-radius: 10px;

      background: var(--primary);
    }

    .volunteer-role {
      font-family: "Space Grotesk", sans-serif;

      font-size: 19px;
      font-weight: 700;
    }

    .volunteer-org {
      margin-top: 4px;

      color: var(--accent);

      font-size: 13px;
      font-weight: 700;
    }

    /* =========================================================
       FOOTER
    ========================================================= */

    footer {
      padding: 42px 0 60px;
    }

    .footer-box {
      display: flex;

      align-items: center;
      justify-content: space-between;

      gap: 20px;

      padding: 24px 26px;

      border: 2px solid var(--border);
      border-radius: var(--radius);

      background: var(--ink);

      color: white;
    }

    .footer-title {
      font-family: "Space Grotesk", sans-serif;

      font-size: 14px;
      font-weight: 700;
    }

    .footer-meta {
      margin-top: 5px;

      color: rgba(255,255,255,.45);

      font-size: 11px;
    }

    .footer-badge {
      padding: 8px 12px;

      border: 1.5px solid var(--border);
      border-radius: 999px;

      background: var(--green);

      color: var(--ink);

      font-size: 10px;
      font-weight: 700;

      white-space: nowrap;
    }

    /* =========================================================
       RESPONSIVE
    ========================================================= */

    @media (max-width: 820px) {

      .container,
      .header-inner {
        width: min(100% - 40px, 680px);
      }

      .header,
      .header-inner {
        min-height: 570px;
      }

      .header-inner {
        padding: 60px 0 65px;
      }

      section {
        padding: 58px 0;
      }

      .projects-grid,
      .education-grid {
        grid-template-columns: 1fr;
      }

      .skills-layout {
        grid-template-columns: 1fr;
        gap: 28px;
      }

      .skills-intro {
        max-width: 600px;
      }

      .shape-one {
        width: 210px;
        height: 210px;

        right: -100px;
      }

      .shape-two {
        display: none;
      }
    }

    @media (max-width: 600px) {

      .container,
      .header-inner {
        width: calc(100% - 32px);
      }

      .header,
      .header-inner {
        min-height: 540px;
      }

      .header-inner {
        padding: 48px 0 55px;
      }

      .name {
        margin-top: 24px;

        font-size: clamp(48px, 16vw, 72px);
      }

      .headline {
        margin-top: 22px;

        font-size: 18px;
      }

      .bio {
        font-size: 14px;
      }

      .contact {
        gap: 7px;
      }

      .contact a,
      .contact span {
        font-size: 11px;
        padding: 8px 11px;
      }

      section {
        padding: 48px 0;
      }

      .section-header {
        align-items: flex-start;
        flex-direction: column;
        gap: 12px;
      }

      .section-title {
        font-size: 31px;
      }

      .section-number {
        width: 40px;
        height: 40px;
      }

      .experience-card,
      .project-card,
      .education-card,
      .volunteer-card {
        padding: 21px;
      }

      .experience-top {
        flex-direction: column;
        gap: 11px;
      }

      .date {
        width: fit-content;
      }

      .project-card {
        min-height: 285px;
      }

      .project-footer {
        align-items: flex-start;
        flex-direction: column;
      }

      .footer-box {
        align-items: flex-start;
        flex-direction: column;
      }

      .footer-badge {
        white-space: normal;
      }

      .shape-one {
        width: 160px;
        height: 160px;

        right: -85px;
        top: -60px;
      }

      .shape-three {
        width: 150px;
        height: 150px;

        left: -80px;
        bottom: -60px;
      }
    }

    @media (max-width: 400px) {

      .name {
        font-size: 46px;
      }

      .section-title {
        font-size: 28px;
      }

      .contact {
        flex-direction: column;
        align-items: flex-start;
      }

      .contact a,
      .contact span {
        width: fit-content;
      }

      .skills-wrap {
        gap: 8px;
      }

      .skill {
        padding: 10px 12px;
        font-size: 12px;
      }
    }

    /* =========================================================
       PRINT
    ========================================================= */

    @media print {

      body {
        background: white;
      }

      .header {
        min-height: auto;
        print-color-adjust: exact;
        -webkit-print-color-adjust: exact;
      }

      .header-inner {
        min-height: auto;
        padding: 45px 0;
      }

      .shape-one,
      .shape-two,
      .shape-three,
      .header-grid {
        display: none;
      }

      section {
        padding: 35px 0;
        break-inside: avoid;
      }

      .experience-card,
      .project-card,
      .education-card,
      .volunteer-card {
        break-inside: avoid;
        box-shadow: none !important;
        transform: none !important;
      }

      .project-link {
        color: var(--ink);
      }
    }

    @media (prefers-reduced-motion: reduce) {

      html {
        scroll-behavior: auto;
      }

      *,
      *::before,
      *::after {
        transition: none !important;
        animation: none !important;
      }
    }
    /* OFFGRID — a loud poster system with hard-edge, dimensional geometry */
    .header { min-height: 740px; overflow: hidden; isolation: isolate; }
    .header-inner { position: relative; z-index: 3; width: 61%; }
    .artwork-scene { position: absolute; z-index: 1; inset: 0 0 0 auto; width: 53%; display: grid; place-items: center; pointer-events: none; }
    .artwork-scene svg { width: 112%; filter: drop-shadow(15px 18px 0 rgba(0,0,0,.32)); animation: offgrid-bob 6s steps(6,end) infinite; }
    .project-card, .education-card, .volunteer-card { border-radius: 4px; transition: transform .22s steps(4,end), box-shadow .22s steps(4,end); }
    .project-card:hover, .education-card:hover, .volunteer-card:hover { transform: translate(-6px,-6px); box-shadow: 14px 14px 0 var(--primary); }
    .section-header { margin-bottom: 34px; }
    .container { display:grid; grid-template-columns:190px minmax(0,1fr); gap:24px; align-items:start; }
    .container > footer { grid-column:1 / -1; }
    .offgrid-index { position:sticky; top:24px; display:grid; gap:12px; padding:20px 14px; border:2px solid var(--border); background:var(--secondary); box-shadow:5px 5px 0 var(--border); }
    .offgrid-index strong { margin-bottom:8px; font:700 11px "Space Grotesk",sans-serif; }
    .offgrid-index a { color:var(--ink); font:700 11px "DM Sans",sans-serif; text-decoration:none; }
    .offgrid-stack { min-width:0; display:grid; grid-template-columns:repeat(12,minmax(0,1fr)); gap:26px; }
    .offgrid-stack > .offgrid-experience,.offgrid-stack > .offgrid-projects { grid-column:span 12; }
