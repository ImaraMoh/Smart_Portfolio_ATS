<!doctype html><html lang="en"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title><%= user.name %> · Portfolio</title><meta name="description" content="<%= user.headline || user.name %>"><link href="https://fonts.googleapis.com/css2?family=DM+Mono:wght@400;500&family=DM+Sans:wght@400;500;600;700;800&family=Space+Grotesk:wght@400;500;600;700&display=swap" rel="stylesheet"><style>
:root{--ink:#17172a;--paper:#f5f3ed;--panel:#fffefa;--muted:#69697b;--line:#dedce3;--primary:<%= theme.primary %>;--accent:<%= theme.accent %>;--glow:color-mix(in srgb,var(--primary) 30%,transparent);--wash:color-mix(in srgb,var(--accent) 14%,white);--r:26px}*{box-sizing:border-box}html{scroll-behavior:smooth}body{margin:0;background:var(--paper);color:var(--ink);font-family:'DM Sans',sans-serif;overflow-x:hidden}a{color:inherit}.shell{width:min(1360px,100% - 64px);margin:auto}.topbar{height:78px;display:flex;justify-content:space-between;align-items:center;border-bottom:1px solid var(--line)}.brand{font:700 15px 'Space Grotesk';text-decoration:none;letter-spacing:-.04em}.brand i{display:inline-grid;place-items:center;width:29px;height:29px;margin-right:9px;border-radius:10px;background:var(--ink);color:white;font-style:normal}.topnav{display:flex;gap:28px}.topnav a,.avail{font:10px 'DM Mono';text-transform:uppercase;letter-spacing:.09em;text-decoration:none;color:var(--muted)}.topnav a:hover{color:var(--primary)}.avail{color:var(--ink)}
.hero{position:relative;min-height:680px;display:grid;grid-template-columns:1.08fr .92fr;align-items:center;padding:65px 0 90px}.hero-copy{position:relative;z-index:2}.eyebrow,.kicker{font:10px 'DM Mono';text-transform:uppercase;letter-spacing:.17em;color:var(--primary)}.hero h1{margin:28px 0 18px;font:600 clamp(58px,9.3vw,132px)/.88 'Space Grotesk';letter-spacing:-.085em}.hero h1 span{display:block;color:var(--primary);font-weight:500}.headline{font:500 clamp(19px,2vw,26px) 'Space Grotesk';color:#46465c}.bio{max-width:570px;color:var(--muted);font-size:15px;line-height:1.8}.links{display:flex;flex-wrap:wrap;gap:10px;margin-top:27px}.links a,.links span{padding:11px 15px;border:1px solid var(--line);border-radius:999px;background:#ffffffa8;font-size:12px;text-decoration:none}.links a:hover{border-color:var(--primary);transform:translateY(-2px)}.hero-art{height:min(550px,45vw);min-height:360px;position:relative;display:grid;place-items:center;perspective:900px}.orb{width:min(34vw,430px);aspect-ratio:1;border-radius:43% 57% 61% 39%/46% 42% 58% 54%;background:radial-gradient(circle at 30% 23%,white 0 2%,color-mix(in srgb,var(--accent) 55%,white) 8%,var(--primary) 32%,color-mix(in srgb,var(--primary) 50%,#19172c) 70%);box-shadow:inset -40px -42px 70px #07061155,inset 24px 20px 50px #ffffff77,0 55px 100px var(--glow);animation:morph 12s ease-in-out infinite,hover 6s ease-in-out infinite;transform:rotate(-16deg)}.orb:before,.orb:after{content:'';position:absolute;inset:-12%;border:1px solid color-mix(in srgb,var(--primary) 55%,transparent);border-radius:50%;transform:rotateX(68deg) rotate(-28deg)}.orb:after{inset:-23%;transform:rotateX(68deg) rotate(38deg);border-color:color-mix(in srgb,var(--accent) 60%,transparent)}.note{position:absolute;padding:15px 18px;border:1px solid white;border-radius:16px;background:#fffdf1df;box-shadow:0 18px 45px #25223b18;backdrop-filter:blur(14px);font-size:12px;animation:hover 5s ease-in-out infinite}.note b{display:block;margin-bottom:5px;font:10px 'DM Mono';color:var(--primary)}.n1{top:17%;left:0}.n2{right:0;top:61%;animation-delay:-2s}.caption{position:absolute;right:0;bottom:8%;font:10px 'DM Mono';letter-spacing:.13em;color:var(--muted)}.scroll{position:absolute;bottom:30px;font:9px 'DM Mono';letter-spacing:.16em;color:var(--muted)}
.ticker{overflow:hidden;background:var(--ink);color:white;padding:15px 0;white-space:nowrap}.ticker-track{width:max-content;display:flex;animation:marquee 28s linear infinite}.ticker span{padding-right:30px;font:11px 'DM Mono';letter-spacing:.12em;text-transform:uppercase}.ticker i{color:var(--accent);font-style:normal}main.shell{padding-bottom:10px}.section{padding:100px 0}.head{display:flex;justify-content:space-between;align-items:end;gap:24px;margin-bottom:34px}.head h2{margin:8px 0 0;font:500 clamp(38px,6vw,76px)/.95 'Space Grotesk';letter-spacing:-.07em}.head p{max-width:320px;color:var(--muted);font-size:13px;line-height:1.6}.projects{display:grid;grid-template-columns:repeat(12,1fr);gap:18px}.project{grid-column:span 6;min-height:310px;position:relative;overflow:hidden;padding:25px;border-radius:var(--r);background:var(--panel);border:1px solid var(--line);transition:.35s}.project:nth-child(4n+1){grid-column:span 7}.project:nth-child(4n+2){grid-column:span 5}.project:hover{transform:translateY(-8px) rotate(-.3deg);box-shadow:0 25px 65px #17172a18}.visual{position:absolute;inset:0 0 auto;height:140px;background:radial-gradient(circle at 74% 45%,color-mix(in srgb,var(--accent) 65%,white),transparent 19%),linear-gradient(125deg,var(--wash),color-mix(in srgb,var(--primary) 13%,white))}.visual:before{content:'';position:absolute;width:125px;height:125px;right:18%;top:9px;border-radius:38% 62% 55% 45%;background:linear-gradient(140deg,var(--accent),var(--primary));filter:drop-shadow(0 20px 25px var(--glow));transform:rotate(35deg);animation:hover 6s infinite}.visual:after{content:'';position:absolute;width:230px;height:80px;right:9%;top:32px;border:1px solid #fff9;border-radius:50%;transform:rotate(-22deg)}.project-info{position:relative;margin-top:124px}.project-no{font:10px 'DM Mono';color:var(--primary)}.project h3{margin:10px 0;font:600 25px 'Space Grotesk';letter-spacing:-.04em}.project p{color:var(--muted);font-size:13px;line-height:1.65}.tags{display:flex;gap:7px;flex-wrap:wrap;margin-top:14px}.tag{padding:6px 9px;border-radius:999px;background:var(--wash);font:9px 'DM Mono'}.project-links{display:flex;gap:16px;margin-top:15px}.project-links a{font:10px 'DM Mono';color:var(--primary);text-decoration:none}
.journey{display:grid;grid-template-columns:.7fr 1.3fr;gap:70px}.journey-aside{position:sticky;top:35px;align-self:start}.journey-aside h2{font:500 clamp(42px,6vw,76px)/.95 'Space Grotesk';letter-spacing:-.07em}.stat{font:500 54px 'Space Grotesk'}.stat small{display:block;font:10px 'DM Mono';color:var(--muted);text-transform:uppercase}.timeline{border-left:1px solid var(--line)}.job{position:relative;padding:0 0 38px 30px}.job:before{content:'';position:absolute;left:-5px;top:5px;width:9px;height:9px;border-radius:50%;background:var(--primary);box-shadow:0 0 0 6px var(--wash)}.date{font:10px 'DM Mono';color:var(--primary)}.job h3{margin:9px 0 4px;font:600 23px 'Space Grotesk'}.job-company,.job p{color:var(--muted);font-size:13px;line-height:1.7}.skills{display:flex;flex-wrap:wrap;gap:12px}.skill{padding:15px 20px;border-radius:999px;border:1px solid var(--line);background:var(--panel);font:500 14px 'Space Grotesk';transition:.3s}.skill:nth-child(3n){background:var(--primary);border-color:var(--primary);color:white}.skill:hover{transform:translateY(-5px) rotate(-2deg);box-shadow:0 12px 25px var(--glow)}.lower{display:grid;grid-template-columns:1fr 1fr;gap:22px}.panel{padding:30px;border-radius:var(--r);background:var(--panel);border:1px solid var(--line)}.panel h3{font:500 32px 'Space Grotesk';margin:8px 0 26px}.entry{padding:18px 0;border-top:1px solid var(--line)}.entry strong{font:600 16px 'Space Grotesk'}.entry p{margin:6px 0;color:var(--muted);font-size:12px;line-height:1.6}.entry small{font:10px 'DM Mono';color:var(--primary)}footer{padding:35px 0 45px;border-top:1px solid var(--line);display:flex;justify-content:space-between;gap:20px;color:var(--muted);font:10px 'DM Mono';text-transform:uppercase;letter-spacing:.1em}footer strong{color:var(--ink)}.reveal{opacity:0;transform:translateY(24px);transition:.7s}.reveal.visible{opacity:1;transform:none}
@keyframes morph{50%{border-radius:60% 40% 43% 57%/53% 62% 38% 47%}}@keyframes hover{50%{translate:0 -13px}}@keyframes marquee{to{transform:translateX(-50%)}}@media(max-width:800px){.shell{width:min(100% - 36px,680px)}.topbar{height:66px}.topnav{gap:13px}.topnav a{font-size:9px}.avail{display:none}.hero{min-height:0;grid-template-columns:1fr;padding:30px 0 75px}.hero-art{height:390px;min-height:0;grid-row:1}.orb{width:min(65vw,340px)}.hero h1{font-size:clamp(58px,15vw,100px)}.section{padding:72px 0}.head{align-items:start;flex-direction:column}.journey{grid-template-columns:1fr;gap:25px}.journey-aside{position:static}.project,.project:nth-child(n){grid-column:span 12}.lower{grid-template-columns:1fr}}@media(max-width:460px){.shell{width:calc(100% - 28px)}.topnav{gap:10px}.topnav a{font-size:8px}.hero-art{height:310px}.section{padding:58px 0}.project{padding:20px;min-height:290px}footer{flex-direction:column}}@media(prefers-reduced-motion:reduce){*,*:before,*:after{animation-duration:.01ms!important;animation-iteration-count:1!important;scroll-behavior:auto!important;transition-duration:.01ms!important}}
</style></head><body>
<div class="shell"><header class="topbar"><a class="brand" href="#top"><i>✳</i>PORTFOLIO</a><nav class="topnav"><a href="#work">Work</a><a href="#experience">Journey</a><a href="#about">About</a></nav><span class="avail">● Available for opportunities</span></header>
<section class="hero" id="top"><div class="hero-copy"><div class="eyebrow">Creative technologist · Digital maker</div><h1><%= user.name %><span>in motion.</span></h1><% if(user.headline){ %><div class="headline"><%= user.headline %></div><% } %><% if(user.bio){ %><p class="bio"><%= user.bio %></p><% } %><div class="links"><% if(user.email){ %><a href="mailto:<%= user.email %>">Start a conversation ↗</a><% } %><% if(user.location){ %><span><%= user.location %></span><% } %><% if(user.socialLinks&&user.socialLinks.github){ %><a href="<%= user.socialLinks.github %>" target="_blank" rel="noreferrer">GitHub ↗</a><% } %><% if(user.socialLinks&&user.socialLinks.linkedin){ %><a href="<%= user.socialLinks.linkedin %>" target="_blank" rel="noreferrer">LinkedIn ↗</a><% } %><% if(user.website){ %><a href="<%= user.website %>" target="_blank" rel="noreferrer">Website ↗</a><% } %></div></div><div class="hero-art" aria-hidden="true"><div class="orb"></div><div class="note n1"><b>01 / THINK</b>Make the abstract tangible</div><div class="note n2"><b>02 / BUILD</b>Small details. Big feeling.</div><div class="caption">DESIGN STUDY — 001</div></div><div class="scroll">SCROLL TO EXPLORE ↓</div></section></div>
<div class="ticker"><div class="ticker-track"><% for(let i=0;i<4;i++){ %><span>Curiosity <i>✳</i> Craft <i>✳</i> Experiments <i>✳</i> Thoughtful technology <i>✳</i></span><% } %></div></div>
<main class="shell">
<% if(projects&&projects.length){ %><section class="section reveal" id="work"><div class="head"><div><div class="kicker">01 / Selected work</div><h2>Made with intent.</h2></div><p>A collection of experiments, products, and ideas brought into the world.</p></div><div class="projects"><% projects.forEach(function(p,i){ %><article class="project"><div class="visual"></div><div class="project-info"><span class="project-no">PROJECT / <%= String(i+1).padStart(2,'0') %><% if(p.featured){ %> · FEATURED<% } %></span><h3><%= p.title %></h3><% if(p.description){ %><p><%= p.description %></p><% } %><% if(p.technologies&&p.technologies.length){ %><div class="tags"><% p.technologies.forEach(function(t){ %><span class="tag"><%= t %></span><% }) %></div><% } %><div class="project-links"><% if(p.liveURL){ %><a href="<%= p.liveURL %>" target="_blank" rel="noreferrer">LIVE ↗</a><% } %><% if(p.repoURL){ %><a href="<%= p.repoURL %>" target="_blank" rel="noreferrer">SOURCE ↗</a><% } %></div></div></article><% }) %></div></section><% } %>
<% if(experience&&experience.length){ %><section class="section reveal" id="experience"><div class="journey"><aside class="journey-aside"><div class="kicker">02 / The journey</div><h2>Where I've<br>made a mark.</h2><div class="stat"><%= String(experience.length).padStart(2,'0') %><small>Chapters so far</small></div></aside><div class="timeline"><% experience.forEach(function(e){ %><article class="job"><div class="date"><%= e.startDate?new Date(e.startDate).toLocaleDateString('en-US',{month:'short',year:'numeric'}):'' %> — <%= e.isCurrent?'Present':(e.endDate?new Date(e.endDate).toLocaleDateString('en-US',{month:'short',year:'numeric'}):'') %></div><h3><%= e.role %></h3><div class="job-company"><%= e.company %><% if(e.location){ %> · <%= e.location %><% } %></div><% if(e.description){ %><p><%= e.description %></p><% } %><% if(e.technologies&&e.technologies.length){ %><div class="tags"><% e.technologies.forEach(function(t){ %><span class="tag"><%= t %></span><% }) %></div><% } %></article><% }) %></div></div></section><% } %>
<% if(skills&&skills.length){ %><section class="section reveal" id="about"><div class="head"><div><div class="kicker">03 / Toolkit</div><h2>Things I work with.</h2></div><p>A flexible toolkit for turning a good question into a useful experience.</p></div><div class="skills"><% skills.forEach(function(s){ %><span class="skill"><%= s.skillName %></span><% }) %></div></section><% } %>
<% if((education&&education.length)||(volunteer&&volunteer.length)){ %><section class="section reveal"><div class="lower"><% if(education&&education.length){ %><div class="panel"><div class="kicker">04 / Foundations</div><h3>Education</h3><% education.forEach(function(ed){ %><article class="entry"><strong><%= ed.degree %><% if(ed.fieldOfStudy){ %> · <%= ed.fieldOfStudy %><% } %></strong><p><%= ed.institution %><% if(ed.description){ %> — <%= ed.description %><% } %></p><small><%= ed.startYear %> — <%= ed.endYear||'Present' %><% if(ed.grade){ %> · <%= ed.grade %><% } %></small></article><% }) %></div><% } %><% if(volunteer&&volunteer.length){ %><div class="panel"><div class="kicker">05 / Giving back</div><h3>Community</h3><% volunteer.forEach(function(v){ %><article class="entry"><strong><%= v.role %></strong><p><%= v.organization %><% if(v.description){ %> — <%= v.description %><% } %></p></article><% }) %></div><% } %></div></section><% } %>
<footer><strong><%= user.name %></strong><span>Made thoughtfully · Personal portfolio</span><a href="#top">Back to top ↑</a></footer></main><script>(()=>{const a=document.querySelectorAll('.reveal');if(!('IntersectionObserver'in window)){a.forEach(x=>x.classList.add('visible'));return}const o=new IntersectionObserver(es=>es.forEach(e=>{if(e.isIntersecting){e.target.classList.add('visible');o.unobserve(e.target)}}),{threshold:.12});a.forEach(x=>o.observe(x))})();</script></body></html>
