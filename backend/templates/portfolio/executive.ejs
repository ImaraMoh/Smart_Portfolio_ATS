<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />

  <title><%= user.name %> — Portfolio</title>

  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>

  <link
    href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&family=Playfair+Display:wght@500;600;700&display=swap"
    rel="stylesheet"
  />

  <style>

    /* =========================================================
       THEME SYSTEM
       Values come from backend COLOR_THEMES
    ========================================================= */

    :root {
      --primary: <%= theme?.primary || '#0B1220' %>;
      --accent: <%= theme?.accent || '#D4AF37' %>;
      --background: <%= theme?.background || '#F8FAFC' %>;
      --text: <%= theme?.text || '#111827' %>;

      --white: #FFFFFF;

      --muted: color-mix(
        in srgb,
        var(--text) 55%,
        white
      );

      --line: color-mix(
        in srgb,
        var(--text) 12%,
        white
      );

      --soft: color-mix(
        in srgb,
        var(--background) 65%,
        white
      );

      --accent-soft: color-mix(
        in srgb,
        var(--accent) 13%,
        white
      );

      --primary-soft: color-mix(
        in srgb,
        var(--primary) 8%,
        white
      );
    }

    * {
      box-sizing: border-box;
    }

    html {
      scroll-behavior: smooth;
    }

    body {
      margin: 0;
      background: var(--background);
      color: var(--text);
      font-family: "DM Sans", sans-serif;
      -webkit-font-smoothing: antialiased;
    }

    a {
      color: inherit;
      text-decoration: none;
    }

    .page {
      max-width: 1180px;
      margin: 0 auto;
      background: var(--white);
      min-height: 100vh;
      box-shadow: 0 0 80px rgba(15, 23, 42, 0.04);
    }

    /* =========================================================
       HERO
    ========================================================= */

    .hero {
      position: relative;
      overflow: hidden;
      background: var(--primary);
      color: white;
      padding: 72px 70px 68px;
    }

    .hero::before {
      content: "";
      position: absolute;

      width: 420px;
      height: 420px;

      border: 1px solid color-mix(
        in srgb,
        var(--accent) 25%,
        transparent
      );

      border-radius: 50%;

      right: -170px;
      top: -180px;
    }

    .hero::after {
      content: "";

      position: absolute;

      width: 240px;
      height: 240px;

      border: 1px solid color-mix(
        in srgb,
        var(--accent) 18%,
        transparent
      );

      border-radius: 50%;

      right: -70px;
      top: -80px;
    }

    .hero-inner {
      position: relative;
      z-index: 2;
      max-width: 950px;
    }

    .eyebrow {
      display: inline-flex;
      align-items: center;
      gap: 10px;

      margin-bottom: 24px;

      color: var(--accent);

      font-size: 11px;
      font-weight: 700;

      letter-spacing: .18em;
      text-transform: uppercase;
    }

    .eyebrow::before {
      content: "";

      width: 32px;
      height: 1px;

      background: var(--accent);
    }

    .name {
      margin: 0;

      font-family: "Playfair Display", serif;

      font-size: clamp(48px, 7vw, 82px);
      line-height: .98;

      font-weight: 600;
      letter-spacing: -.035em;
    }

    .headline {
      margin-top: 22px;

      max-width: 680px;

      color: rgba(255,255,255,.76);

      font-size: 19px;
      line-height: 1.6;
      font-weight: 500;
    }

    .bio {
      max-width: 720px;

      margin-top: 18px;

      color: rgba(255,255,255,.58);

      font-size: 14px;
      line-height: 1.8;
    }

    /* =========================================================
       CONTACT
    ========================================================= */

    .contact {
      display: flex;
      flex-wrap: wrap;
      gap: 10px;

      margin-top: 32px;
    }

    .contact a,
    .contact span {
      display: inline-flex;
      align-items: center;

      min-height: 38px;

      padding: 0 15px;

      border: 1px solid rgba(255,255,255,.15);
      border-radius: 8px;

      background: rgba(255,255,255,.05);

      color: rgba(255,255,255,.82);

      font-size: 12px;
      font-weight: 600;

      transition:
        .2s ease;
    }

    .contact a:hover {
      border-color: var(--accent);

      background: color-mix(
        in srgb,
        var(--accent) 12%,
        transparent
      );

      color: var(--accent);
    }

    /* =========================================================
       CONTENT
    ========================================================= */

    .content {
      padding: 65px 70px;
    }

    .section {
      padding: 0 0 58px;

      margin-bottom: 58px;

      border-bottom: 1px solid var(--line);
    }

    .section:last-child {
      border-bottom: none;
      margin-bottom: 0;
    }

    .section-heading {
      display: flex;

      align-items: flex-end;
      justify-content: space-between;

      gap: 20px;

      margin-bottom: 28px;
    }

    .section-label {
      margin-bottom: 7px;

      color: var(--accent);

      font-size: 10px;
      font-weight: 700;

      letter-spacing: .2em;
      text-transform: uppercase;
    }

    .section-title {
      margin: 0;

      color: var(--primary);

      font-family: "Playfair Display", serif;

      font-size: 34px;
      font-weight: 600;

      letter-spacing: -.02em;
    }

    .section-number {
      color: color-mix(
        in srgb,
        var(--text) 20%,
        white
      );

      font-family: "Playfair Display", serif;

      font-size: 42px;
      line-height: 1;
    }

    /* =========================================================
       ABOUT
    ========================================================= */

    .about-grid {
      display: grid;

      grid-template-columns: 1fr 1fr;

      gap: 24px;
    }

    .about-card {
      padding: 26px;

      border: 1px solid var(--line);

      border-radius: 14px;

      background: var(--soft);
    }

    .about-card-title {
      margin-bottom: 8px;

      color: var(--primary);

      font-size: 13px;
      font-weight: 700;
    }

    .about-card-text {
      color: var(--muted);

      font-size: 13px;
      line-height: 1.7;
    }

    /* =========================================================
       EXPERIENCE
    ========================================================= */

    .timeline {
      position: relative;
    }

    .experience-item {
      position: relative;

      display: grid;

      grid-template-columns: 175px 1fr;

      gap: 30px;

      padding: 0 0 34px;

      margin-bottom: 34px;

      border-bottom: 1px solid var(--line);
    }

    .experience-item:last-child {
      margin-bottom: 0;

      border-bottom: none;

      padding-bottom: 0;
    }

    .date {
      color: var(--accent);

      font-size: 11px;
      font-weight: 700;

      line-height: 1.6;

      letter-spacing: .06em;

      text-transform: uppercase;
    }

    .role {
      margin: 0;

      color: var(--primary);

      font-family: "Playfair Display", serif;

      font-size: 23px;
      font-weight: 600;
    }

    .company {
      margin-top: 5px;

      color: var(--accent);

      font-size: 13px;
      font-weight: 700;
    }

    .description {
      margin-top: 13px;

      color: var(--muted);

      font-size: 13.5px;

      line-height: 1.75;
    }

    /* =========================================================
       TAGS
    ========================================================= */

    .tags {
      display: flex;

      flex-wrap: wrap;

      gap: 7px;

      margin-top: 17px;
    }

    .tag {
      display: inline-flex;

      align-items: center;

      padding: 6px 10px;

      border: 1px solid var(--line);

      border-radius: 6px;

      background: var(--white);

      color: var(--muted);

      font-size: 10px;
      font-weight: 600;
    }

    .tag:hover {
      border-color: var(--accent);

      color: var(--primary);
    }

    /* =========================================================
       PROJECTS
    ========================================================= */

    .projects-grid {
      display: grid;

      grid-template-columns: repeat(2, 1fr);

      gap: 18px;
    }

    .project {
      position: relative;

      padding: 25px;

      border: 1px solid var(--line);

      border-radius: 15px;

      background: var(--white);

      transition:
        transform .2s ease,
        box-shadow .2s ease,
        border-color .2s ease;
    }

    .project:hover {
      transform: translateY(-4px);

      border-color: color-mix(
        in srgb,
        var(--accent) 60%,
        white
      );

      box-shadow:
        0 18px 45px
        color-mix(
          in srgb,
          var(--primary) 10%,
          transparent
        );
    }

    .project-featured {
      position: absolute;

      top: 18px;
      right: 18px;

      padding: 5px 9px;

      border-radius: 999px;

      background: var(--accent-soft);

      color: var(--accent);

      font-size: 9px;

      font-weight: 700;

      letter-spacing: .08em;

      text-transform: uppercase;
    }

    .project-title {
      margin: 0;

      color: var(--primary);

      font-family: "Playfair Display", serif;

      font-size: 21px;

      font-weight: 600;
    }

    .project-description {
      margin-top: 12px;

      color: var(--muted);

      font-size: 13px;

      line-height: 1.7;
    }

    .project-links {
      display: flex;

      gap: 17px;

      margin-top: 20px;
    }

    .project-links a {
      color: var(--primary);

      font-size: 11px;

      font-weight: 700;

      border-bottom: 1px solid var(--accent);

      padding-bottom: 2px;

      transition: .2s ease;
    }

    .project-links a:hover {
      color: var(--accent);
    }

    /* =========================================================
       SKILLS
    ========================================================= */

    .skills-grid {
      display: grid;

      grid-template-columns: repeat(3, 1fr);

      gap: 10px;
    }

    .skill {
      position: relative;

      padding: 15px 17px;

      border: 1px solid var(--line);

      border-radius: 10px;

      background: var(--soft);

      color: var(--primary);

      font-size: 12px;

      font-weight: 600;

      transition: .2s ease;
    }

    .skill::before {
      content: "";

      display: inline-block;

      width: 5px;
      height: 5px;

      margin-right: 9px;

      vertical-align: middle;

      border-radius: 50%;

      background: var(--accent);
    }

    .skill:hover {
      border-color: var(--accent);

      background: var(--white);

      transform: translateY(-2px);
    }

    /* =========================================================
       EDUCATION
    ========================================================= */

    .education-grid {
      display: grid;

      grid-template-columns: repeat(2, 1fr);

      gap: 18px;
    }

    .education {
      padding: 24px;

      border-left: 3px solid var(--accent);

      background: var(--soft);
    }

    .degree {
      color: var(--primary);

      font-family: "Playfair Display", serif;

      font-size: 19px;

      font-weight: 600;
    }

    .institution {
      margin-top: 5px;

      color: var(--accent);

      font-size: 12px;

      font-weight: 700;
    }

    .education-date {
      margin-top: 11px;

      color: var(--muted);

      font-size: 11px;
    }

    /* =========================================================
       VOLUNTEERING
    ========================================================= */

    .volunteer-item {
      display: flex;

      align-items: flex-start;

      gap: 18px;

      padding: 19px 0;

      border-bottom: 1px solid var(--line);
    }

    .volunteer-item:last-child {
      border-bottom: none;
    }

    .volunteer-icon {
      display: flex;

      align-items: center;
      justify-content: center;

      width: 38px;
      height: 38px;

      flex-shrink: 0;

      border-radius: 10px;

      background: var(--primary);

      color: var(--accent);

      font-size: 13px;

      font-weight: 700;
    }

    .volunteer-role {
      color: var(--primary);

      font-size: 14px;

      font-weight: 700;
    }

    .volunteer-org {
      margin-top: 3px;

      color: var(--accent);

      font-size: 12px;

      font-weight: 600;
    }

    .volunteer-description {
      margin-top: 7px;

      color: var(--muted);

      font-size: 12.5px;

      line-height: 1.65;
    }

    /* =========================================================
       FOOTER
    ========================================================= */

    footer {
      padding: 28px 70px;

      border-top: 1px solid var(--line);

      color: var(--muted);

      font-size: 11px;

      line-height: 1.6;
    }

    footer strong {
      color: var(--primary);
    }

    /* =========================================================
       RESPONSIVE
    ========================================================= */

    @media (max-width: 800px) {

      .hero {
        padding: 55px 28px 48px;
      }

      .content {
        padding: 48px 28px;
      }

      footer {
        padding: 25px 28px;
      }

      .about-grid,
      .projects-grid,
      .education-grid {
        grid-template-columns: 1fr;
      }

      .skills-grid {
        grid-template-columns: repeat(2, 1fr);
      }

      .experience-item {
        grid-template-columns: 1fr;
        gap: 8px;
      }

    }

    @media (max-width: 500px) {

      .hero {
        padding: 45px 20px 40px;
      }

      .content {
        padding: 40px 20px;
      }

      .name {
        font-size: 48px;
      }

      .section-title {
        font-size: 29px;
      }

      .skills-grid {
        grid-template-columns: 1fr;
      }

      footer {
        padding: 22px 20px;
      }

    }

    @media print {

      body {
        background: white;
      }

      .page {
        max-width: none;
      }

      .hero {
        print-color-adjust: exact;
        -webkit-print-color-adjust: exact;
      }

      .project:hover {
        transform: none;
        box-shadow: none;
      }

    }

  </style>
</head>

<body>

<div class="page">

  <!-- =======================================================
       HERO
  ======================================================== -->

  <header class="hero">

    <div class="hero-inner">

      <div class="eyebrow">
        Professional Portfolio · <%= new Date().getFullYear() %>
      </div>

      <h1 class="name">
        <%= user.name %>
      </h1>

      <% if (user.headline) { %>

        <div class="headline">
          <%= user.headline %>
        </div>

      <% } %>

      <% if (user.bio) { %>

        <div class="bio">
          <%= user.bio %>
        </div>

      <% } %>

      <div class="contact">

        <% if (user.email) { %>

          <a href="mailto:<%= user.email %>">
            <%= user.email %>
          </a>

        <% } %>

        <% if (user.location) { %>

          <span>
            <%= user.location %>
          </span>

        <% } %>

        <% if (user.socialLinks && user.socialLinks.github) { %>

          <a
            href="<%= user.socialLinks.github %>"
            target="_blank"
            rel="noreferrer"
          >
            GitHub
          </a>

        <% } %>

        <% if (user.socialLinks && user.socialLinks.linkedin) { %>

          <a
            href="<%= user.socialLinks.linkedin %>"
            target="_blank"
            rel="noreferrer"
          >
            LinkedIn
          </a>

        <% } %>

        <% if (user.website) { %>

          <a
            href="<%= user.website %>"
            target="_blank"
            rel="noreferrer"
          >
            Website
          </a>

        <% } %>

      </div>

    </div>

  </header>


  <!-- =======================================================
       CONTENT
  ======================================================== -->

  <main class="content">

    <!-- =====================================================
         EXPERIENCE
    ====================================================== -->

    <% if (experience && experience.length) { %>

      <section class="section">

        <div class="section-heading">

          <div>

            <div class="section-label">
              Career
            </div>

            <h2 class="section-title">
              Experience
            </h2>

          </div>

          <div class="section-number">
            01
          </div>

        </div>

        <div class="timeline">

          <% experience.forEach(function(e){ %>

            <article class="experience-item">

              <div class="date">

                <%= e.startDate
                  ? new Date(e.startDate).toLocaleDateString(
                      'en-US',
                      {
                        month: 'short',
                        year: 'numeric'
                      }
                    )
                  : ''
                %>

                —

                <%= e.isCurrent
                  ? 'Present'
                  : (
                      e.endDate
                        ? new Date(e.endDate).toLocaleDateString(
                            'en-US',
                            {
                              month: 'short',
                              year: 'numeric'
                            }
                          )
                        : ''
                    )
                %>

              </div>

              <div>

                <h3 class="role">
                  <%= e.role %>
                </h3>

                <div class="company">

                  <%= e.company %>

                  <% if (e.location) { %>

                    · <%= e.location %>

                  <% } %>

                </div>

                <% if (e.description) { %>

                  <div class="description">
                    <%= e.description %>
                  </div>

                <% } %>

                <% if (e.technologies && e.technologies.length) { %>

                  <div class="tags">

                    <% e.technologies.forEach(function(t){ %>

                      <span class="tag">
                        <%= t %>
                      </span>

                    <% }) %>

                  </div>

                <% } %>

              </div>

            </article>

          <% }) %>

        </div>

      </section>

    <% } %>


    <!-- =====================================================
         PROJECTS
    ====================================================== -->

    <% if (projects && projects.length) { %>

      <section class="section">

        <div class="section-heading">

          <div>

            <div class="section-label">
              Selected Work
            </div>

            <h2 class="section-title">
              Projects
            </h2>

          </div>

          <div class="section-number">
            02
          </div>

        </div>

        <div class="projects-grid">

          <% projects.forEach(function(p){ %>

            <article class="project">

              <% if (p.featured) { %>

                <span class="project-featured">
                  Featured
                </span>

              <% } %>

              <h3 class="project-title">
                <%= p.title %>
              </h3>

              <% if (p.description) { %>

                <div class="project-description">
                  <%= p.description %>
                </div>

              <% } %>

              <% if (p.technologies && p.technologies.length) { %>

                <div class="tags">

                  <% p.technologies.forEach(function(t){ %>

                    <span class="tag">
                      <%= t %>
                    </span>

                  <% }) %>

                </div>

              <% } %>

              <div class="project-links">

                <% if (p.liveURL) { %>

                  <a
                    href="<%= p.liveURL %>"
                    target="_blank"
                    rel="noreferrer"
                  >
                    LIVE DEMO ↗
                  </a>

                <% } %>

                <% if (p.repoURL) { %>

                  <a
                    href="<%= p.repoURL %>"
                    target="_blank"
                    rel="noreferrer"
                  >
                    SOURCE CODE ↗
                  </a>

                <% } %>

              </div>

            </article>

          <% }) %>

        </div>

      </section>

    <% } %>


    <!-- =====================================================
         SKILLS
    ====================================================== -->

    <% if (skills && skills.length) { %>

      <section class="section">

        <div class="section-heading">

          <div>

            <div class="section-label">
              Expertise
            </div>

            <h2 class="section-title">
              Skills
            </h2>

          </div>

          <div class="section-number">
            03
          </div>

        </div>

        <div class="skills-grid">

          <% skills.forEach(function(s){ %>

            <div class="skill">
              <%= s.skillName %>
            </div>

          <% }) %>

        </div>

      </section>

    <% } %>


    <!-- =====================================================
         EDUCATION
    ====================================================== -->

    <% if (education && education.length) { %>

      <section class="section">

        <div class="section-heading">

          <div>

            <div class="section-label">
              Academic Background
            </div>

            <h2 class="section-title">
              Education
            </h2>

          </div>

          <div class="section-number">
            04
          </div>

        </div>

        <div class="education-grid">

          <% education.forEach(function(ed){ %>

            <article class="education">

              <div class="degree">

                <%= ed.degree %>

                <% if (ed.fieldOfStudy) { %>

                  · <%= ed.fieldOfStudy %>

                <% } %>

              </div>

              <div class="institution">
                <%= ed.institution %>
              </div>

              <div class="education-date">

                <%= ed.startYear %>

                —

                <%= ed.endYear || 'Present' %>

                <% if (ed.grade) { %>

                  · <%= ed.grade %>

                <% } %>

              </div>

              <% if (ed.description) { %>

                <div class="description">
                  <%= ed.description %>
                </div>

              <% } %>

            </article>

          <% }) %>

        </div>

      </section>

    <% } %>


    <!-- =====================================================
         VOLUNTEERING
    ====================================================== -->

    <% if (volunteer && volunteer.length) { %>

      <section class="section">

        <div class="section-heading">

          <div>

            <div class="section-label">
              Community
            </div>

            <h2 class="section-title">
              Volunteering
            </h2>

          </div>

          <div class="section-number">
            05
          </div>

        </div>

        <div>

          <% volunteer.forEach(function(v){ %>

            <article class="volunteer-item">

              <div class="volunteer-icon">
                +
              </div>

              <div>

                <div class="volunteer-role">
                  <%= v.role %>
                </div>

                <div class="volunteer-org">
                  <%= v.organization %>
                </div>

                <% if (v.description) { %>

                  <div class="volunteer-description">
                    <%= v.description %>
                  </div>

                <% } %>

              </div>

            </article>

          <% }) %>

        </div>

      </section>

    <% } %>

  </main>


  <!-- =======================================================
       FOOTER
  ======================================================== -->

  <footer>

    <strong>
      <%= user.name %>
    </strong>

    · Professional Portfolio

    · Last updated <%= updatedAt %>

    · Built with Smart Portfolio Generator

  </footer>

</div>

</body>
</html>
