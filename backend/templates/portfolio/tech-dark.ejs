<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />

  <title><%= user.name %> — Developer Portfolio</title>

  <meta
    name="description"
    content="<%= user.headline || user.name %>"
  />

  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>

  <link
    href="https://fonts.googleapis.com/css2?family=Manrope:wght@400;500;600;700;800&family=Space+Grotesk:wght@500;600;700&family=JetBrains+Mono:wght@400;500;600;700&display=swap"
    rel="stylesheet"
  />

  <style>

    /* =========================================================
       DYNAMIC THEME
       IMPORTANT:
       All colors are taken from portfolioGenerator.js
       ========================================================= */

    :root {
      --background: #080D16;
      --surface: #101927;

      --text: #EAF1FC;
      --muted: #9BAAC0;

      --primary: <%= theme.primary %>;
      --accent: <%= theme.accent %>;

      --border: color-mix(in srgb, var(--accent) 28%, #263449);
      --soft-accent: color-mix(in srgb, var(--accent) 14%, #101927);

      /* Derived theme colors */
      --primary-soft: color-mix(
        in srgb,
        var(--primary) 12%,
        transparent
      );

      --accent-soft: color-mix(
        in srgb,
        var(--accent) 10%,
        transparent
      );

      --border-strong: color-mix(
        in srgb,
        var(--accent) 35%,
        var(--border)
      );

      --shadow-color: color-mix(
        in srgb,
        var(--primary) 18%,
        transparent
      );
    }

    * {
      box-sizing: border-box;
    }

    html {
      scroll-behavior: smooth;
    }

    body {
      margin: 0;

      background:
        radial-gradient(
          circle at 15% 10%,
          var(--primary-soft),
          transparent 28%
        ),
        radial-gradient(
          circle at 85% 35%,
          var(--accent-soft),
          transparent 25%
        ),
        var(--background);

      color: var(--text);

      font-family: "Manrope", sans-serif;

      line-height: 1.6;

      -webkit-font-smoothing: antialiased;
    }

    a {
      color: inherit;
      text-decoration: none;
    }

    ::selection {
      background: var(--accent);
      color: var(--background);
    }

    /* =========================================================
       PAGE
       ========================================================= */

    .page {
      position: relative;

      max-width: 1240px;

      min-height: 100vh;

      margin: 0 auto;

      overflow: hidden;

      background:
        linear-gradient(
          180deg,
          var(--background),
          var(--surface)
        );

      box-shadow:
        0 0 80px rgba(0,0,0,.25);
    }

    /* =========================================================
       BACKGROUND GRID
       ========================================================= */

    .grid-bg {
      position: absolute;

      inset: 0;

      pointer-events: none;

      opacity: .35;

      background-image:
        linear-gradient(
          var(--border) 1px,
          transparent 1px
        ),
        linear-gradient(
          90deg,
          var(--border) 1px,
          transparent 1px
        );

      background-size: 42px 42px;

      mask-image:
        linear-gradient(
          to bottom,
          black,
          transparent 65%
        );
    }

    /* =========================================================
       HERO
       ========================================================= */

    .hero {
      position: relative;

      overflow: hidden;

      padding: 90px 75px 75px;

      border-bottom: 1px solid var(--border);

      background:
        radial-gradient(
          circle at 88% 15%,
          var(--primary-soft),
          transparent 30%
        ),
        radial-gradient(
          circle at 8% 85%,
          var(--accent-soft),
          transparent 25%
        );
    }

    .hero::after {
      content: "";

      position: absolute;

      width: 420px;
      height: 420px;

      right: -180px;
      top: -180px;

      border-radius: 50%;

      border: 1px solid var(--border-strong);

      box-shadow:
        0 0 80px var(--shadow-color);

      opacity: .5;

      pointer-events: none;
    }

    .hero-content {
      position: relative;

      z-index: 2;

      max-width: 1060px;

      margin: auto;
    }

    /* =========================================================
       TERMINAL
       ========================================================= */

    .terminal {
      display: inline-flex;

      align-items: center;

      gap: 9px;

      margin-bottom: 28px;

      padding: 8px 13px;

      border: 1px solid var(--border-strong);

      border-radius: 7px;

      background: var(--primary-soft);

      color: var(--muted);

      font-family: "JetBrains Mono", monospace;

      font-size: 10px;

      letter-spacing: .02em;

      box-shadow:
        0 0 25px var(--shadow-color);
    }

    .terminal-dot {
      width: 7px;
      height: 7px;

      border-radius: 50%;

      background: var(--accent);

      box-shadow:
        0 0 12px var(--accent);
    }

    .terminal-command {
      color: var(--primary);

      font-weight: 700;
    }

    /* =========================================================
       NAME
       ========================================================= */

    .name {
      margin: 0;

      max-width: 900px;

      color: var(--text);

      font-size: clamp(48px, 8vw, 92px);

      line-height: .94;

      font-weight: 800;

      letter-spacing: -.065em;
    }

    .name::after {
      content: "_";

      margin-left: 5px;

      color: var(--primary);

      font-family: "JetBrains Mono", monospace;

      font-size: .65em;

      animation: blink 1.1s infinite;
    }

    @keyframes blink {
      0%, 45% {
        opacity: 1;
      }

      46%, 100% {
        opacity: 0;
      }
    }

    .headline {
      max-width: 720px;

      margin-top: 26px;

      color: var(--text);

      font-size: 19px;

      line-height: 1.65;

      opacity: .9;
    }

    .bio {
      max-width: 700px;

      margin-top: 15px;

      color: var(--muted);

      font-size: 14px;

      line-height: 1.85;
    }

    /* =========================================================
       CONTACT
       ========================================================= */

    .contact {
      display: flex;

      flex-wrap: wrap;

      gap: 9px;

      margin-top: 30px;
    }

    .contact a,
    .contact span {
      display: inline-flex;

      align-items: center;

      min-height: 38px;

      padding: 0 14px;

      border: 1px solid var(--border);

      border-radius: 7px;

      background: var(--surface);

      color: var(--muted);

      font-family: "JetBrains Mono", monospace;

      font-size: 10px;

      transition:
        border-color .2s ease,
        background .2s ease,
        color .2s ease,
        transform .2s ease;
    }

    .contact a:hover {
      border-color: var(--accent);

      background: var(--accent-soft);

      color: var(--accent);

      transform: translateY(-2px);

      box-shadow:
        0 8px 25px var(--shadow-color);
    }

    /* =========================================================
       MAIN
       ========================================================= */

    .content {
      position: relative;

      z-index: 2;

      padding: 65px 75px;
    }

    .section {
      margin-bottom: 75px;
    }

    .section:last-child {
      margin-bottom: 0;
    }

    /* =========================================================
       SECTION HEADER
       ========================================================= */

    .section-header {
      display: flex;

      align-items: center;

      gap: 13px;

      margin-bottom: 28px;
    }

    .section-index {
      color: var(--primary);

      font-family: "JetBrains Mono", monospace;

      font-size: 10px;

      font-weight: 700;

      letter-spacing: .08em;
    }

    .section-title {
      margin: 0;

      color: var(--text);

      font-size: 24px;

      font-weight: 700;

      letter-spacing: -.035em;
    }

    .section-line {
      flex: 1;

      height: 1px;

      background:
        linear-gradient(
          90deg,
          var(--border-strong),
          transparent
        );
    }

    /* =========================================================
       EXPERIENCE
       ========================================================= */

    .experience {
      display: grid;

      gap: 15px;
    }

    .experience-card {
      position: relative;

      display: grid;

      grid-template-columns: 175px 1fr;

      gap: 30px;

      padding: 26px;

      border: 1px solid var(--border);

      border-radius: 13px;

      background:
        linear-gradient(
          135deg,
          var(--surface),
          var(--background)
        );

      transition:
        transform .25s ease,
        border-color .25s ease,
        box-shadow .25s ease;
    }

    .experience-card::before {
      content: "";

      position: absolute;

      left: 0;

      top: 20px;

      bottom: 20px;

      width: 2px;

      border-radius: 10px;

      background:
        linear-gradient(
          var(--primary),
          var(--accent)
        );

      opacity: 0;

      transition: opacity .25s ease;
    }

    .experience-card:hover {
      transform: translateX(4px);

      border-color: var(--border-strong);

      box-shadow:
        0 18px 45px rgba(0,0,0,.18),
        0 0 30px var(--shadow-color);
    }

    .experience-card:hover::before {
      opacity: 1;
    }

    .experience-date {
      color: var(--muted);

      font-family: "JetBrains Mono", monospace;

      font-size: 9px;

      line-height: 1.8;
    }

    .experience-role {
      margin: 0;

      color: var(--text);

      font-size: 18px;

      font-weight: 700;

      letter-spacing: -.02em;
    }

    .experience-company {
      margin-top: 5px;

      color: var(--primary);

      font-family: "JetBrains Mono", monospace;

      font-size: 10px;

      font-weight: 600;
    }

    .description {
      margin-top: 13px;

      color: var(--muted);

      font-size: 13px;

      line-height: 1.8;
    }

    /* =========================================================
       TAGS
       ========================================================= */

    .tags {
      display: flex;

      flex-wrap: wrap;

      gap: 7px;

      margin-top: 16px;
    }

    .tag {
      padding: 5px 9px;

      border: 1px solid var(--border);

      border-radius: 5px;

      background: var(--surface);

      color: var(--muted);

      font-family: "JetBrains Mono", monospace;

      font-size: 9px;

      transition:
        border-color .2s ease,
        color .2s ease,
        background .2s ease;
    }

    .tag:hover {
      border-color: var(--accent);

      background: var(--accent-soft);

      color: var(--accent);
    }

    /* =========================================================
       PROJECTS
       ========================================================= */

    .projects {
      display: grid;

      grid-template-columns:
        repeat(2, minmax(0, 1fr));

      gap: 16px;
    }

    .project {
      position: relative;

      min-height: 270px;

      display: flex;

      flex-direction: column;

      padding: 27px;

      overflow: hidden;

      border: 1px solid var(--border);

      border-radius: 14px;

      background:
        linear-gradient(
          145deg,
          var(--surface),
          var(--background)
        );

      transition:
        transform .25s ease,
        border-color .25s ease,
        box-shadow .25s ease;
    }

    .project::before {
      content: "";

      position: absolute;

      left: 0;
      right: 0;
      top: 0;

      height: 2px;

      background:
        linear-gradient(
          90deg,
          var(--primary),
          var(--accent),
          transparent
        );

      opacity: .8;
    }

    .project::after {
      content: "";

      position: absolute;

      width: 180px;
      height: 180px;

      right: -90px;
      top: -90px;

      border-radius: 50%;

      background: var(--primary-soft);

      transition: transform .3s ease;
    }

    .project:hover {
      transform: translateY(-5px);

      border-color: var(--border-strong);

      box-shadow:
        0 22px 55px rgba(0,0,0,.2),
        0 0 35px var(--shadow-color);
    }

    .project:hover::after {
      transform: scale(1.5);
    }

    .featured {
      position: relative;

      z-index: 2;

      display: inline-flex;

      align-self: flex-start;

      margin-bottom: 14px;

      padding: 4px 8px;

      border: 1px solid var(--border-strong);

      border-radius: 5px;

      background: var(--accent-soft);

      color: var(--accent);

      font-family: "JetBrains Mono", monospace;

      font-size: 8px;

      font-weight: 700;

      letter-spacing: .1em;

      text-transform: uppercase;
    }

    .project-title {
      position: relative;

      z-index: 2;

      margin: 0;

      color: var(--text);

      font-size: 19px;

      font-weight: 700;
    }

    .project-description {
      position: relative;

      z-index: 2;

      margin-top: 12px;

      color: var(--muted);

      font-size: 13px;

      line-height: 1.75;
    }

    .project .tags {
      position: relative;

      z-index: 2;
    }

    .project-links {
      position: relative;

      z-index: 2;

      display: flex;

      gap: 18px;

      margin-top: auto;

      padding-top: 22px;
    }

    .project-links a {
      color: var(--primary);

      font-family: "JetBrains Mono", monospace;

      font-size: 9px;

      font-weight: 700;

      transition:
        color .2s ease,
        transform .2s ease;
    }

    .project-links a:hover {
      color: var(--accent);

      transform: translateX(3px);
    }

    /* =========================================================
       SKILLS
       ========================================================= */

    .skills-grid {
      display: grid;

      grid-template-columns:
        repeat(4, minmax(0, 1fr));

      gap: 10px;
    }

    .skill {
      padding: 15px 16px;

      border: 1px solid var(--border);

      border-radius: 8px;

      background: var(--surface);

      color: var(--text);

      font-family: "JetBrains Mono", monospace;

      font-size: 10px;

      transition:
        transform .2s ease,
        border-color .2s ease,
        background .2s ease,
        color .2s ease;
    }

    .skill::before {
      content: "▹";

      margin-right: 7px;

      color: var(--primary);
    }

    .skill:hover {
      transform: translateY(-3px);

      border-color: var(--accent);

      background: var(--accent-soft);

      color: var(--accent);

      box-shadow:
        0 8px 25px var(--shadow-color);
    }

    /* =========================================================
       EDUCATION
       ========================================================= */

    .education-grid {
      display: grid;

      grid-template-columns:
        repeat(2, minmax(0, 1fr));

      gap: 15px;
    }

    .education {
      position: relative;

      padding: 25px;

      border: 1px solid var(--border);

      border-radius: 12px;

      background: var(--surface);

      overflow: hidden;

      transition:
        border-color .2s ease,
        transform .2s ease;
    }

    .education::before {
      content: "";

      position: absolute;

      left: 0;
      top: 0;
      bottom: 0;

      width: 2px;

      background: var(--primary);
    }

    .education:hover {
      transform: translateY(-3px);

      border-color: var(--border-strong);
    }

    .degree {
      color: var(--text);

      font-size: 16px;

      font-weight: 700;
    }

    .institution {
      margin-top: 6px;

      color: var(--primary);

      font-family: "JetBrains Mono", monospace;

      font-size: 10px;

      font-weight: 600;
    }

    .education-date {
      margin-top: 12px;

      color: var(--muted);

      font-family: "JetBrains Mono", monospace;

      font-size: 9px;
    }

    /* =========================================================
       VOLUNTEERING
       ========================================================= */

    .volunteering {
      display: grid;

      grid-template-columns:
        repeat(2, minmax(0, 1fr));

      gap: 13px;
    }

    .volunteer {
      display: flex;

      gap: 14px;

      padding: 21px;

      border: 1px solid var(--border);

      border-radius: 11px;

      background: var(--surface);

      transition:
        border-color .2s ease,
        transform .2s ease,
        box-shadow .2s ease;
    }

    .volunteer:hover {
      transform: translateY(-3px);

      border-color: var(--border-strong);

      box-shadow:
        0 12px 35px var(--shadow-color);
    }

    .volunteer-icon {
      display: flex;

      align-items: center;
      justify-content: center;

      width: 34px;
      height: 34px;

      flex-shrink: 0;

      border: 1px solid var(--border-strong);

      border-radius: 8px;

      background: var(--primary-soft);

      color: var(--primary);

      font-family: "JetBrains Mono", monospace;

      font-size: 12px;

      font-weight: 700;
    }

    .volunteer-role {
      color: var(--text);

      font-size: 13px;

      font-weight: 700;
    }

    .volunteer-org {
      margin-top: 4px;

      color: var(--accent);

      font-family: "JetBrains Mono", monospace;

      font-size: 9px;
    }

    .volunteer-description {
      margin-top: 7px;

      color: var(--muted);

      font-size: 11px;

      line-height: 1.65;
    }

    /* =========================================================
       FOOTER
       ========================================================= */

    footer {
      position: relative;

      padding: 28px 75px;

      border-top: 1px solid var(--border);

      background: var(--surface);

      color: var(--muted);

      font-family: "JetBrains Mono", monospace;

      font-size: 9px;

      line-height: 1.7;
    }

    footer strong {
      color: var(--text);
    }

    .status {
      display: inline-flex;

      align-items: center;

      gap: 7px;

      margin-top: 8px;

      color: var(--primary);

      font-weight: 600;
    }

    .status-dot {
      width: 5px;
      height: 5px;

      border-radius: 50%;

      background: var(--primary);

      box-shadow:
        0 0 8px var(--primary);
    }

    /* =========================================================
       RESPONSIVE
       ========================================================= */

    @media (max-width: 900px) {

      .hero {
        padding: 65px 35px;
      }

      .content {
        padding: 55px 35px;
      }

      footer {
        padding: 25px 35px;
      }

      .skills-grid {
        grid-template-columns:
          repeat(3, minmax(0, 1fr));
      }

    }

    @media (max-width: 700px) {

      .projects,
      .education-grid,
      .volunteering {
        grid-template-columns: 1fr;
      }

      .experience-card {
        grid-template-columns: 1fr;

        gap: 10px;
      }

      .skills-grid {
        grid-template-columns:
          repeat(2, minmax(0, 1fr));
      }

      .section-line {
        display: none;
      }

    }

    @media (max-width: 480px) {

      .hero {
        padding: 50px 20px;
      }

      .content {
        padding: 45px 20px;
      }

      .name {
        font-size: 50px;
      }

      .headline {
        font-size: 17px;
      }

      .skills-grid {
        grid-template-columns: 1fr;
      }

      footer {
        padding: 22px 20px;
      }

      .contact a,
      .contact span {
        font-size: 9px;
      }

    }

    /* =========================================================
       PRINT
       ========================================================= */

    @media print {

      body {
        background: var(--background);
      }

      .page {
        max-width: none;

        box-shadow: none;
      }

      .hero,
      .project,
      .experience-card,
      .education,
      .volunteer {
        print-color-adjust: exact;
        -webkit-print-color-adjust: exact;
      }

    }

    /* OBSIDIAN STACK — cinematic developer interface with a holographic core */
    .hero { min-height: 700px; overflow: hidden; isolation: isolate; }
    .hero-content { position: relative; z-index: 3; max-width: 58%; }
    .artwork-scene { position: absolute; z-index: 1; inset: 0 0 0 auto; width: 55%; display: grid; place-items: center; pointer-events: none; }
    .artwork-scene svg { width: 112%; filter: drop-shadow(0 0 28px rgba(34,229,187,.18)) drop-shadow(0 36px 55px rgba(0,0,0,.48)); animation: obsidian-hover 8s ease-in-out infinite; }
    .grid-bg { animation: obsidian-grid 28s linear infinite; }
    .project, .experience-card, .education, .volunteer { border-radius: 18px; box-shadow: 0 20px 58px rgba(0,0,0,.28), inset 0 1px rgba(255,255,255,.035); }
    .project:hover, .experience-card:hover { transform: translateY(-7px); box-shadow: 0 28px 70px rgba(0,0,0,.4), 0 0 30px rgba(23,237,173,.12); }
    .portfolio-project-art { margin: 0 0 20px; overflow: hidden; border: 1px solid rgba(34,229,187,.24); border-radius: 12px; background: linear-gradient(135deg,#101b2a,#0a3c3d 55%,#172448); }
    .portfolio-project-art svg { display: block; width: 100%; height: 130px; transition: transform .55s ease; }
    .project:hover .portfolio-project-art svg { transform: scale(1.08); }
    footer { background: linear-gradient(120deg,#101927,#101927 65%,color-mix(in srgb,var(--accent) 26%,#101927)); border-top: 1px solid var(--border); color: #DCE7F7; }
    footer strong { color: #fff; }
    .status { color: var(--accent); }
    .status-dot { background: var(--accent); box-shadow: 0 0 12px var(--accent); }
    .content { display:grid; grid-template-columns:190px minmax(0,1fr); gap:34px; align-items:start; }
    .obsidian-rail { position:sticky; top:28px; display:grid; gap:16px; padding:22px 0; border-right:1px solid var(--border); }
    .obsidian-rail a { display:flex; gap:12px; color:var(--muted); text-decoration:none; font:500 11px "JetBrains Mono",monospace; }
    .obsidian-rail a b,.rail-kicker { color:var(--accent); }
    .rail-kicker { font:600 10px "JetBrains Mono",monospace; letter-spacing:.16em; }
    .rail-live { margin-top:18px; color:var(--muted); font:10px "JetBrains Mono",monospace; }
    .rail-live i { display:inline-block; width:7px; height:7px; margin-right:8px; border-radius:50%; background:var(--accent); box-shadow:0 0 12px var(--accent); }
    .obsidian-stack { min-width:0; display:grid; grid-template-columns:repeat(12,minmax(0,1fr)); gap:24px; align-items:start; }
    .obsidian-stack > .obsidian-experience,.obsidian-stack > .obsidian-projects { grid-column:span 12; }
    .obsidian-stack > .obsidian-skills,.obsidian-stack > .obsidian-education,.obsidian-stack > .obsidian-volunteer { grid-column:span 6; }
    .obsidian-projects .projects { grid-template-columns:repeat(2,minmax(0,1fr)); }
    .obsidian-experience .experience-card { display:grid; grid-template-columns:minmax(130px,.32fr) minmax(0,1fr); gap:20px; }
    .project, .experience-card, .education, .volunteer { border: 1px solid var(--border); background: linear-gradient(145deg,var(--surface),color-mix(in srgb,var(--accent) 5%,var(--surface))); }
    .portfolio-project-art { border-color: color-mix(in srgb,var(--accent) 40%,transparent); background: linear-gradient(135deg,#101b2a,color-mix(in srgb,var(--accent) 32%,#0a111d) 55%,#172448); }
    @keyframes obsidian-hover { 0%,100% { transform: translateY(0) rotateY(-3deg); } 50% { transform: translateY(-13px) rotateY(3deg); } }
    @keyframes obsidian-grid { to { background-position: 48px 48px; } }
    @media(max-width:760px) { .content { grid-template-columns:1fr; gap:12px; } .obsidian-rail { position:static; display:flex; overflow:auto; border-right:0; border-bottom:1px solid var(--border); padding:8px 0 14px; } .obsidian-rail a { white-space:nowrap; } .rail-kicker,.rail-live { display:none; } .obsidian-stack { grid-template-columns:1fr; gap:8px; } .obsidian-stack > .section { grid-column:1; } .obsidian-projects .projects { grid-template-columns:1fr; } .obsidian-experience .experience-card { grid-template-columns:1fr; } .hero { min-height: 600px; } .hero-content { max-width: 100%; } .artwork-scene { width: 100%; opacity: .34; } }
  
    /* Responsive Obsidian viewport */
    *,*::before,*::after { box-sizing:border-box; } html,body { width:100%; max-width:100%; overflow-x:clip; } img,svg,video,canvas { max-width:100%; } .page,.content,.obsidian-stack,.section { min-width:0; }
    @media(max-width:980px) { .content { grid-template-columns:1fr; } .obsidian-rail { position:static; display:flex; align-items:center; overflow-x:auto; border-right:0; border-bottom:1px solid var(--border); padding:8px 0 14px; } .obsidian-rail a { white-space:nowrap; } .rail-kicker,.rail-live { display:none; } }
    @media(max-width:760px) { .obsidian-stack { grid-template-columns:1fr; } .obsidian-stack > .section { grid-column:1/-1; } .obsidian-projects .projects { grid-template-columns:1fr; } .hero { min-height:0; padding:48px 22px; } .hero-content { max-width:100%; } .name,.hero h1 { font-size:clamp(38px,12vw,62px); overflow-wrap:anywhere; } .experience-card { grid-template-columns:1fr !important; } .contact { flex-wrap:wrap; } }
    @media(max-width:380px) { .page { width:calc(100% - 16px); } .content { padding-inline:14px; } .section { padding-inline:16px; } .skills-grid { grid-template-columns:1fr 1fr; } }
    @media(prefers-reduced-motion:reduce) { *,*::before,*::after { animation-duration:.01ms !important; animation-iteration-count:1 !important; scroll-behavior:auto !important; transition-duration:.01ms !important; } }
  
    /* OBSIDIAN STACK — terminal editorial, layered portfolio system */
    .hero { min-height:740px; padding:28px clamp(24px,6vw,78px) 64px; border:1px solid color-mix(in srgb,var(--accent) 20%,var(--border)); border-radius:0 0 34px 34px; background:radial-gradient(ellipse at 76% 42%,color-mix(in srgb,var(--accent) 15%,transparent),transparent 36%),linear-gradient(145deg,#0c1320,#080d16 70%); }
    .hero-topline { position:relative; z-index:4; display:flex; align-items:center; gap:22px; max-width:1340px; margin:0 auto 92px; padding:0 0 18px; border-bottom:1px solid color-mix(in srgb,var(--accent) 20%,var(--border)); color:var(--muted); font:600 9px "JetBrains Mono",monospace; letter-spacing:.11em; }
    .obsidian-wordmark { display:inline-flex; align-items:center; gap:10px; color:var(--text); text-decoration:none; font-size:10px; letter-spacing:.17em; }
    .obsidian-wordmark i { display:grid; place-items:center; width:30px; height:30px; border:1px solid var(--accent); border-radius:9px; color:var(--accent); font:700 16px "Space Grotesk",sans-serif; font-style:normal; box-shadow:inset 0 0 16px color-mix(in srgb,var(--accent) 13%,transparent),0 0 20px color-mix(in srgb,var(--accent) 10%,transparent); }
    .obsidian-wordmark b { color:var(--accent); }
    .hero-edition { margin-right:auto; }
    .hero-top-status { display:inline-flex; align-items:center; gap:8px; white-space:nowrap; color:#C9D7E8; }
    .hero-top-status i { width:7px; height:7px; border-radius:50%; background:var(--accent); box-shadow:0 0 12px var(--accent); }
    .hero-content { width:min(58%,720px); max-width:none; margin:0; }
    .terminal { border-radius:999px; padding:9px 14px; border-color:color-mix(in srgb,var(--accent) 36%,var(--border)); background:color-mix(in srgb,var(--accent) 8%,var(--surface)); box-shadow:0 0 28px color-mix(in srgb,var(--accent) 10%,transparent); }
    .terminal-command { color:var(--accent); }
    .name { max-width:780px; font-family:"Space Grotesk",sans-serif; font-size:clamp(62px,8vw,112px); line-height:.91; letter-spacing:-.075em; text-wrap:balance; }
    .name::after { color:var(--accent); }
    .headline { max-width:600px; margin-top:23px; color:#ECF3FC; font-size:clamp(19px,2.3vw,27px); font-weight:600; line-height:1.35; letter-spacing:-.035em; }
    .bio { max-width:560px; margin-top:18px; color:#9BAAC0; font-size:13px; line-height:1.9; }
    .contact { gap:9px; margin-top:26px; }
    .contact a,.contact span { min-height:39px; border-radius:999px; border-color:color-mix(in srgb,var(--accent) 23%,var(--border)); background:color-mix(in srgb,var(--surface) 72%,transparent); backdrop-filter:blur(12px); }
    .contact a:first-child { color:#07101A; border-color:var(--accent); background:var(--accent); font-weight:700; }
    .artwork-scene { inset:12% -2% 6% auto; width:53%; perspective:1100px; }
    .artwork-scene svg { width:116%; filter:drop-shadow(0 0 38px color-mix(in srgb,var(--accent) 18%,transparent)) drop-shadow(0 44px 58px rgba(0,0,0,.56)); animation:obsidian-float 8s ease-in-out infinite; }
    .grid-bg { opacity:.28; mask-image:linear-gradient(90deg,transparent,#000 30%,#000); }
    .hero-metrics { display:flex; flex-wrap:wrap; gap:10px; max-width:600px; margin-top:34px; }
    .hero-metrics > div { display:grid; gap:6px; min-width:130px; padding:12px 15px; border:1px solid color-mix(in srgb,var(--accent) 18%,var(--border)); border-radius:13px; background:rgba(16,25,39,.62); backdrop-filter:blur(14px); box-shadow:inset 0 1px rgba(255,255,255,.035); }
    .hero-metrics span { color:var(--muted); font:500 8px "JetBrains Mono",monospace; letter-spacing:.12em; }
    .hero-metrics strong { color:var(--text); font:600 19px "Space Grotesk",sans-serif; }
    .hero-metrics small { color:var(--muted); font:500 9px "JetBrains Mono",monospace; }
    .obsidian-rail { top:32px; padding:18px 16px 18px 0; border-color:color-mix(in srgb,var(--accent) 18%,var(--border)); }
    .obsidian-rail a { min-height:37px; align-items:center; padding:0 11px; border:1px solid transparent; border-radius:10px; font-size:10px; transition:all .25s ease; }
    .obsidian-rail a:hover,.obsidian-rail a:focus-visible { outline:none; color:var(--text); border-color:color-mix(in srgb,var(--accent) 28%,transparent); background:color-mix(in srgb,var(--accent) 8%,var(--surface)); transform:translateX(3px); }
    .obsidian-stack { gap:20px; }
    .obsidian-stack > .obsidian-projects,.obsidian-stack > .obsidian-experience { grid-column:1/-1; }
    .obsidian-stack > .obsidian-skills { grid-column:span 7; }
    .obsidian-stack > .obsidian-education { grid-column:span 5; }
    .obsidian-stack > .obsidian-volunteer { grid-column:1/-1; }
    .section { position:relative; padding:clamp(23px,3vw,36px); border:1px solid color-mix(in srgb,var(--accent) 17%,var(--border)); border-radius:22px; background:linear-gradient(145deg,rgba(16,25,39,.94),rgba(10,16,27,.88)); box-shadow:0 22px 54px rgba(0,0,0,.22),inset 0 1px rgba(255,255,255,.035); animation:obsidian-rise .7s both cubic-bezier(.2,.8,.2,1); }
    .section-header { margin-bottom:23px; }
    .section-index { display:grid; place-items:center; width:36px; height:36px; flex:0 0 36px; border:1px solid color-mix(in srgb,var(--accent) 42%,transparent); border-radius:11px; color:var(--accent); background:color-mix(in srgb,var(--accent) 9%,var(--surface)); }
    .section-title { font-family:"Space Grotesk",sans-serif; font-size:clamp(22px,3vw,30px); letter-spacing:-.05em; }
    .section-line { background:linear-gradient(90deg,color-mix(in srgb,var(--accent) 42%,var(--border)),transparent); }
    .experience { gap:11px; }
    .experience-card { padding:20px 22px; border-radius:16px; background:linear-gradient(110deg,color-mix(in srgb,var(--accent) 8%,var(--surface)),var(--surface) 48%); animation:obsidian-rise .65s both; }
    .experience-card:nth-child(2) { animation-delay:.08s; } .experience-card:nth-child(3) { animation-delay:.16s; }
    .experience-date { color:var(--accent); font:500 9px "JetBrains Mono",monospace; letter-spacing:.06em; }
    .experience-role,.project-title,.degree,.volunteer-role { font-family:"Space Grotesk",sans-serif; letter-spacing:-.035em; }
    .experience-role { font-size:19px; }
    .experience-company { color:#C1D0E2; }
    .description,.project-description,.volunteer-description { color:#AAB8CA; font-size:12px; line-height:1.8; }
    .projects { gap:14px; }
    .project { min-height:0; padding:19px; border-radius:17px; background:linear-gradient(145deg,#111d2d,#0c1421); transition:transform .35s cubic-bezier(.2,.8,.2,1),border-color .35s ease,box-shadow .35s ease; }
    .project:hover { transform:translateY(-7px); border-color:color-mix(in srgb,var(--accent) 56%,var(--border)); box-shadow:0 24px 55px rgba(0,0,0,.36),0 0 25px color-mix(in srgb,var(--accent) 12%,transparent); }
    .project-title { position:relative; z-index:1; color:var(--text); font-size:19px; }
    .portfolio-project-art { height:148px; border-color:color-mix(in srgb,var(--accent) 30%,var(--border)); border-radius:13px; background:radial-gradient(ellipse at 70% 30%,color-mix(in srgb,var(--accent) 28%,transparent),transparent 40%),linear-gradient(135deg,#111d2d,#0a111d 65%,color-mix(in srgb,var(--accent) 15%,#101927)); }
    .portfolio-project-art svg { height:148px; transition:transform .55s cubic-bezier(.2,.8,.2,1); }
    .project:hover .portfolio-project-art svg { transform:scale(1.07) rotateY(4deg); }
    .skills-grid { grid-template-columns:repeat(3,minmax(0,1fr)); gap:9px; }
    .skill { position:relative; overflow:hidden; border-radius:11px; border-color:color-mix(in srgb,var(--accent) 20%,var(--border)); background:linear-gradient(140deg,var(--surface),color-mix(in srgb,var(--accent) 5%,var(--surface))); color:#DCE7F6; font-size:9px; }
    .skill:hover { transform:translateY(-4px) rotate(-1deg); }
    .education-grid { grid-template-columns:1fr; }
    .education,.volunteer { padding:20px; border-radius:15px; }
    .degree,.volunteer-role { color:var(--text); font-size:17px; }
    .institution,.volunteer-org { color:var(--accent); font-weight:700; }
    footer { display:flex; align-items:center; justify-content:space-between; flex-wrap:wrap; gap:14px; padding:22px clamp(24px,6vw,78px); color:#AAB8CA; font:10px "JetBrains Mono",monospace; }
    footer strong { font:600 13px "Space Grotesk",sans-serif; letter-spacing:.02em; }
    @keyframes obsidian-float { 0%,100% { transform:translateY(0) rotateY(-4deg); } 50% { transform:translateY(-13px) rotateY(4deg); } }
    @keyframes obsidian-rise { from { opacity:0; transform:translateY(14px); } to { opacity:1; transform:translateY(0); } }
    @media(max-width:1000px) { .hero-topline { margin-bottom:70px; } .hero-content { width:68%; } .artwork-scene { width:49%; opacity:.72; } .obsidian-stack > .obsidian-skills { grid-column:span 6; } .obsidian-stack > .obsidian-education { grid-column:span 6; } }
    @media(max-width:760px) { .hero { min-height:0; padding:20px 22px 42px; } .hero-topline { flex-wrap:wrap; margin-bottom:50px; } .hero-edition { margin-right:0; } .hero-top-status { margin-left:auto; } .hero-content { width:100%; } .artwork-scene { top:auto; right:-4%; bottom:2%; width:75%; height:280px; opacity:.3; } .hero-metrics { max-width:100%; } .hero-metrics > div { flex:1 1 30%; min-width:100px; } .content { padding:22px 20px 44px; } .obsidian-stack { grid-template-columns:1fr; } .obsidian-stack > .section { grid-column:1/-1; } .skills-grid { grid-template-columns:repeat(2,minmax(0,1fr)); } .section-header { gap:10px; } .section-title { font-size:22px; } }
    @media(max-width:460px) { .hero-topline { gap:12px; } .hero-edition { width:100%; order:3; } .hero-top-status { margin-left:0; font-size:8px; } .name { font-size:clamp(40px,12vw,58px); } .hero-metrics { display:grid; grid-template-columns:1fr 1fr; } .hero-metrics > div:last-child { grid-column:1/-1; } .content { padding-inline:14px; } .section { padding:20px 16px; } .skills-grid { grid-template-columns:1fr 1fr; } footer { align-items:flex-start; flex-direction:column; padding-inline:20px; } }
    @media(prefers-reduced-motion:reduce) { *,*::before,*::after { animation-duration:.01ms !important; animation-iteration-count:1 !important; scroll-behavior:auto !important; transition-duration:.01ms !important; } }
  </style>
</head>

<body>

<div class="page">

  <!-- =====================================================
       HERO
  ====================================================== -->

  <header class="hero">

    <div class="hero-topline"><a class="obsidian-wordmark" href="#top"><i>✳</i><span>PORTFOLIO</span></a><span class="hero-edition">PORTFOLIO SYSTEM / 01</span><span class="hero-top-status"><i></i> AVAILABLE FOR OPPORTUNITIES</span></div>

    <div class="artwork-scene artwork-scene--obsidian" aria-hidden="true">
      <svg viewBox="0 0 600 460" role="presentation">
        <defs>
          <linearGradient id="obsidianFace" x1="0" x2="1" y2="1"><stop stop-color="var(--accent)" stop-opacity=".56"/><stop offset="1" stop-color="#2563eb" stop-opacity=".24"/></linearGradient>
          <radialGradient id="obsidianSphere" cx="32%" cy="25%"><stop stop-color="#d6fff5"/><stop offset=".42" stop-color="var(--accent)"/><stop offset="1" stop-color="color-mix(in srgb,var(--accent) 45%,#101927)"/></radialGradient>
        </defs>
        <ellipse cx="329" cy="390" rx="182" ry="23" fill="#000" opacity=".42"/>
        <rect x="154" y="103" width="272" height="228" rx="18" fill="#0b1220" stroke="var(--accent)" stroke-opacity=".6" stroke-width="2"/>
        <rect x="173" y="123" width="234" height="28" rx="8" fill="#152238"/>
        <circle cx="190" cy="137" r="4" fill="#fb7185"/><circle cx="204" cy="137" r="4" fill="#facc15"/><circle cx="218" cy="137" r="4" fill="var(--accent)"/>
        <path d="M180 180h84M180 197h46M180 214h66" stroke="color-mix(in srgb,var(--accent) 65%,#dbeafe)" stroke-width="4" stroke-linecap="round" opacity=".55"/>
        <path d="M296 183l39-24 40 24v47l-40 24-39-24z" fill="url(#obsidianFace)" stroke="var(--accent)" stroke-width="2"/>
        <path d="M335 159v47l40-23m-40 23-39-23m39 23v46" fill="none" stroke="color-mix(in srgb,var(--accent) 58%,#eaf1fc)" stroke-width="1.5"/>
        <circle cx="453" cy="95" r="42" fill="url(#obsidianSphere)"/>
        <ellipse cx="453" cy="95" rx="65" ry="20" transform="rotate(-28 453 95)" fill="none" stroke="var(--accent)" stroke-opacity=".75"/>
      </svg>
    </div>

    <div class="grid-bg"></div>

    <div class="hero-content">

      <div class="terminal">

        <span class="terminal-dot"></span>

        <span>
          <span class="terminal-command">
            ~/portfolio
          </span>
          $ whoami
        </span>

      </div>

      <h1 class="name">
        <%= user.name %>
      </h1>

      <% if (user.headline) { %>

        <div class="headline">
          <%= user.headline %>
        </div>

      <% } %>

      <% if (user.bio) { %>

        <div class="bio">
          <%= user.bio %>
        </div>

      <% } %>

      <div class="contact">

        <% if (user.email) { %>

          <a href="mailto:<%= user.email %>">
            <%= user.email %>
          </a>

        <% } %>

        <% if (user.location) { %>

          <span>
            <%= user.location %>
          </span>

        <% } %>

        <% if (user.socialLinks && user.socialLinks.github) { %>

          <a
            href="<%= user.socialLinks.github %>"
            target="_blank"
            rel="noreferrer"
          >
            GitHub ↗
          </a>

        <% } %>

        <% if (user.socialLinks && user.socialLinks.linkedin) { %>

          <a
            href="<%= user.socialLinks.linkedin %>"
            target="_blank"
            rel="noreferrer"
          >
            LinkedIn ↗
          </a>

        <% } %>

        <% if (user.website) { %>

          <a
            href="<%= user.website %>"
            target="_blank"
            rel="noreferrer"
          >
            Website ↗
          </a>

        <% } %>

      </div>

      <div class="hero-metrics" aria-label="Portfolio overview">
        <div><span>01 / CAREER</span><strong><%= (experience || []).length.toString().padStart(2,'0') %><small> roles</small></strong></div>
        <div><span>02 / TOOLKIT</span><strong><%= (skills || []).length.toString().padStart(2,'0') %><small> skills</small></strong></div>
        <div><span>03 / SELECTED WORK</span><strong><%= (projects || []).length.toString().padStart(2,'0') %><small> projects</small></strong></div>
      </div>

    </div>

  </header>


  <main class="content">
    <aside class="obsidian-rail"><span class="rail-kicker">SYSTEM / MAP</span><a href="#experience"><b>01</b> Experience</a><a href="#projects"><b>02</b> Projects</a><a href="#skills"><b>03</b> Skills</a><a href="#education"><b>04</b> Education</a><a href="#volunteer"><b>05</b> Volunteering</a><span class="rail-live"><i></i> SYSTEM ONLINE</span></aside>
    <div class="obsidian-stack">

    <!-- =====================================================
         EXPERIENCE
    ====================================================== -->

    <% if (experience && experience.length) { %>

      <section class="section obsidian-experience" id="experience">

        <div class="section-header">

          <span class="section-index">01</span>

          <h2 class="section-title">
            Experience
          </h2>

          <div class="section-line"></div>

        </div>

        <div class="experience">

          <% experience.forEach(function(e){ %>

            <article class="experience-card">

              <div class="experience-date">

                <%= e.startDate
                  ? new Date(e.startDate).toLocaleDateString(
                      'en-US',
                      { month: 'short', year: 'numeric' }
                    )
                  : ''
                %>

                →

                <%= e.isCurrent
                  ? 'Present'
                  : (
                      e.endDate
                        ? new Date(e.endDate).toLocaleDateString(
                            'en-US',
                            { month: 'short', year: 'numeric' }
                          )
                        : ''
                    )
                %>

              </div>

              <div>

                <h3 class="experience-role">
                  <%= e.role %>
                </h3>

                <div class="experience-company">

                  <%= e.company %>

                  <% if (e.location) { %>
                    · <%= e.location %>
                  <% } %>

                </div>

                <% if (e.description) { %>

                  <div class="description">
                    <%= e.description %>
                  </div>

                <% } %>

                <% if (e.technologies && e.technologies.length) { %>

                  <div class="tags">

                    <% e.technologies.forEach(function(t){ %>

                      <span class="tag">
                        <%= t %>
                      </span>

                    <% }) %>

                  </div>

                <% } %>

              </div>

            </article>

          <% }) %>

        </div>

      </section>

    <% } %>


    <!-- =====================================================
         PROJECTS
    ====================================================== -->

    <% if (projects && projects.length) { %>

      <section class="section obsidian-projects" id="projects">

        <div class="section-header">

          <span class="section-index">02</span>

          <h2 class="section-title">
            Projects
          </h2>

          <div class="section-line"></div>

        </div>

        <div class="projects">

          <% projects.forEach(function(p){ %>

            <article class="project">

              <div class="portfolio-project-art" aria-hidden="true"><svg viewBox="0 0 420 160"><rect x="108" y="18" width="204" height="124" rx="14" fill="#0b1220" stroke="var(--accent)" stroke-opacity=".55" stroke-width="2"/><path d="M186 53l31-18 31 18v37l-31 18-31-18z" fill="var(--accent)" fill-opacity=".32" stroke="var(--accent)" stroke-width="2"/><path d="M217 35v36l31-18m-31 18-31-18m31 18v37" fill="none" stroke="#b6fff0" stroke-width="1.5"/><circle cx="142" cy="42" r="4" fill="#fb7185"/><circle cx="154" cy="42" r="4" fill="#facc15"/></svg></div>

              <% if (p.featured) { %>

                <span class="featured">
                  Featured Project
                </span>

              <% } %>

              <h3 class="project-title">
                <%= p.title %>
              </h3>

              <% if (p.description) { %>

                <div class="project-description">
                  <%= p.description %>
                </div>

              <% } %>

              <% if (p.technologies && p.technologies.length) { %>

                <div class="tags">

                  <% p.technologies.forEach(function(t){ %>

                    <span class="tag">
                      <%= t %>
                    </span>

                  <% }) %>

                </div>

              <% } %>

              <div class="project-links">

                <% if (p.liveURL) { %>

                  <a
                    href="<%= p.liveURL %>"
                    target="_blank"
                    rel="noreferrer"
                  >
                    LIVE ↗
                  </a>

                <% } %>

                <% if (p.repoURL) { %>

                  <a
                    href="<%= p.repoURL %>"
                    target="_blank"
                    rel="noreferrer"
                  >
                    SOURCE ↗
                  </a>

                <% } %>

              </div>

            </article>

          <% }) %>

        </div>

      </section>

    <% } %>


    <!-- =====================================================
         SKILLS
    ====================================================== -->

    <% if (skills && skills.length) { %>

      <section class="section obsidian-skills" id="skills">

        <div class="section-header">

          <span class="section-index">03</span>

          <h2 class="section-title">
            Skills
          </h2>

          <div class="section-line"></div>

        </div>

        <div class="skills-grid">

          <% skills.forEach(function(s){ %>

            <div class="skill">
              <%= s.skillName %>
            </div>

          <% }) %>

        </div>

      </section>

    <% } %>


    <!-- =====================================================
         EDUCATION
    ====================================================== -->

    <% if (education && education.length) { %>

      <section class="section obsidian-education" id="education">

        <div class="section-header">

          <span class="section-index">04</span>

          <h2 class="section-title">
            Education
          </h2>

          <div class="section-line"></div>

        </div>

        <div class="education-grid">

          <% education.forEach(function(ed){ %>

            <article class="education">

              <div class="degree">

                <%= ed.degree %>

                <% if (ed.fieldOfStudy) { %>
                  · <%= ed.fieldOfStudy %>
                <% } %>

              </div>

              <div class="institution">
                <%= ed.institution %>
              </div>

              <div class="education-date">

                <%= ed.startYear %>
                →
                <%= ed.endYear || 'Present' %>

                <% if (ed.grade) { %>
                  · <%= ed.grade %>
                <% } %>

              </div>

              <% if (ed.description) { %>

                <div class="description">
                  <%= ed.description %>
                </div>

              <% } %>

            </article>

          <% }) %>

        </div>

      </section>

    <% } %>


    <!-- =====================================================
         VOLUNTEERING
    ====================================================== -->

    <% if (volunteer && volunteer.length) { %>

      <section class="section obsidian-volunteer" id="volunteer">

        <div class="section-header">

          <span class="section-index">05</span>

          <h2 class="section-title">
            Volunteering
          </h2>

          <div class="section-line"></div>

        </div>

        <div class="volunteering">

          <% volunteer.forEach(function(v){ %>

            <article class="volunteer">

              <div class="volunteer-icon">
                +
              </div>

              <div>

                <div class="volunteer-role">
                  <%= v.role %>
                </div>

                <div class="volunteer-org">
                  <%= v.organization %>
                </div>

                <% if (v.description) { %>

                  <div class="volunteer-description">
                    <%= v.description %>
                  </div>

                <% } %>

              </div>

            </article>

          <% }) %>

        </div>

      </section>

    <% } %>

    </div>
  </main>


  <!-- =====================================================
       FOOTER
  ====================================================== -->

  <footer>

    <strong>
      <%= user.name %>
    </strong>

    · Last updated <%= updatedAt %>

    <div class="status">

      <span class="status-dot"></span>

      Available for opportunities

    </div>

  </footer>

</div>

</body>
</html>
